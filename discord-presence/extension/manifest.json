{
  "manifest_version": 3,
  "name": "MultiCanaisHD Discord Presence",
  "version": "1.0.0",
  "description": "Mostra no Discord o que você está assistindo no MultiCanaisHD.",
  "permissions": ["storage"],
  "host_permissions": ["https://multicanaishd.lol/*", "http://localhost:*/*"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://multicanaishd.lol/*", "http://localhost:*/*"],
      "js": ["content-script.js"],
      "run_at": "document_idle"
    }
  ]
}
