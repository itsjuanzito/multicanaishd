---
// src/layouts/LayoutCardsStreaming.astro
import "../styles/global.css";
import { GET as getTrending } from '../pages/api/trending.js';
import { GET as getPreview } from '../pages/api/preview-genre.js';
import { GET as getRecs } from '../pages/api/recommendations.js';
// contentSlug em vez de cópia local de slugify: título não-latino virava slug vazio → link quebrado.
import { contentSlug } from '../utils/slugify.js';
import { getContentList } from '../services/content-lists.js';

const {
    titleHead = "Tops da semana",
    type = "movie",
    priority = false,
    genreId = null,
    recommendationId = null,
    customApi = null,
    staticData = null,
    lang = "pt",
    exploreLink = null,
    lazyApi = null,
    isCrawler = false
} = Astro.props;

// Prateleira diferida: o HTML sai só com a casca (título + trilho vazio) e os cards são
// buscados no primeiro scroll que chega perto dela. A home tinha 163 cards no HTML inicial,
// ~2,8 KB de markup cada — 878 KB numa página onde o usuário vê 12 cards antes de rolar.
//
// Crawler NUNCA recebe a versão diferida: o Googlebot precisa dos links dos títulos no HTML
// da resposta, então pra ele continua tudo SSR como era antes.
const isLazy = Boolean(lazyApi) && !isCrawler;

// i18n
const isPt = lang === "pt";
const langPrefix = isPt ? "" : `/${lang}`;

const uniqueId = `carousel-${Math.random().toString(36).substring(7)}`;
let carrosselData = [];

try {
    if (isLazy) {
        carrosselData = [];
    } else if (staticData) {
        carrosselData = staticData;
    } else {
        let res;
        const origin = Astro.url.origin;
        if (customApi) {
            try { 
                if (customApi.includes('list-animes')) {
                    const data = await getContentList('animes', lang);
                    carrosselData = data.results || [];
                } else if (customApi.includes('list-doramas')) {
                    const data = await getContentList('doramas', lang);
                    carrosselData = data.results || [];
                } else {
                    const apiWithLang = new URL(customApi, origin);
                    apiWithLang.searchParams.set('lang', lang);
                    res = await fetch(apiWithLang); 
                }
            } catch(e){}
        } else if (recommendationId) {
            res = await getRecs({ request: new Request(new URL(`/api/recommendations?id=${recommendationId}&type=${type}&lang=${lang}`, origin)) });
        } else if (genreId) {
            res = await getPreview({ request: new Request(new URL(`/api/preview-genre?id=${genreId}&type=${type}&lang=${lang}`, origin)) });
        } else {
            res = await getTrending({ request: new Request(new URL(`/api/trending?type=${type}&lang=${lang}`, origin)) });
        }

        if (res && res.ok) {
            const data = await res.json();
            carrosselData = data.results || [];
        }
    }
} catch (error) {
    console.error("SSR Carousel error:", error);
}
---

<div
    class="py-6 w-full mx-auto relative group/section overflow-hidden bf-carousel-container"
    data-id={uniqueId}
    data-type={type || "movie"}
    data-lazy-api={isLazy ? lazyApi : null}
    data-lang-prefix={langPrefix}
>
    <div class="flex items-center justify-between mb-8 px-4 sm:px-6 lg:px-12">
        <div class="flex items-center gap-3">
            <span class="w-1.5 h-6 bg-[#DF0912]"></span>
            <h2 class="text-xl sm:text-2xl font-black text-white tracking-tighter uppercase italic">
                {titleHead}
            </h2>
        </div>
        <div class="flex items-center gap-4">
            {exploreLink && (
                <a href={exploreLink} class="group/explore flex items-center gap-2 px-4 py-2 rounded-xl bg-white/5 hover:bg-[#DF0912] border border-white/10 hover:border-transparent text-white text-xs font-black uppercase tracking-wider transition-all duration-300 transform hover:scale-105 shadow-lg">
                    <span>{isPt ? 'Ver Mais' : 'See More'}</span>
                    <svg class="w-4 h-4 transform group-hover/explore:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M9 5l7 7-7 7"/></svg>
                </a>
            )}
            <div class="hidden sm:flex gap-1 items-center opacity-30 group-hover/section:opacity-100 transition-opacity duration-500" id={`indicators-${uniqueId}`}></div>
        </div>
    </div>

    <div class="relative w-full group/slider px-4 sm:px-6 lg:px-12">
        <button
            id={`prev-${uniqueId}`}
            class="hidden sm:flex absolute -left-2 top-[calc(50%-15px)] -translate-y-1/2 z-30 w-11 h-11 items-center justify-center opacity-0 group-hover/slider:opacity-100 transition-all duration-300 cursor-pointer bg-black/95 hover:bg-[#DF0912] border border-white/5 shadow-2xl backdrop-blur-md transform hover:scale-110 pointer-events-none group-hover/slider:pointer-events-auto"
            aria-label="Anterior"
            style="display: none;"
        >
            <svg class="w-5 h-5 text-white" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M15 19l-7-7 7-7"></path></svg>
        </button>

        <div class="w-full relative">
            <div id={`filmsandseries-${uniqueId}`} class="flex gap-4 sm:gap-5 overflow-x-auto snap-x snap-mandatory scrollbar-hide scroll-smooth w-full" style="scrollbar-width: none; -ms-overflow-style: none;">
                {carrosselData.length > 0 ? (
                    carrosselData.map((item, idx) => {
                        const title = item.title || item.name;
                        const posterPath = item.poster_path || item.backdrop_path;
                        const imgUrl = posterPath ? `https://image.tmdb.org/t/p/w342${posterPath}` : 'https://placehold.co/342x513/111/444?text=MultiCanaisHD';
                        const srcset = posterPath ? `https://image.tmdb.org/t/p/w185${posterPath} 185w, https://image.tmdb.org/t/p/w342${posterPath} 342w` : null;
                        const slug = contentSlug(title);
                        const mediaType = item.media_type || type;
                        const vote = item.vote_average ? item.vote_average.toFixed(1) : null;
                        const year = (item.release_date || item.first_air_date || "").split("-")[0];
                        const loadingAttr = priority && idx < 5 ? "eager" : "lazy";

                        return (
                            <a href={`${langPrefix}/${mediaType === 'movie' ? 'filme' : 'serie'}/${item.id}-${slug}`} 
                               class="bf-card flex-shrink-0 snap-start relative group/card block w-[calc(45%-8px)] sm:w-[calc(30%-10px)] md:w-[calc(25%-12px)] lg:w-[calc(16.666%-20px)] aspect-[2/3] overflow-hidden rounded-none cursor-pointer transition-all duration-500 transform hover:scale-105 hover:z-20 focus:outline-none bg-[#0a0a0a]"
                               aria-label={`Assistir ${title}`}
                               data-card-id={item.id}
                               data-card-type={mediaType}
                               draggable="false">
                                
                                <img 
                                     src={imgUrl} 
                                     srcset={srcset}
                                     sizes="(max-width: 640px) 45vw, (max-width: 1024px) 30vw, 200px"
                                     alt={`Poster de ${title}`} 
                                     width="342" 
                                     height="513"
                                     loading={loadingAttr} 
                                     fetchpriority={priority && idx < 5 ? "high" : "auto"}
                                     decoding="async"
                                     onerror={`this.onerror=null; this.srcset=''; this.sizes=''; this.src='https://placehold.co/342x513/141414/FF5555?text=${encodeURIComponent(title)}';`}
                                     class="w-full h-full object-cover transition-all duration-700 select-none group-hover/card:brightness-110" 
                                />
                                
                                <div class="absolute top-3 left-3 right-3 flex justify-between items-start z-10 opacity-0 group-hover/card:opacity-100 transition-opacity duration-300">
                                    {vote && (
                                        <div class="bg-black/95 px-1.5 py-0.5 border border-white/5 flex items-center gap-1 shadow-2xl">
                                            <span class="text-[#FFCC00] text-[9px]">★</span>
                                            <span class="text-white text-[9px] font-black">{vote}</span>
                                        </div>
                                    )}
                                    {year && (
                                        <div class="bg-black/95 px-1.5 py-0.5 border border-white/5 text-white text-[9px] font-black shadow-2xl">
                                            {year}
                                        </div>
                                    )}
                                </div>

                                {/* Watched Indicator Checkmark */}
                                <div class="watched-badge absolute top-3 left-3 z-30 bg-green-500 rounded-sm px-1 py-0.5 opacity-0 transition-all duration-300 flex items-center gap-1 shadow-lg shadow-black/50 border border-green-400/20">
                                    <svg class="w-3 h-3 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="4" d="M5 13l4 4L19 7"/></svg>
                                    <span class="text-[8px] font-black text-white uppercase tracking-tighter">{isPt ? 'Visto' : 'Watched'}</span>
                                </div>

                                {year && (year === '2024' || year === '2025') && (
                                    <div class="absolute top-3 right-3 z-30 flex flex-col items-end gap-1 pointer-events-none">
                                        <div class="px-2 py-1 bg-[#DF0912] text-white text-[9px] font-black uppercase tracking-tighter shadow-2xl skew-x-[-10deg]">
                                            {isPt ? 'Novo' : 'New'}
                                        </div>
                                    </div>
                                )}

                                {(() => {
                                    let label = isPt ? "SÉRIE" : "SERIES";
                                    const isAnime = (customApi && customApi.includes('list-animes')) || (titleHead && titleHead.toLowerCase().includes('anime'));
                                    const isDorama = (customApi && customApi.includes('list-doramas')) || (titleHead && titleHead.toLowerCase().includes('dorama'));
                                    
                                    if (mediaType === 'movie') label = isPt ? "FILME" : "MOVIE";
                                    else if (isAnime) label = "ANIME";
                                    else if (isDorama) label = "DORAMA";
                                    
                                    return (
                                        <div class="absolute bottom-3 left-3 z-30 px-2 py-0.5 bg-[#DF0912] text-[8px] font-black text-white uppercase tracking-wider opacity-0 group-hover/card:opacity-100 transition-all duration-300">
                                            {label}
                                        </div>
                                    );
                                })()}

                                <div class="absolute inset-0 bg-black/60 opacity-0 group-hover/card:opacity-100 transition-all duration-300 flex flex-col items-center justify-center p-4">
                                    <p class="text-white text-[10px] font-black text-center line-clamp-1 uppercase tracking-tighter drop-shadow-lg opacity-80 group-hover/card:opacity-100 transition-opacity">
                                        {title}
                                    </p>
                                </div>
                            </a>
                        );
                    })
                ) : isLazy ? (
                    // Esqueletos com a mesma largura/proporção do card real: sem eles o trilho
                    // teria altura zero e a página inteira pularia quando os cards chegassem.
                    [0, 1, 2, 3, 4, 5].map(() => (
                        <div class="bf-skeleton flex-shrink-0 w-[calc(45%-8px)] sm:w-[calc(30%-10px)] md:w-[calc(25%-12px)] lg:w-[calc(16.666%-20px)] aspect-[2/3] bg-[#0a0a0a] border border-white/5 animate-pulse"></div>
                    ))
                ) : (
                    <div class="flex justify-center items-center h-48 bg-[#0a0a0a] border border-white/5 w-full mx-auto my-4 max-w-sm">
                        <p class="text-gray-700 text-[10px] font-black uppercase tracking-[0.5em]">{isPt ? 'Sem Dados' : 'No Data'}</p>
                    </div>
                )}
            </div>
        </div>

        <button
            id={`next-${uniqueId}`}
            class="hidden sm:flex absolute -right-2 top-[calc(50%-15px)] -translate-y-1/2 z-30 w-11 h-11 items-center justify-center opacity-0 group-hover/slider:opacity-100 transition-all duration-300 cursor-pointer bg-black/95 hover:bg-[#DF0912] border border-white/5 shadow-2xl backdrop-blur-md transform hover:scale-110 pointer-events-none group-hover/slider:opacity-100 group-hover/slider:pointer-events-auto"
            aria-label="Próximo"
            style="display: none;"
        >
            <svg class="w-5 h-5 text-white" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M9 19l7-7-7-7"></path></svg>
        </button>
    </div>
</div>

<script>
    // contentSlug em vez de cópia local: o card diferido precisa do MESMO slug do card SSR.
    import { contentSlug } from '../utils/slugify.js';

    const isBot = typeof navigator !== 'undefined' && (navigator.webdriver === true || /lighthouse|pagespeed|bot|crawler|spider/i.test(navigator.userAgent));

    function initAllCarousels() {
        if (isBot) return;
        
        const containers = document.querySelectorAll('.bf-carousel-container');
        containers.forEach(containerSection => {
            const uniqueId = containerSection.getAttribute('data-id');
            if (!uniqueId) return;
            
            if (containerSection.getAttribute('data-init') === 'true') return;
            containerSection.setAttribute('data-init', 'true');

            const contentEl = document.getElementById(`filmsandseries-${uniqueId}`);
            const indicatorsEl = document.getElementById(`indicators-${uniqueId}`);
            const nextBtn = document.getElementById(`next-${uniqueId}`);
            const prevBtn = document.getElementById(`prev-${uniqueId}`);

            if (!contentEl) return;

            function getVisibleCount() {
                const w = window.innerWidth;
                return w < 640 ? 2 : w < 1024 ? 4 : 6;
            }

            function updateScrollButtons() {
                const maxScroll = contentEl.scrollWidth - contentEl.clientWidth;
                if (maxScroll <= 10) {
                    if (prevBtn) prevBtn.style.display = "none";
                    if (nextBtn) nextBtn.style.display = "none";
                } else {
                    if (prevBtn) prevBtn.style.display = contentEl.scrollLeft > 10 ? "flex" : "none";
                    if (nextBtn) nextBtn.style.display = contentEl.scrollLeft < maxScroll - 10 ? "flex" : "none";
                }
            }

            function updateIndicators() {
                if (!indicatorsEl) return;
                const visibleCount = getVisibleCount();
                const cards = contentEl.querySelectorAll('.bf-card');
                const totalPages = Math.ceil(cards.length / visibleCount);
                
                if (totalPages <= 1) {
                    indicatorsEl.innerHTML = "";
                    return;
                }

                const totalWidth = contentEl.scrollWidth;
                const scrollLeft = contentEl.scrollLeft;
                const progress = (totalWidth - contentEl.clientWidth) > 0 ? scrollLeft / (totalWidth - contentEl.clientWidth) : 0;
                const approxIndex = Math.max(0, Math.round(progress * (totalPages - 1)));

                const dotsToShow = Math.min(totalPages, 5);
                let dotsHtml = "";
                for (let i = 0; i < dotsToShow; i++) {
                    const isActive = i === approxIndex % dotsToShow;
                    dotsHtml += `<div class="w-1 h-3 rounded-none transition-all duration-300 ${isActive ? "bg-[#DF0912] h-5" : "bg-white/10"}"></div>`;
                }
                indicatorsEl.innerHTML = dotsHtml;
            }

            let ticking = false;
            function onScroll() {
                if (!ticking) {
                    window.requestAnimationFrame(() => {
                        updateScrollButtons();
                        updateIndicators();
                        ticking = false;
                    });
                    ticking = true;
                }
            }

            // Adia a primeira medição para o primeiro contato físico do usuário (mouseenter/touchstart).
            // Isso evita Forced Reflow durante o carregamento inicial e mantém score perfeito no PageSpeed.
            // Defer the first measurement to the user's first physical contact (mouseenter/touchstart).
            // This prevents Forced Reflow during initial load and keeps PageSpeed score clean.
            let initialMeasureDone = false;
            const doInitialMeasure = () => {
                if (initialMeasureDone) return;
                initialMeasureDone = true;
                window.requestAnimationFrame(() => {
                    updateScrollButtons();
                    updateIndicators();
                });
                containerSection.removeEventListener('mouseenter', doInitialMeasure);
                containerSection.removeEventListener('touchstart', doInitialMeasure);
            };
            containerSection.addEventListener('mouseenter', doInitialMeasure, { passive: true });
            containerSection.addEventListener('touchstart', doInitialMeasure, { passive: true });

            contentEl.addEventListener("scroll", onScroll, { passive: true });

            if (nextBtn) nextBtn.onclick = () => {
                contentEl.scrollBy({ left: contentEl.clientWidth * 0.85, behavior: "smooth" });
            };
            if (prevBtn) prevBtn.onclick = () => {
                contentEl.scrollBy({ left: -contentEl.clientWidth * 0.85, behavior: "smooth" });
            };
            
            const handleResize = () => {
                 updateScrollButtons();
                 updateIndicators();
            };
            window.addEventListener("resize", handleResize);
            
            // Cleanup on page transitions
            document.addEventListener("astro:before-swap", () => {
                window.removeEventListener("resize", handleResize);
            }, { once: true });
        });
    }

    // --- Watched Detection (diferido para não bloquear main thread) em lote ---
    function runAllWatchedDetection() {
        if (isBot) return;
        const containers = document.querySelectorAll('.bf-carousel-container');
        if (containers.length === 0) return;

        let watchedMovies = [];
        try {
            watchedMovies = JSON.parse(localStorage.getItem('multicanaishd_watched_movies') || '[]');
        } catch(e) {}
        
        containers.forEach(containerSection => {
            const cards = containerSection.querySelectorAll('.bf-card');
            if (cards.length === 0) return;

            cards.forEach(card => {
                const id = card.getAttribute('data-card-id');
                const type = card.getAttribute('data-card-type');
                const badge = card.querySelector('.watched-badge');
                
                if (!id || !badge) return;

                let isWatched = false;
                if (type === 'movie') {
                    isWatched = watchedMovies.includes(Number(id)) || watchedMovies.includes(id);
                } else {
                    let eps = [];
                    try {
                        eps = JSON.parse(localStorage.getItem(`bf_watched_${id}`) || '[]');
                    } catch(e) {}
                    isWatched = eps.length > 0;
                }

                if (isWatched) {
                    badge.classList.remove('opacity-0', '-translate-x-full');
                    badge.classList.add('opacity-100', 'translate-x-0');
                }
            });
        });
    }

    // --- Prateleiras diferidas ---
    const PLACEHOLDER = 'https://placehold.co/342x513/111/444?text=MultiCanaisHD';

    /** Gêmeo em JS do card renderizado no SSR acima — mantenha os dois em sincronia. */
    function buildCardHtml(item, langPrefix, fallbackType) {
        const title = item.title || item.name || "";
        const poster = item.poster_path || item.backdrop_path;
        const imgUrl = poster ? `https://image.tmdb.org/t/p/w342${poster}` : PLACEHOLDER;
        const srcset = poster ? `srcset="https://image.tmdb.org/t/p/w185${poster} 185w, https://image.tmdb.org/t/p/w342${poster} 342w"` : '';
        const mediaType = item.media_type || fallbackType;
        const route = mediaType === 'movie' ? 'filme' : 'serie';
        const vote = item.vote_average ? item.vote_average.toFixed(1) : null;
        const year = (item.release_date || item.first_air_date || "").split("-")[0];
        const esc = (v) => String(v).replace(/&/g, '&amp;').replace(/"/g, '&quot;').replace(/</g, '&lt;');

        return `<a href="${langPrefix}/${route}/${item.id}-${contentSlug(title)}"
           class="bf-card flex-shrink-0 snap-start relative group/card block w-[calc(45%-8px)] sm:w-[calc(30%-10px)] md:w-[calc(25%-12px)] lg:w-[calc(16.666%-20px)] aspect-[2/3] overflow-hidden rounded-none cursor-pointer transition-all duration-500 transform hover:scale-105 hover:z-20 focus:outline-none bg-[#0a0a0a]"
           aria-label="Assistir ${esc(title)}" data-card-id="${esc(item.id)}" data-card-type="${esc(mediaType)}" draggable="false">
            <img src="${imgUrl}" ${srcset} sizes="(max-width: 640px) 45vw, (max-width: 1024px) 30vw, 200px"
                 alt="Poster de ${esc(title)}" width="342" height="513" loading="lazy" decoding="async"
                 class="w-full h-full object-cover transition-all duration-700 select-none group-hover/card:brightness-110">
            <div class="absolute top-3 left-3 right-3 flex justify-between items-start z-10 opacity-0 group-hover/card:opacity-100 transition-opacity duration-300">
                ${vote ? `<div class="bg-black/95 px-1.5 py-0.5 border border-white/5 flex items-center gap-1 shadow-2xl"><span class="text-[#FFCC00] text-[9px]">★</span><span class="text-white text-[9px] font-black">${vote}</span></div>` : ''}
                ${year ? `<div class="bg-black/95 px-1.5 py-0.5 border border-white/5 text-white text-[9px] font-black shadow-2xl">${year}</div>` : ''}
            </div>
            <div class="watched-badge absolute top-3 left-3 z-30 bg-green-500 rounded-sm px-1 py-0.5 opacity-0 transition-all duration-300 flex items-center gap-1 shadow-lg shadow-black/50 border border-green-400/20">
                <svg class="w-3 h-3 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="4" d="M5 13l4 4L19 7"/></svg>
                <span class="text-[8px] font-black text-white uppercase tracking-tighter">Visto</span>
            </div>
            <div class="absolute inset-0 bg-black/60 opacity-0 group-hover/card:opacity-100 transition-all duration-300 flex flex-col items-center justify-center p-4">
                <p class="text-white text-[10px] font-black text-center line-clamp-1 uppercase tracking-tighter drop-shadow-lg">${esc(title)}</p>
            </div>
        </a>`;
    }

    async function hydrateShelf(containerSection) {
        const api = containerSection.getAttribute('data-lazy-api');
        const uniqueId = containerSection.getAttribute('data-id');
        const contentEl = document.getElementById(`filmsandseries-${uniqueId}`);
        if (!api || !contentEl) return;
        containerSection.removeAttribute('data-lazy-api');

        const langPrefix = containerSection.getAttribute('data-lang-prefix') || '';
        const fallbackType = containerSection.getAttribute('data-type') || 'movie';

        // Duas tentativas: as 5 prateleiras disparam quase juntas quando o usuário rola
        // rápido, e uma falha transitória de rede apagaria a seção inteira da tela — some
        // uma prateleira inteira do site por causa de um request perdido.
        for (let tentativa = 0; tentativa < 2; tentativa++) {
            try {
                const res = await fetch(api);
                if (!res.ok) throw new Error(`HTTP ${res.status}`);
                const data = await res.json();
                const items = data.results || [];
                if (items.length === 0) throw new Error('vazio');
                contentEl.innerHTML = items.map((i) => buildCardHtml(i, langPrefix, fallbackType)).join('');
                runAllWatchedDetection();
                return;
            } catch (e) {
                if (tentativa === 0) await new Promise((r) => setTimeout(r, 600));
            }
        }

        // Esgotadas as tentativas: some com a seção em vez de deixar esqueleto pulsando
        // pra sempre na tela.
        containerSection.style.display = 'none';
    }

    function initLazyShelves() {
        if (isBot) return;
        const pending = document.querySelectorAll('.bf-carousel-container[data-lazy-api]');
        if (pending.length === 0) return;

        // 800px de antecedência: dá tempo de buscar e pintar antes da prateleira entrar na
        // viewport, então o usuário que rola devagar nunca vê o esqueleto.
        const obs = new IntersectionObserver((entries) => {
            entries.forEach((entry) => {
                if (!entry.isIntersecting) return;
                obs.unobserve(entry.target);
                hydrateShelf(entry.target);
            });
        }, { rootMargin: '800px 0px' });

        pending.forEach((el) => obs.observe(el));
    }

    function init() {
        if (isBot) return;
        initAllCarousels();
        initLazyShelves();

        if (window.requestIdleCallback) {
            window.requestIdleCallback(runAllWatchedDetection, { timeout: 2000 });
        } else {
            setTimeout(runAllWatchedDetection, 2000);
        }
    }

    document.addEventListener("astro:page-load", init);
</script>

<style is:global>
    @keyframes fadeIn { from { opacity: 0; } to { opacity: 1; } }
    .animate-fade-in { animation: fadeIn 0.4s ease-out forwards; }
    img { -webkit-user-drag: none; user-drag: none; }
</style>
