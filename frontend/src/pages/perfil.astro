---
// src/pages/perfil.astro
import BaseLayout from "../layouts/BaseLayout.astro";

// i18n
import { getLangFromUrl, useTranslations } from "../i18n/utils";
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const isPt = lang === "pt";

---

<BaseLayout
    title={isPt ? "Meu Perfil" : "My Profile"}
    description={isPt ? "Acompanhe suas estatísticas de maratona, títulos assistidos e nível de maratonista no MultiCanaisHD." : "Track your marathon stats, watched titles, and level of marathoner on MultiCanaisHD."}
    robots="noindex, nofollow"
>

    <main class="flex-grow container mx-auto px-4 sm:px-6 lg:px-8 py-12 mt-24 sm:mt-28 relative z-10">
        
        <!-- Public Profile Inspection Banner -->
        <div id="public-profile-banner" class="hidden max-w-5xl mx-auto bg-gradient-to-r from-[#DF0912]/10 via-[#DF0912]/15 to-transparent border border-[#DF0912]/20 backdrop-blur-md p-5 rounded-2xl flex flex-col sm:flex-row items-center justify-between gap-4 mb-8 shadow-lg shadow-red-950/10">
            <div class="flex items-center gap-3.5 text-center sm:text-left">
                <div class="w-10 h-10 bg-[#DF0912]/10 rounded-full flex items-center justify-center text-[#DF0912] border border-[#DF0912]/15 animate-pulse">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/></svg>
                </div>
                <div>
                    <p class="text-white font-black uppercase text-xs tracking-wider" id="inspection-banner-text">
                        {isPt ? "Modo de Inspeção de Membro" : "Member Inspection Mode"}
                    </p>
                    <p class="text-gray-400 text-[10px] font-bold uppercase tracking-widest mt-0.5">
                        {isPt ? "Visualizando perfil público e estatísticas de maratona" : "Viewing public profile and marathon stats"}
                    </p>
                </div>
            </div>
            <a href={isPt ? "/perfil" : "/en/perfil"} class="h-10 px-5 bg-white/5 hover:bg-white/10 text-white font-black uppercase text-[10px] tracking-widest rounded-xl transition-all border border-white/5 hover:border-[#DF0912]/30 flex items-center justify-center gap-2 cursor-pointer active:scale-95 shadow">
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M10 19l-7-7m0 0l7-7m-7 7h18"/></svg>
                <span>{isPt ? "Voltar ao Meu Perfil" : "Back to My Profile"}</span>
            </a>
        </div>

        <!-- Loading State Spinner -->
        <div id="public-profile-loading" class="hidden flex-col items-center justify-center py-24 sm:py-32 text-center max-w-md mx-auto">
            <div class="w-14 h-14 border-4 border-white/5 border-t-[#DF0912] rounded-full animate-spin mb-6"></div>
            <p class="text-gray-400 font-black uppercase text-xs tracking-widest animate-pulse">{isPt ? "Carregando Perfil..." : "Loading Profile..."}</p>
        </div>

        <!-- Public Profile Error Fallback (User Not Found) -->
        <div id="public-profile-error" class="hidden flex-col items-center justify-center py-20 sm:py-28 text-center max-w-md mx-auto relative">
            <div class="w-24 h-24 bg-white/[0.02] border border-white/10 rounded-[28px] flex items-center justify-center mb-8 shadow-inner relative overflow-hidden group">
                <div class="absolute inset-0 bg-gradient-to-tr from-[#DF0912]/10 to-transparent opacity-100 transition-opacity"></div>
                <svg class="w-10 h-10 text-[#DF0912]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/></svg>
            </div>
            
            <h2 class="text-3xl font-black text-white uppercase tracking-tighter mb-3 italic">
                {isPt ? "Membro Não Encontrado" : "Member Not Found"}
            </h2>
            <p class="text-gray-400 text-sm font-medium leading-relaxed mb-10 px-4">
                {isPt ? "O username ou nickname pesquisado não existe no MultiCanaisHD." : "The username or nickname searched does not exist on MultiCanaisHD."}
            </p>
            
            <a
                href={isPt ? "/perfil" : "/en/perfil"}
                class="px-10 py-4 bg-white/5 hover:bg-white/10 text-white border border-white/5 hover:border-[#DF0912]/30 font-black uppercase text-xs tracking-widest rounded-2xl hover:scale-105 transition-all shadow active:scale-95"
            >
                {isPt ? "Voltar ao Meu Perfil" : "Back to My Profile"}
            </a>
        </div>
        
        <!-- Logged In Dashboard Container -->
        <div id="logged-in-container" class="hidden max-w-5xl mx-auto">
            
            <!-- Dashboard Header Section -->
            <!-- Cabeçalho do perfil -->
            <div class="bg-[#141414] border border-white/[0.06] rounded-3xl p-6 sm:p-8 mb-6 relative">

                <button id="logout-btn" class="absolute top-5 right-5 h-9 px-3.5 flex items-center gap-2 text-gray-500 hover:text-[#DF0912] rounded-xl transition-colors text-[11px] font-semibold" title={t('nav.logout')}>
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"/></svg>
                    <span class="hidden sm:inline">{t('nav.logout')}</span>
                </button>

                <div class="flex flex-col sm:flex-row items-center sm:items-start gap-5 sm:gap-6 text-center sm:text-left">
                    <button id="user-profile-avatar-wrapper" class="group shrink-0 w-24 h-24 rounded-full flex items-center justify-center transition-all duration-300 relative overflow-hidden border-2 border-white/10 bg-black/40 cursor-pointer outline-none hover:border-[#DF0912]/60 active:scale-95" title={isPt ? "Alterar Avatar" : "Change Avatar"}>
                        <div id="avatar-fallback" class="absolute inset-0 bg-[#DF0912] rounded-full flex items-center justify-center transition-opacity duration-300">
                            <svg class="w-9 h-9 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
                        </div>
                        <div id="avatar-custom" class="absolute inset-0 rounded-full flex items-center justify-center text-white font-black text-3xl transition-all duration-300 opacity-0 select-none"></div>
                        <div id="avatar-edit-overlay" class="absolute inset-0 bg-black/70 opacity-0 group-hover:opacity-100 flex flex-col items-center justify-center text-white transition-opacity duration-200 select-none">
                            <svg class="w-5 h-5 mb-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z" />
                            </svg>
                            <span class="text-[9px] font-semibold text-gray-300">{isPt ? "Mudar" : "Edit"}</span>
                        </div>
                    </button>

                    <div class="min-w-0 flex-1 w-full">
                        <!-- Nome -->
                        <div id="username-display-wrapper" class="flex items-center gap-2.5 justify-center sm:justify-start min-w-0">
                            <h2 id="user-display-name" class="text-3xl sm:text-4xl font-black text-white tracking-tight leading-none truncate">
                                ---
                            </h2>
                            <button id="edit-username-btn" class="shrink-0 w-7 h-7 rounded-lg flex items-center justify-center text-gray-600 hover:text-[#DF0912] hover:bg-white/5 transition-colors cursor-pointer" title={isPt ? "Editar Nome de Exibição" : "Edit Display Name"}>
                                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z"/></svg>
                            </button>
                        </div>

                        <div id="username-edit-wrapper" class="hidden items-center gap-2 max-w-sm mx-auto sm:mx-0">
                            <input
                                type="text"
                                id="username-input"
                                maxlength="25"
                                placeholder={isPt ? "ex: Carlos Silva" : "ex: John Doe"}
                                class="flex-1 h-10 px-3.5 bg-black/40 border border-white/10 focus:border-[#DF0912]/60 rounded-xl text-white font-semibold text-sm outline-none transition-colors placeholder:text-gray-600"
                            />
                            <button id="save-username-btn" class="h-10 px-4 bg-[#DF0912] hover:bg-[#cf0811] text-white font-bold text-[11px] rounded-xl active:scale-95 transition-all cursor-pointer">
                                {isPt ? "Salvar" : "Save"}
                            </button>
                            <button id="cancel-username-btn" class="h-10 px-3 text-gray-500 hover:text-white font-bold text-[11px] rounded-xl transition-colors cursor-pointer">
                                {isPt ? "Cancelar" : "Cancel"}
                            </button>
                        </div>
                        <p id="username-error-msg" class="hidden text-[11px] font-semibold text-[#DF0912] mt-1.5 select-none text-center sm:text-left"></p>

                        <!-- E-mail -->
                        <h3 id="user-display-email" class="text-[13px] font-medium text-gray-500 leading-none mt-2">
                            ---
                        </h3>

                        <!-- Metadados: nickname, BetterID, plano -->
                        <div class="flex flex-wrap items-center justify-center sm:justify-start gap-2 mt-4">
                            <div id="nickname-display-wrapper" class="flex items-center gap-1.5">
                                <span id="user-nickname" class="text-[11px] font-semibold text-[#DF0912] bg-[#DF0912]/10 px-2.5 py-1 rounded-lg border border-[#DF0912]/20 select-all">
                                    @---
                                </span>
                                <button id="edit-nickname-btn" class="w-6 h-6 rounded-lg flex items-center justify-center text-gray-600 hover:text-[#DF0912] hover:bg-white/5 transition-colors cursor-pointer" title={isPt ? "Editar Nickname" : "Edit Nickname"}>
                                    <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z"/></svg>
                                </button>
                                <span id="nickname-changes-left" class="text-[10px] text-gray-600 font-medium">
                                    --
                                </span>
                            </div>

                            <div id="user-better-id-badge" class="hidden px-2.5 py-1 bg-white/[0.04] border border-white/[0.08] rounded-lg text-[11px] font-mono font-semibold text-gray-500 cursor-pointer hover:text-white hover:border-white/15 transition-colors" title={t('stats.copy_id')}>
                                #---
                            </div>

                            <div id="user-membership-badge" class="px-2.5 py-1 bg-white/[0.04] border border-white/[0.08] rounded-lg text-[11px] font-semibold text-gray-500 select-none">
                                Membro Standard
                            </div>
                        </div>

                        <div id="nickname-edit-wrapper" class="hidden items-center gap-2 mt-3 max-w-sm mx-auto sm:mx-0">
                            <div class="relative flex-1">
                                <span class="absolute left-3 top-1/2 -translate-y-1/2 text-gray-600 font-semibold text-sm select-none">@</span>
                                <input
                                    type="text"
                                    id="nickname-input"
                                    maxlength="20"
                                    placeholder="nickname"
                                    class="w-full h-10 pl-7 pr-3.5 bg-black/40 border border-white/10 focus:border-[#DF0912]/60 rounded-xl text-white font-semibold text-sm outline-none transition-colors placeholder:text-gray-600 lowercase"
                                />
                            </div>
                            <button id="save-nickname-btn" class="h-10 px-4 bg-[#DF0912] hover:bg-[#cf0811] text-white font-bold text-[11px] rounded-xl active:scale-95 transition-all cursor-pointer">
                                {isPt ? "Salvar" : "Save"}
                            </button>
                            <button id="cancel-nickname-btn" class="h-10 px-3 text-gray-500 hover:text-white font-bold text-[11px] rounded-xl transition-colors cursor-pointer">
                                {isPt ? "Cancelar" : "Cancel"}
                            </button>
                        </div>
                        <p id="nickname-error-msg" class="hidden text-[11px] font-semibold text-[#DF0912] mt-1.5 select-none text-center sm:text-left"></p>
                    </div>
                </div>
            </div>

            <!-- Perfis da conta (MultiCanaisHD VIP Black). Escondido por padrão: o script revela só
                 quando o plano ativo dá direito a múltiplos perfis. -->
            <a
                id="account-profiles-card"
                href={isPt ? "/perfis" : "/en/perfis"}
                class="hidden items-center gap-4 bg-[#141414] border border-white/[0.06] hover:border-white/20 rounded-3xl p-5 sm:p-6 mb-6 transition-colors group"
            >
                <img id="active-profile-avatar" src="/avatars/avatar_1.svg" alt="" class="w-12 h-12 rounded-xl object-cover shrink-0" />
                <div class="min-w-0 flex-1">
                    <p class="text-[11px] text-gray-500 font-semibold leading-none mb-1.5">
                        {isPt ? "Assistindo como" : "Watching as"}
                    </p>
                    <p id="active-profile-name" class="text-white font-bold text-sm truncate">---</p>
                </div>
                <span class="shrink-0 text-[11px] font-bold text-gray-400 group-hover:text-[#DF0912] transition-colors">
                    {isPt ? "Trocar perfil" : "Switch profile"}
                </span>
            </a>

            <!-- Painel principal: tempo assistido e patente contam a MESMA história, então viram
                 um bloco só (2/3) em vez de dois cards soltos de peso visual idêntico. O VIP fica
                 no terço restante — a assimetria é o que faz a grade parecer desenhada, em vez de
                 três caixas iguais lado a lado. -->
            <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-6">

                <div class="md:col-span-2 bg-[#141414] border border-white/[0.06] rounded-3xl p-6 sm:p-8 flex flex-col justify-between gap-8">
                    <div>
                        <p class="text-[11px] text-gray-500 font-semibold mb-3">{t('stats.total_time')}</p>
                        <div class="flex items-baseline gap-2.5">
                            <span id="stat-hours" class="text-6xl sm:text-7xl font-black text-white leading-[0.85] tracking-tighter">0.0</span>
                            <span id="stat-hours-label" class="text-lg font-bold text-gray-600 hidden">{t('stats.hours_label')}</span>
                        </div>
                        <a href="/ranking" class="inline-flex items-center gap-1.5 text-[11px] text-gray-500 hover:text-[#DF0912] font-medium transition-colors mt-4">
                            <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6" /></svg>
                            {isPt ? "Temporada atual:" : "Current season:"} <span id="stat-season-hours" class="text-gray-300 font-semibold">0.0h</span>
                        </a>
                    </div>

                    <div class="pt-6 border-t border-white/[0.06]">
                        <div class="flex items-end justify-between gap-4 mb-3">
                            <div class="min-w-0">
                                <p class="text-[11px] text-gray-500 font-semibold mb-1.5">{t('stats.rank_title')}</p>
                                <div class="flex items-center gap-2 min-w-0">
                                    <span id="rank-icon" class="text-lg leading-none shrink-0">🐣</span>
                                    <h3 id="rank-name" class="text-xl sm:text-2xl font-black text-white tracking-tight leading-none truncate">{t('stats.rank_beginner')}</h3>
                                </div>
                            </div>
                            <p id="rank-next" class="text-[11px] text-gray-600 font-medium text-right shrink-0 leading-tight">---</p>
                        </div>
                        <div class="w-full bg-white/[0.06] h-1.5 rounded-full overflow-hidden">
                            <div id="rank-progress" class="bg-[#DF0912] h-full rounded-full transition-all duration-700" style="width: 10%"></div>
                        </div>
                    </div>
                </div>

                <div class="bg-[#141414] border border-white/[0.06] rounded-3xl p-6 sm:p-8 flex flex-col justify-between gap-6">
                    <div>
                        <p class="text-[11px] text-gray-500 font-semibold mb-3">{isPt ? "Assinatura" : "Subscription"}</p>
                        <h3 id="vip-status-text" class="text-sm font-semibold text-gray-300 leading-relaxed">---</h3>
                    </div>
                    <div id="vip-actions" class="w-full"></div>
                </div>

            </div>

            <!-- Contadores: um painel só com células internas, em vez de quatro caixas cada uma
                 com borda, sombra e ícone dentro de um tile colorido próprio. -->
            <div class="bg-[#141414] border border-white/[0.06] rounded-3xl p-2 grid grid-cols-2 lg:grid-cols-4 gap-1 mb-12">

                <div class="group rounded-2xl p-5 hover:bg-white/[0.03] transition-colors">
                    <div class="flex items-center gap-2 text-gray-600 group-hover:text-[#DF0912] transition-colors">
                        <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 4v16M17 4v16M3 8h4m10 0h4M3 12h18M3 16h4m10 0h4M4 20h16a1 1 0 001-1V5a1 1 0 00-1-1H4a1 1 0 00-1 1v14a1 1 0 001 1z"/></svg>
                        <p class="text-[11px] font-semibold">{t('stats.movies')}</p>
                    </div>
                    <p class="mt-2.5"><span id="stat-movies" class="text-3xl font-black text-white leading-none tracking-tight">0</span></p>
                </div>

                <div class="group rounded-2xl p-5 hover:bg-white/[0.03] transition-colors">
                    <div class="flex items-center gap-2 text-gray-600 group-hover:text-[#DF0912] transition-colors">
                        <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z"/></svg>
                        <p class="text-[11px] font-semibold">{t('stats.episodes')}</p>
                    </div>
                    <p class="mt-2.5"><span id="stat-episodes" class="text-3xl font-black text-white leading-none tracking-tight">0</span></p>
                </div>

                <div class="group rounded-2xl p-5 hover:bg-white/[0.03] transition-colors">
                    <div class="flex items-center gap-2 text-gray-600 group-hover:text-[#DF0912] transition-colors">
                        <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"/></svg>
                        <p class="text-[11px] font-semibold">{t('stats.favorites')}</p>
                    </div>
                    <p class="mt-2.5"><span id="stat-favorites" class="text-3xl font-black text-white leading-none tracking-tight">0</span></p>
                </div>

                <div class="group rounded-2xl p-5 hover:bg-white/[0.03] transition-colors">
                    <div class="flex items-center gap-2 text-gray-600 group-hover:text-[#DF0912] transition-colors">
                        <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z"/></svg>
                        <p class="text-[11px] font-semibold">{t('stats.vibe')}</p>
                    </div>
                    <p class="mt-2.5"><span id="stat-genre" class="text-lg font-black text-white leading-none tracking-tight truncate block">---</span></p>
                </div>

            </div>

            <!-- Histórico de atividades recentes (populado pelo JS em #recent-grid) -->
            <div id="recent-activity-section" class="hidden mb-12">
                <h3 class="text-[11px] text-gray-500 font-semibold mb-4 flex items-center gap-2 select-none">
                    <span class="w-1.5 h-1.5 bg-[#DF0912] rounded-full"></span>
                    <span>{t('stats.recent_activity')}</span>
                </h3>
                <div id="recent-grid" class="grid grid-cols-1 sm:grid-cols-3 gap-6">
                    <!-- Cards injetados dinamicamente -->
                </div>
            </div>

            <!-- Sync Notice Disclaimer -->
            <p class="mt-16 text-center text-gray-600 text-[10px] font-black uppercase tracking-[0.25em] opacity-40 select-none">
                {t('stats.sync_notice')}
            </p>
        </div>

        <!-- Auth Loading State — shown while Supabase session is resolving (no localStorage cache) -->
        <!-- Estado de carregamento — exibido enquanto a sessão do Supabase está sendo resolvida -->
        <div id="auth-loading-container" class="hidden max-w-5xl mx-auto">
            <!-- Profile Header Skeleton -->
            <div class="bg-white/[0.02] backdrop-blur-md border border-white/5 rounded-[32px] p-8 sm:p-10 flex flex-col md:flex-row items-center justify-between gap-8 shadow-2xl mb-12">
                <div class="flex flex-col sm:flex-row items-center gap-6">
                    <div class="w-24 h-24 sm:w-28 sm:h-28 rounded-full bg-white/[0.05] animate-pulse"></div>
                    <div class="space-y-3 text-center sm:text-left">
                        <div class="w-48 h-7 bg-white/[0.05] rounded-xl animate-pulse mx-auto sm:mx-0"></div>
                        <div class="w-32 h-4 bg-white/[0.05] rounded-lg animate-pulse mx-auto sm:mx-0"></div>
                        <div class="w-20 h-4 bg-white/[0.05] rounded-lg animate-pulse mx-auto sm:mx-0"></div>
                    </div>
                </div>
                <div class="w-full md:w-48 h-12 bg-white/[0.05] rounded-2xl animate-pulse"></div>
            </div>
            <!-- Stats Grid Skeleton -->
            <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 mb-12">
                <div class="bg-white/[0.02] border border-white/5 rounded-2xl p-6 animate-pulse"><div class="w-10 h-10 bg-white/[0.05] rounded-xl mx-auto mb-3"></div><div class="w-14 h-6 bg-white/[0.05] rounded-lg mx-auto mb-2"></div><div class="w-20 h-3 bg-white/[0.05] rounded mx-auto"></div></div>
