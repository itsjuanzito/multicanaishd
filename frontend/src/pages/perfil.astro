            const state = authStore.get();
            const { isVIP, vipPlan } = state;
            const isDiamond = isVIP && vipPlan && (String(vipPlan).startsWith('diamond_') || String(vipPlan).startsWith('black_'));

            if (isDiamond) {
                uploadLocked?.classList.add('hidden');
                uploadActive?.classList.remove('hidden');
            } else {
                uploadLocked?.classList.remove('hidden');
                uploadActive?.classList.add('hidden');
            }
        }

        // Abrir modal
        wrapper.addEventListener('click', (e) => {
            e.preventDefault();
            modal.classList.remove('hidden');
            const state = authStore.get();
            const currentAvatar = state.avatar || '1';

            // Destacar avatar atual e mostrar badge de ativo (suporta 10 avatares)
            for (let i = 1; i <= 10; i++) {
                const badge = document.getElementById(`avatar-active-badge-${i}`);
                const btn = document.querySelector(`[data-avatar-option="${i}"]`);
                const activeBorderClass = i > 5 ? 'border-indigo-500' : 'border-[#DF0912]';

                if (badge) {
                    if (String(i) === currentAvatar) {
                        badge.classList.remove('hidden');
                        badge.classList.add('flex');
                    } else {
                        badge.classList.add('hidden');
                        badge.classList.remove('flex');
                    }
                }
                if (btn) {
                    if (String(i) === currentAvatar) {
                        btn.classList.add(activeBorderClass);
                        btn.classList.remove('border-transparent');
                    } else {
                        btn.classList.remove(activeBorderClass);
                        btn.classList.add('border-transparent');
                    }
                }
            }

            refreshUploadState();
        });

        // Fechar modal
        const closeModal = () => modal.classList.add('hidden');
        closeBtn?.addEventListener('click', closeModal);
        cancelBtn?.addEventListener('click', closeModal);
        backdrop?.addEventListener('click', closeModal);

        // Upload de avatar customizado para usuários Diamond
        uploadLocked?.addEventListener('click', () => {
            closeModal();
            document.dispatchEvent(new CustomEvent('multicanaishd:open-vip'));
            import("../store/toastStore").then(m => {
                m.showToast(
                    isPt 
                        ? 'O upload de fotos e GIFs customizados é exclusivo do MultiCanaisHD VIP Diamond! 💎' 
                        : 'Custom photo and GIF upload is exclusive to MultiCanaisHD VIP Diamond! 💎',
                    'info'
                );
            });
        });

        uploadActive?.addEventListener('click', () => {
            fileInput?.click();
        });

        fileInput?.addEventListener('change', async () => {
            const file = fileInput.files?.[0];
            if (!file) return;

            // 1. Double-Security: Validação dupla de permissão Diamond (Pilar 2 - Segurança Proativa)
            const state = authStore.get();
            const { isVIP, vipPlan } = state;
            const isDiamond = isVIP && vipPlan && (String(vipPlan).startsWith('diamond_') || String(vipPlan).startsWith('black_'));

            if (!isDiamond) {
                import("../store/toastStore").then(m => {
                    m.showToast(
                        isPt 
                            ? 'Acesso negado! O upload é exclusivo para membros MultiCanaisHD VIP Diamond. 💎' 
                            : 'Access denied! Upload is exclusive to MultiCanaisHD VIP Diamond members. 💎',
                        'error'
                    );
                });
                fileInput.value = '';
                return;
            }

            // 2. Validação estrita de extensão (Pilar 2)
            const extension = file.name.split('.').pop()?.toLowerCase() || '';
            const allowedExtensions = ['png', 'jpg', 'jpeg', 'gif'];
            if (!allowedExtensions.includes(extension)) {
                import("../store/toastStore").then(m => {
                    m.showToast(
                        isPt 
                            ? 'Formato de arquivo inválido! Apenas PNG, JPG, JPEG e GIF são permitidos.' 
                            : 'Invalid file format! Only PNG, JPG, JPEG and GIF are allowed.',
                        'error'
                    );
                });
                fileInput.value = '';
                return;
            }

            // 3. Validação estrita de tipo MIME para evitar spoofing (Pilar 2)
            const allowedMimeTypes = ['image/png', 'image/jpeg', 'image/gif', 'image/webp'];
            if (!allowedMimeTypes.includes(file.type)) {
                import("../store/toastStore").then(m => {
                    m.showToast(
                        isPt 
                            ? 'Tipo de arquivo não permitido! Apenas PNG, JPG, WEBP ou GIF.' 
                            : 'File type not allowed! Only PNG, JPG, WEBP or GIF.',
                        'error'
                    );
                });
                fileInput.value = '';
                return;
            }

            // 4. Limite de tamanho de 10MB para proteger o armazenamento (Permite GIFs de alta qualidade)
            if (file.size > 10 * 1024 * 1024) {
                import("../store/toastStore").then(m => {
                    m.showToast(
                        isPt 
                            ? 'O arquivo é muito grande! Escolha um arquivo de até 10MB.' 
                            : 'The file is too large! Please choose a file up to 10MB.',
                        'error'
                    );
                });
                fileInput.value = '';
                return;
            }

            uploadLoading?.classList.remove('hidden');

            try {
                const token = state.token;
                if (!token) throw new Error(isPt ? "Sessão expirada. Faça login novamente." : "Session expired. Please login again.");

                const formData = new FormData();
                formData.append('file', file);
                formData.append('token', token);

                const res = await fetch('/api/user/upload-avatar', {
                    method: 'POST',
                    body: formData
                });

                const resData = await res.json();
                if (!res.ok) {
                    throw new Error(resData.error || "Failed to upload");
                }

                const publicUrl = resData.publicUrl;
                if (!publicUrl) throw new Error("Public URL not found");

                // Atualizar avatar no perfil local
                const updateRes = await updateAvatar(publicUrl);
                if (updateRes.success) {
                    closeModal();
                    import("../store/toastStore").then(m => {
                        m.showToast(
                            isPt 
                                ? 'Seu avatar customizado foi atualizado com sucesso! 💎' 
                                : 'Your custom avatar was successfully updated! 💎',
                            'success'
                        );
                    });
                } else {
                    throw new Error(updateRes.error || "Save error");
                }

            } catch (err: any) {
                console.error("❌ [Upload Avatar] Erro:", err);
                import("../store/toastStore").then(m => {
                    m.showToast(
                        isPt 
                            ? `Erro ao enviar arquivo: ${err.message || "Tente novamente."}` 
                            : `File upload failed: ${err.message || "Please try again."}`,
                        'error'
                    );
                });
            } finally {
                uploadLoading?.classList.add('hidden');
                fileInput.value = '';
            }
        });

        // Selecionar opção de avatar oficial
        document.querySelectorAll('[data-avatar-option]').forEach(btn => {
            btn.addEventListener('click', async () => {
                const avatarIdx = btn.getAttribute('data-avatar-option');
                if (!avatarIdx) return;

                const isVipOnly = btn.getAttribute('data-vip-only') === 'true';
                const state = authStore.get();
                const { isVIP } = state;

                if (isVipOnly && !isVIP) {
                    const dl = document.getElementById('stats-data-layer');
                    const lang = dl?.getAttribute('data-lang') || 'pt';
                    
                    import("../store/toastStore").then(m => {
                        m.showToast(
                            lang === 'pt' 
                                ? 'Este avatar de personagem é exclusivo do MultiCanaisHD VIP!' 
                                : 'This character avatar is exclusive to MultiCanaisHD VIP!',
                            'error'
                        );
                    });

                    document.dispatchEvent(new CustomEvent('multicanaishd:open-vip'));
                    return;
                }

                closeModal();

                try {
                    const res = await updateAvatar(avatarIdx);
                    if (!res.success) {
                        console.error("❌ [Avatar] Erro ao salvar avatar no banco:", res.error);
                    }
                } catch (err) {
                    console.error("❌ [Avatar] Erro inesperado ao salvar avatar:", err);
                }
            });
        });
    }

    // Gerenciador interativo de edição e salvamento do nickname
    function initNicknameEditor() {
        const editBtn = document.getElementById('edit-username-btn');
        const saveBtn = document.getElementById('save-username-btn');
        const cancelBtn = document.getElementById('cancel-username-btn');
        const input = document.getElementById('username-input') as HTMLInputElement;
        
        const displayWrapper = document.getElementById('username-display-wrapper');
        const editWrapper = document.getElementById('username-edit-wrapper');
        const errorMsg = document.getElementById('username-error-msg');

        if (!editBtn || !saveBtn || !cancelBtn || !input || !displayWrapper || !editWrapper || !errorMsg) return;

        // Sanitização proativa em tempo real enquanto o usuário digita (Pilar 2)
        input.addEventListener('input', () => {
            input.value = input.value.replace(/[^a-zA-Z0-9áéíóúâêîôûãõçÁÉÍÓÚÂÊÎÔÛÃÕÇ_ ]/g, '');
        });

        // Clique em Editar
        editBtn.addEventListener('click', () => {
            const state = authStore.get();
            input.value = state.username || '';
            
            displayWrapper.classList.add('hidden');
            editWrapper.classList.remove('hidden');
            editWrapper.classList.add('flex');
            
            errorMsg.classList.add('hidden');
            errorMsg.textContent = '';
            input.focus();
        });

        // Clique em Cancelar
        cancelBtn.addEventListener('click', () => {
            displayWrapper.classList.remove('hidden');
            editWrapper.classList.add('hidden');
            editWrapper.classList.remove('flex');
            
            errorMsg.classList.add('hidden');
            errorMsg.textContent = '';
        });

        // Clique em Salvar
        saveBtn.addEventListener('click', async () => {
            const val = input.value.trim();
            
            // Validação simples de tamanho mínimo local antes de disparar requisição
            if (val.length < 2 || val.length > 25) {
                const isPt = document.getElementById('stats-data-layer')?.getAttribute('data-lang') === 'pt';
                errorMsg.textContent = isPt 
                    ? "O nome de exibição deve ter entre 2 e 25 caracteres." 
                    : "Display name must be between 2 and 25 characters.";
                errorMsg.classList.remove('hidden');
                return;
            }

            // Desabilitar UI durante a requisição para evitar cliques simultâneos (Pilar 2)
            input.disabled = true;
            saveBtn.disabled = true;
            cancelBtn.disabled = true;
            saveBtn.textContent = '...';

            try {
                const res = await updateUsername(val);
                if (res.success) {
                    displayWrapper.classList.remove('hidden');
                    editWrapper.classList.add('hidden');
                    editWrapper.classList.remove('flex');
                    errorMsg.classList.add('hidden');
                } else {
                    errorMsg.textContent = res.error || 'Erro.';
                    errorMsg.classList.remove('hidden');
                }
            } catch (err: any) {
                console.error("❌ [Profile] Erro ao salvar nickname:", err);
                errorMsg.textContent = err.message || 'Erro inesperado.';
                errorMsg.classList.remove('hidden');
            } finally {
                input.disabled = false;
                saveBtn.disabled = false;
                cancelBtn.disabled = false;
                saveBtn.textContent = document.getElementById('stats-data-layer')?.getAttribute('data-lang') === 'pt' ? 'Salvar' : 'Save';
            }
        });
    }

    // Gerenciador interativo de edição e salvamento do nickname exclusivo
    function initNicknameChangeEditor() {
        const editBtn = document.getElementById('edit-nickname-btn');
        const saveBtn = document.getElementById('save-nickname-btn');
        const cancelBtn = document.getElementById('cancel-nickname-btn');
        const input = document.getElementById('nickname-input') as HTMLInputElement;
        
        const displayWrapper = document.getElementById('nickname-display-wrapper');
        const editWrapper = document.getElementById('nickname-edit-wrapper');
        const errorMsg = document.getElementById('nickname-error-msg');

        if (!editBtn || !saveBtn || !cancelBtn || !input || !displayWrapper || !editWrapper || !errorMsg) return;

        // Sanitização proativa em tempo real enquanto o usuário digita (Pilar 2)
        input.addEventListener('input', () => {
            input.value = input.value.toLowerCase().replace(/[^a-z0-9_]/g, '');
        });

        // Clique em Editar
        editBtn.addEventListener('click', () => {
            const state = authStore.get();
            input.value = state.nickname || '';
            
            displayWrapper.classList.add('hidden');
            editWrapper.classList.remove('hidden');
            editWrapper.classList.add('flex');
            
            errorMsg.classList.add('hidden');
            errorMsg.textContent = '';
            input.focus();
        });

        // Clique em Cancelar
        cancelBtn.addEventListener('click', () => {
            displayWrapper.classList.remove('hidden');
            editWrapper.classList.add('hidden');
            editWrapper.classList.remove('flex');
            
            errorMsg.classList.add('hidden');
            errorMsg.textContent = '';
        });

        // Clique em Salvar
        saveBtn.addEventListener('click', async () => {
            const val = input.value.trim().toLowerCase();
            const isPt = document.getElementById('stats-data-layer')?.getAttribute('data-lang') === 'pt';

            if (val.length < 3 || val.length > 20) {
                errorMsg.textContent = isPt 
                    ? "O nickname deve ter entre 3 e 20 caracteres (apenas letras minúsculas, números e sublinhados)." 
                    : "Nickname must be between 3 and 20 characters (a-z, 0-9, _).";
                errorMsg.classList.remove('hidden');
                return;
            }

            const state = authStore.get();
            const changesCount = state.nicknameChanges;
            const planLower = String(state.vipPlan || '').toLowerCase();
            const isDiamond = state.isVIP && (planLower.includes('diamond') || planLower.includes('black'));
            let limit = state.isVIP ? (isDiamond ? Infinity : 5) : 1;

            if (changesCount >= limit) {
                errorMsg.textContent = isPt 
                    ? "Limite de alterações atingido para o seu plano." 
                    : "Changes limit reached for your plan.";
                errorMsg.classList.remove('hidden');
                return;
            }

            // Desabilitar UI para prevenir cliques simultâneos (Pilar 2)
            input.disabled = true;
            saveBtn.disabled = true;
            cancelBtn.disabled = true;
            saveBtn.textContent = '...';

            try {
                const res = await updateNickname(val);
                if (res.success) {
                    displayWrapper.classList.remove('hidden');
                    editWrapper.classList.add('hidden');
                    editWrapper.classList.remove('flex');
                    errorMsg.classList.add('hidden');
                } else {
                    errorMsg.textContent = res.error || 'Erro.';
                    errorMsg.classList.remove('hidden');
                }
            } catch (err: any) {
                console.error("❌ [Profile] Erro ao salvar nickname:", err);
                errorMsg.textContent = err.message || 'Erro inesperado.';
                errorMsg.classList.remove('hidden');
            } finally {
                input.disabled = false;
                saveBtn.disabled = false;
                cancelBtn.disabled = false;
                saveBtn.textContent = isPt ? 'Salvar' : 'Save';
            }
        });
    }

    async function loadPublicProfile(searchUser) {
        const isPt = document.getElementById('stats-data-layer')?.getAttribute('data-lang') === 'pt';
        
        const banner = document.getElementById('public-profile-banner');
        const bannerText = document.getElementById('inspection-banner-text');
        const loader = document.getElementById('public-profile-loading');
        const errorFallback = document.getElementById('public-profile-error');
        const loggedInContainer = document.getElementById('logged-in-container');
        const loggedOutContainer = document.getElementById('logged-out-container');

        // Hide all containers initially to build pristine state (Pilar 1)
        loggedInContainer?.classList.add('hidden');
        loggedOutContainer?.classList.add('hidden');
        banner?.classList.add('hidden');
        errorFallback?.classList.add('hidden');
        loader?.classList.remove('hidden');
        loader?.classList.add('flex');

        try {
            // Fetch secure profile (Pilar 2)
            const res = await fetch(`/api/user/get-profile?u=${encodeURIComponent(searchUser)}&t=${Date.now()}`);
            if (!res.ok) {
                throw new Error("User not found");
            }
            const data = await res.json();
            const profile = data.profile;

            if (!profile) {
                throw new Error("Invalid profile structure");
            }

            // Hide loader
            loader?.classList.add('hidden');
            loader?.classList.remove('flex');

            // Show banner and update its text
            if (banner && bannerText) {
                bannerText.textContent = isPt 
                    ? `Visualizando Perfil de ${profile.username}`
                    : `Viewing ${profile.username}'s Profile`;
                banner.classList.remove('hidden');
            }

            // Show dashboard container
            loggedInContainer?.classList.remove('hidden');

            // Protect actions/edits (Pilar 2)
            document.getElementById('edit-username-btn')?.classList.add('hidden');
            document.getElementById('edit-nickname-btn')?.classList.add('hidden');
            document.getElementById('user-display-email')?.classList.add('hidden');
            document.getElementById('logout-btn')?.classList.add('hidden');

            const avatarWrapper = document.getElementById('user-profile-avatar-wrapper');
            if (avatarWrapper) {
                avatarWrapper.classList.remove('cursor-pointer', 'active:scale-95', 'group');
                avatarWrapper.classList.add('cursor-default');
                avatarWrapper.setAttribute('title', '');
                avatarWrapper.style.pointerEvents = 'none';
            }
            document.getElementById('avatar-edit-overlay')?.classList.add('hidden');

            // Populate public values onto elements (Pilar 1 & 2)
            const userDisplayNameEl = document.getElementById('user-display-name');
            if (userDisplayNameEl) {
                userDisplayNameEl.textContent = profile.username;
                userDisplayNameEl.className = "text-2xl sm:text-4xl font-black text-white tracking-tighter italic leading-none truncate";
            }

            const userNicknameEl = document.getElementById('user-nickname');
            if (userNicknameEl) {
                userNicknameEl.textContent = profile.nickname ? `@${profile.nickname}` : '@---';
            }

            const changesLeftEl = document.getElementById('nickname-changes-left');
            if (changesLeftEl) {
                changesLeftEl.classList.add('hidden');
            }

            const membershipBadge = document.getElementById('user-membership-badge');
            if (membershipBadge) {
                const badgeBase = "px-2.5 py-1 rounded-lg text-[11px] font-semibold select-none border";
                if (profile.isVIP) {
                    const planLower = String(profile.vipPlan || '').toLowerCase();
                    if (planLower.includes('black')) {
                        membershipBadge.textContent = "⚫ VIP Black";
                        membershipBadge.className = `${badgeBase} bg-neutral-300/10 border-neutral-400/30 text-neutral-200`;
                    } else if (planLower.includes('diamond')) {
                        membershipBadge.textContent = "💎 VIP Diamond";
                        membershipBadge.className = `${badgeBase} bg-cyan-500/10 border-cyan-400/30 text-cyan-400`;
                    } else {
                        membershipBadge.textContent = isPt ? "MultiCanaisHD VIP Básico" : "MultiCanaisHD VIP Basic";
                        membershipBadge.className = `${badgeBase} bg-white/[0.06] border-white/15 text-gray-300`;
                    }
                } else {
                    membershipBadge.textContent = isPt ? "Membro Standard" : "Standard Member";
                    membershipBadge.className = `${badgeBase} bg-white/[0.04] border-white/[0.08] text-gray-500`;
                }
            }

            // Sync custom or standard avatar
            const avatarFallback = document.getElementById('avatar-fallback');
            const avatarCustom = document.getElementById('avatar-custom');
            avatarFallback?.classList.add('opacity-0');
            if (avatarCustom) {
                avatarCustom.classList.remove('opacity-0');
                avatarCustom.classList.add('opacity-100');
                avatarCustom.innerHTML = `<img src="${getAvatarPath(profile.avatar)}" class="w-full h-full rounded-full object-cover" alt="User Avatar" />`;
                avatarCustom.style.background = 'none';

                // Set avatar level border based on hours (Pilar 1)
                const totalHours = (profile.activeSeconds || 0) / 3600;
                avatarCustom.className = "absolute inset-0 rounded-full flex items-center justify-center text-white font-black text-3xl sm:text-4xl transition-all duration-500 opacity-100 border-[3px] select-none shadow-inner";
                avatarCustom.style.boxShadow = 'none';
                avatarCustom.style.borderColor = '';

                if (totalHours >= 100) {
                    avatarCustom.style.borderColor = '#8B5CF6';
                } else if (totalHours >= 50) {
                    avatarCustom.style.borderColor = '#EF4444';
                } else if (totalHours >= 20) {
                    avatarCustom.style.borderColor = '#10B981';
                } else if (totalHours >= 5) {
                    avatarCustom.style.borderColor = '#06B6D4';
                } else {
                    avatarCustom.style.borderColor = '#B45309';
                }
            }

            const idBadge = document.getElementById('user-better-id-badge');
            if (idBadge) {
                idBadge.textContent = `#${profile.id}`;
                idBadge.classList.remove('hidden');
                idBadge.onclick = (e) => {
                    e.stopPropagation();
                    navigator.clipboard.writeText(profile.id).then(() => {
                        const originalText = idBadge.textContent;
                        idBadge.textContent = isPt ? 'Copiado!' : 'Copied!';
                        idBadge.classList.add('text-emerald-400', 'border-emerald-500/50');
                        setTimeout(() => {
                            idBadge.textContent = originalText;
                            idBadge.classList.remove('text-emerald-400', 'border-emerald-500/50');
                        }, 2000);
                    });
                };
            }

            // Render VIP details
            const statusText = document.getElementById('vip-status-text');
            const vipActions = document.getElementById('vip-actions');
            if (statusText && vipActions) {
                if (profile.isVIP) {
                    const activeLabel = profile.vipPlan ? `💎 ${formatVipPlan(profile.vipPlan, isPt ? 'pt' : 'en')}` : (isPt ? "MULTICANAISHD VIP ATIVO" : "MULTICANAISHD VIP ACTIVE");
                    statusText.innerHTML = `<span class="text-white font-black tracking-tight">${activeLabel}</span>`;
                    vipActions.innerHTML = `
                        <div class="px-4 py-3 bg-white/[0.04] border border-white/[0.08] rounded-2xl text-gray-400 font-semibold text-[11px] text-center">
                            Acesso VIP Ativo
                        </div>
                    `;
                } else {
                    statusText.textContent = isPt ? "Membro Standard sem assinatura ativa." : "Standard Member without active subscription.";
                    vipActions.innerHTML = '';
                }
            }

            // Populate static stats cards (Pilar 1)
            const movieEl = document.getElementById('stat-movies');
            const epEl = document.getElementById('stat-episodes');
            if (movieEl) movieEl.innerText = profile.moviesCount.toString();
            if (epEl) epEl.innerText = profile.episodesCount.toString();

            // Total Hours & Level
            const totalHours = (profile.activeSeconds || 0) / 3600;
            const seasonHours = (profile.rankingActiveSeconds !== undefined && profile.rankingActiveSeconds !== null ? profile.rankingActiveSeconds : profile.activeSeconds || 0) / 3600;
            
            const hourEl = document.getElementById('stat-hours');
            const seasonHourEl = document.getElementById('stat-season-hours');
            
            const formatBetterHours = (h) => {
                const hrs = Math.floor(h);
                const mins = Math.round((h - hrs) * 60);
                if (hrs > 0 && mins > 0) return `${hrs}h ${mins}m`;
                if (hrs > 0) return `${hrs}h`;
                return `${mins}m`;
            };
            if (hourEl) hourEl.innerText = formatBetterHours(totalHours);
            if (seasonHourEl) seasonHourEl.innerText = formatBetterHours(seasonHours);

            const rankIcon = document.getElementById('rank-icon');
            const rankName = document.getElementById('rank-name');
            const rankProgress = document.getElementById('rank-progress');
            const rankNext = document.getElementById('rank-next');
            
            let rank = { icon: '🐣', name: isPt ? 'Iniciante' : 'Beginner', next: 5, percent: 10 };
            if (totalHours >= 100) rank = { icon: '👑', name: isPt ? 'Lenda' : 'Legend', next: 0, percent: 100 };
            else if (totalHours >= 50) rank = { icon: '🔥', name: isPt ? 'Viciado' : 'Addict', next: 100 - totalHours, percent: (totalHours/100)*100 };
            else if (totalHours >= 20) rank = { icon: '跑', name: isPt ? 'Maratonista' : 'Marathoner', next: 50 - totalHours, percent: (totalHours/50)*100 };
            else if (totalHours >= 5) rank = { icon: '👀', name: isPt ? 'Espectador' : 'Spectator', next: 20 - totalHours, percent: (totalHours/20)*100 };
            else rank = { icon: '🐣', name: isPt ? 'Iniciante' : 'Beginner', next: 5 - totalHours, percent: (totalHours/5)*100 };

            if (rankIcon) rankIcon.innerText = rank.icon;
            if (rankName) rankName.innerText = rank.name;
            if (rankProgress) rankProgress.style.width = `${rank.percent}%`;
            if (rankNext) rankNext.innerText = rank.next > 0 ? (isPt ? `Próximo nível em ${formatBetterHours(rank.next)}` : `Next level in ${formatBetterHours(rank.next)}`) : (isPt ? 'Nível Máximo Atingido!' : 'Max Level Reached!');

            // Recent activities history grid (Pilar 1)
            const recentSection = document.getElementById('recent-activity-section');
            const recentGrid = document.getElementById('recent-grid');
            if (recentSection && recentGrid) {
                recentSection.classList.remove('hidden');
                if (profile.history.length > 0) {
                    recentGrid.innerHTML = profile.history.slice(0, 12).map(item => {
                        const imgUrl = item.backdrop 
                            ? (item.backdrop.startsWith('http') || item.backdrop.startsWith('/') ? item.backdrop : `https://image.tmdb.org/t/p/w780${item.backdrop}`)
                            : (item.poster 
                                ? (item.poster.startsWith('http') || item.poster.startsWith('/') ? item.poster : `https://image.tmdb.org/t/p/w500${item.poster}`)
                                : `https://placehold.co/500x281/111/444?text=${isPt ? 'SEM IMAGEM' : 'NO IMAGE'}`);
                        return `
                            <a href="${item.url}" class="group relative aspect-video rounded-2xl overflow-hidden border border-white/5 bg-[#161B28] shadow-inner transition-all hover:scale-[1.03] hover:border-[#DF0912]/20 hover:shadow-xl duration-300">
                                <img src="${imgUrl}" alt="${item.title}" class="w-full h-full object-cover opacity-40 transition-opacity group-hover:opacity-50" />
                                <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/40 to-transparent"></div>
                                <div class="absolute bottom-3 left-4 right-4">
                                     <p class="text-[11px] font-black text-white uppercase tracking-widest truncate mb-1">${item.title}</p>
                                     <div class="flex flex-col gap-1">
                                         <p class="text-[9px] text-gray-400 font-bold flex items-center gap-1.5">
                                             <svg class="w-3.5 h-3.5 text-[#DF0912]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                                 <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                                             </svg>
                                             <span>${formatTimeAgo(item.timestamp, isPt ? 'pt' : 'en')}</span>
                                         </p>
                                         <p class="text-[9px] text-gray-400 font-bold flex items-center gap-1.5">
                                             <svg class="w-3.5 h-3.5 text-[#DF0912]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                                 <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                                             </svg>
                                             <span>${formatWatchedTime(item.watched_seconds, isPt ? 'pt' : 'en')}</span>
                                         </p>
                                     </div>
                                </div>
                            </a>
                        `;
                    }).join('');
                } else {
                    const hasWatched = (profile.moviesCount || 0) > 0 || (profile.episodesCount || 0) > 0;
                    recentGrid.innerHTML = `
                        <div class="col-span-full bg-white/[0.01] backdrop-blur-md border border-white/5 p-8 rounded-2xl flex flex-col items-center justify-center text-center py-12 shadow-inner select-none w-full">
                            <div class="w-16 h-16 rounded-full bg-white/5 flex items-center justify-center text-gray-500 mb-4 border border-white/5">
                                <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                            </div>
                            <p class="text-white text-sm font-bold uppercase tracking-wider mb-2">
                                ${isPt ? 'Nenhuma Atividade Recente' : 'No Recent Activity'}
                            </p>
                            <p class="text-gray-400 text-xs max-w-sm leading-relaxed">
                                ${hasWatched
                                    ? (isPt 
                                        ? 'Este usuário possui conteúdos assistidos em suas estatísticas, mas optou por limpar o histórico de reprodução ou as atividades recentes expiraram.' 
                                        : 'This user has watched content in their statistics, but chose to clear their playback history or recent activities expired.')
                                    : (isPt 
                                        ? 'Este membro ainda não assistiu a nenhum conteúdo no MultiCanaisHD.' 
                                        : 'This member has not watched any content on MultiCanaisHD yet.')}
                            </p>
                        </div>
                    `;
                }
            }

            // Genre vibe calculation
            const genres = profile.history
                .filter(i => i.genreName || i.genre)
                .map(i => {
                    const rawGenre = i.genreName || i.genre;
                    return rawGenre.includes(',') ? rawGenre.split(',')[0].trim() : rawGenre.trim();
                })
                .filter(g => g && g !== 'N/A');

            const genreCounts = genres.reduce((acc, g) => { acc[g] = (acc[g] || 0) + 1; return acc; }, {});
            const topGenre = Object.entries(genreCounts).sort((a,b) => b[1] - a[1])[0]?.[0] || '---';
            const genreEl = document.getElementById('stat-genre');
            if (genreEl) {
                genreEl.innerText = topGenre;
                if (topGenre === '---') {
                    genreEl.className = "text-[10px] font-black text-gray-500 bg-white/5 border border-white/10 px-3 py-0.5 rounded-lg truncate tracking-widest uppercase";
                } else {
                    genreEl.className = "text-[10px] font-black text-emerald-400 bg-emerald-500/10 border border-emerald-500/20 px-3 py-0.5 rounded-lg truncate tracking-widest uppercase";
                }
            }

            // Favorites
            const favEl = document.getElementById('stat-favorites');
            if (favEl) favEl.innerText = (profile.favorites || []).length.toString();

        } catch (err) {
            console.error("❌ [Public Profile] Error loading public profile:", err);
            loader?.classList.add('hidden');
            loader?.classList.remove('flex');
            errorFallback?.classList.remove('hidden');
            errorFallback?.classList.add('flex');
        }
    }

    // Inicialização unificada ao montar/trocar a página no Astro
    document.addEventListener("astro:page-load", () => {
        const dl = document.getElementById('stats-data-layer');
        if (!dl) return; // Carrega script apenas na página de Perfil
        
        const urlParams = new URLSearchParams(window.location.search);
        const searchUser = urlParams.get('u') || urlParams.get('username') || urlParams.get('user');

        if (searchUser) {
            // Modo Perfil Público (Inspeção)
            loadPublicProfile(searchUser);
        } else {
            // Modo Normal (Meu Perfil)
            document.getElementById('public-profile-banner')?.classList.add('hidden');
            document.getElementById('public-profile-loading')?.classList.add('hidden');
            document.getElementById('public-profile-error')?.classList.add('hidden');

            // Restore dashboard control options
            document.getElementById('edit-username-btn')?.classList.remove('hidden');
            document.getElementById('edit-nickname-btn')?.classList.remove('hidden');
            document.getElementById('user-display-email')?.classList.remove('hidden');
            document.getElementById('logout-btn')?.classList.remove('hidden');

            const avatarWrapper = document.getElementById('user-profile-avatar-wrapper');
            if (avatarWrapper) {
                avatarWrapper.classList.add('cursor-pointer', 'active:scale-95', 'group');
                avatarWrapper.classList.remove('cursor-default');
                avatarWrapper.style.pointerEvents = 'auto';
            }
            document.getElementById('avatar-edit-overlay')?.classList.remove('hidden');

            syncProfileUI();
            initAuth(true).finally(() => {
                syncProfileUI();
                updateDashboardData();
            });
            updateDashboardData();
            initLogout();
            initAvatarSelector();
            initNicknameEditor();
            initNicknameChangeEditor();

            // Inscreve as stores para atualização reativa em tempo de execução
            const unsubAuth = authStore.subscribe(() => {
                syncProfileUI();
                updateDashboardData();
            });
            const unsubFavs = favoritesStore.subscribe(updateDashboardData);
            const unsubProfiles = profilesStore.subscribe(syncAccountProfilesCard);

            // Desinscreve as assinaturas para evitar vazamento de memória nas transições SPA
            document.addEventListener("astro:before-swap", () => {
                unsubAuth();
                unsubFavs();
                unsubProfiles();
            }, { once: true });
        }
    });
</script>
