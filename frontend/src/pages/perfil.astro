    // Processa os dados de progresso e estatísticas assistidas
    async function updateDashboardData() {
        try {
            const state = authStore.get();
            const isLogged = !!state.user;
            const dl = document.getElementById('stats-data-layer');
            if (!dl) return;

            const t = (key, params) => {
                let text = dl.getAttribute(`data-t-${key}`) || key;
                if (params) {
                    Object.entries(params).forEach(([k, v]) => {
                        const regex = new RegExp(`{${k}}`, 'gi');
                        text = text.replace(regex, String(v));
                    });
                }
                return text;
            };

            let watchedMoviesList = [];
            let episodesCount = 0;
            let history = [];

            if (isLogged) {
                watchedMoviesList = state.watchedMovies || [];
                history = (state.history || []).filter(item => item && item.id);
                Object.values(state.watchedEpisodes || {}).forEach(eps => {
                    if (Array.isArray(eps)) episodesCount += eps.length;
                });
            }

            const movieEl = document.getElementById('stat-movies');
            const epEl = document.getElementById('stat-episodes');
            if (movieEl) movieEl.innerText = watchedMoviesList.length.toString();
            if (epEl) epEl.innerText = episodesCount.toString();

            // Cálculo do nível baseado nos segundos ativos auditados (Segurança Heartbeat)
            const totalHours = (state.activeSeconds || 0) / 3600;
            const seasonHours = (state.rankingActiveSeconds !== undefined && state.rankingActiveSeconds !== null ? state.rankingActiveSeconds : state.activeSeconds || 0) / 3600;
            
            const hourEl = document.getElementById('stat-hours');
            const seasonHourEl = document.getElementById('stat-season-hours');
            
            const formatBetterHours = (h) => {
                const hrs = Math.floor(h);
                const mins = Math.round((h - hrs) * 60);
                if (hrs > 0 && mins > 0) return `${hrs}h ${mins}m`;
                if (hrs > 0) return `${hrs}h`;
                return `${mins}m`;
            };

            if (hourEl) hourEl.innerText = formatBetterHours(totalHours);
            if (seasonHourEl) seasonHourEl.innerText = formatBetterHours(seasonHours);

            const rankIcon = document.getElementById('rank-icon');
            const rankName = document.getElementById('rank-name');
            const rankProgress = document.getElementById('rank-progress');
            const rankNext = document.getElementById('rank-next');
            
            let rank = { icon: '🐣', name: t('beginner'), next: 10, percent: 10 };
            if (totalHours >= 100) rank = { icon: '👑', name: t('legend'), next: 0, percent: 100 };
            else if (totalHours >= 50) rank = { icon: '🔥', name: t('addict'), next: 100 - totalHours, percent: (totalHours/100)*100 };
            else if (totalHours >= 20) rank = { icon: '跑', name: t('marathoner'), next: 50 - totalHours, percent: (totalHours/50)*100 };
            else if (totalHours >= 5) rank = { icon: '👀', name: t('spectator'), next: 20 - totalHours, percent: (totalHours/20)*100 };
            else rank = { icon: '🐣', name: t('beginner'), next: 5 - totalHours, percent: (totalHours/5)*100 };

            if (rankIcon) rankIcon.innerText = rank.icon;
            if (rankName) rankName.innerText = rank.name;
            if (rankProgress) rankProgress.style.width = `${rank.percent}%`;
            if (rankNext) rankNext.innerText = rank.next > 0 ? t('next-level', { time: formatBetterHours(rank.next) }) : t('max-level');

            // Atualizar estilo do avatar baseado no Rank obtido
            const avatarCustom = document.getElementById('avatar-custom');
            if (avatarCustom && isLogged) {
                avatarCustom.className = "absolute inset-0 rounded-full flex items-center justify-center text-white font-black text-3xl sm:text-4xl transition-all duration-500 opacity-100 border-[3px] select-none shadow-inner";
                avatarCustom.style.boxShadow = 'none';
                avatarCustom.style.borderColor = '';

                if (totalHours >= 100) {
                    avatarCustom.style.borderColor = '#8B5CF6';
                } else if (totalHours >= 50) {
                    avatarCustom.style.borderColor = '#EF4444';
                } else if (totalHours >= 20) {
                    avatarCustom.style.borderColor = '#10B981';
                } else if (totalHours >= 5) {
                    avatarCustom.style.borderColor = '#06B6D4';
                } else {
                    avatarCustom.style.borderColor = '#B45309';
                }
            }

            // Atividade Recente
            const recentSection = document.getElementById('recent-activity-section');
            const recentGrid = document.getElementById('recent-grid');
            if (recentSection && recentGrid) {
                const dl = document.getElementById('stats-data-layer');
                const isPt = dl?.getAttribute('data-lang') === 'pt';
                recentSection.classList.remove('hidden');
                
                if (history.length > 0) {
                    recentGrid.innerHTML = history.slice(0, 12).map(item => {
                        const imgUrl = item.backdrop 
                            ? (item.backdrop.startsWith('http') || item.backdrop.startsWith('/') ? item.backdrop : `https://image.tmdb.org/t/p/w780${item.backdrop}`)
                            : (item.poster 
                                ? (item.poster.startsWith('http') || item.poster.startsWith('/') ? item.poster : `https://image.tmdb.org/t/p/w500${item.poster}`)
                                : `https://placehold.co/500x281/111/444?text=${t('no-image')}`);
                        return `
                            <a href="${item.url}" class="group relative aspect-video rounded-2xl overflow-hidden border border-white/5 bg-[#161B28] shadow-inner transition-all hover:scale-[1.03] hover:border-[#DF0912]/20 hover:shadow-xl duration-300">
                                <img src="${imgUrl}" alt="${item.title}" class="w-full h-full object-cover opacity-40 transition-opacity group-hover:opacity-50" />
                                <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/40 to-transparent"></div>
                                <div class="absolute bottom-3 left-4 right-4">
                                     <p class="text-[11px] font-black text-white uppercase tracking-widest truncate mb-1">${item.title}</p>
                                     <div class="flex flex-col gap-1">
                                         <p class="text-[9px] text-gray-400 font-bold flex items-center gap-1.5">
                                             <svg class="w-3.5 h-3.5 text-[#DF0912]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                                 <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                                             </svg>
                                             <span>${formatTimeAgo(item.timestamp, isPt ? 'pt' : 'en')}</span>
                                         </p>
                                         <p class="text-[9px] text-gray-400 font-bold flex items-center gap-1.5">
                                             <svg class="w-3.5 h-3.5 text-[#DF0912]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                                 <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                                             </svg>
                                             <span>${formatWatchedTime(item.watched_seconds, isPt ? 'pt' : 'en')}</span>
                                         </p>
                                     </div>
                                </div>
                            </a>
                        `;
                    }).join('');
                } else {
                    const hasWatched = watchedMoviesList.length > 0 || episodesCount > 0;
                    recentGrid.innerHTML = `
                        <div class="col-span-full bg-white/[0.01] backdrop-blur-md border border-white/5 p-8 rounded-2xl flex flex-col items-center justify-center text-center py-12 shadow-inner select-none w-full">
                            <div class="w-16 h-16 rounded-full bg-white/5 flex items-center justify-center text-gray-500 mb-4 border border-white/5">
                                <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                            </div>
                            <p class="text-white text-sm font-bold uppercase tracking-wider mb-2">
                                ${isPt ? 'Nenhuma Atividade Recente' : 'No Recent Activity'}
                            </p>
                            <p class="text-gray-400 text-xs max-w-sm leading-relaxed">
                                ${hasWatched
                                    ? (isPt 
                                        ? 'Você possui conteúdos assistidos em suas estatísticas, mas optou por limpar o histórico de reprodução ou as atividades recentes expiraram.' 
                                        : 'You have watched content in your statistics, but chose to clear your playback history or recent activities expired.')
                                    : (isPt 
                                        ? 'Você ainda não assistiu a nenhum conteúdo no MultiCanaisHD. Comece a explorar nosso catálogo!' 
                                        : 'You have not watched any content on MultiCanaisHD yet. Start exploring our catalog!')}
                            </p>
                        </div>
                    `;
                }
            }

            // Gênero Favorito (Vibe) - Suporta propriedades antigas e novas de forma robusta (Pilar 2 e 3)
            const genres = history
                .filter(i => i.genreName || i.genre)
                .map(i => {
                    const rawGenre = i.genreName || i.genre;
                    return rawGenre.includes(',') ? rawGenre.split(',')[0].trim() : rawGenre.trim();
                })
                .filter(g => g && g !== 'N/A');

            const genreCounts = genres.reduce((acc, g) => { acc[g] = (acc[g] || 0) + 1; return acc; }, {});
            const topGenre = Object.entries(genreCounts).sort((a,b) => b[1] - a[1])[0]?.[0] || '---';
            const genreEl = document.getElementById('stat-genre');
            if (genreEl) {
                genreEl.innerText = topGenre;
                if (topGenre === '---') {
                    genreEl.className = "text-[10px] font-black text-gray-500 bg-white/5 border border-white/10 px-3 py-0.5 rounded-lg truncate tracking-widest uppercase";
                } else {
                    genreEl.className = "text-[10px] font-black text-emerald-400 bg-emerald-500/10 border border-emerald-500/20 px-3 py-0.5 rounded-lg truncate tracking-widest uppercase";
                }
            }

            // Favoritos salvos
            const favorites = favoritesStore.get();
            const favEl = document.getElementById('stat-favorites');
            if (favEl) favEl.innerText = favorites.length.toString();

        } catch (error) {
            console.error('[MultiCanaisHD] Erro ao carregar estatísticas do dashboard:', error);
        }
    }

    // Registro do Botão de Logout
    function initLogout() {
        const btn = document.getElementById('logout-btn');
        if (!btn) return;
        btn.onclick = async (e) => {
            e.preventDefault();
            console.log("👤 [Profile] Iniciando processo de logout...");
            try {
                const { supabase } = await import("../services/supabase");
                const { clearActiveProfile } = await import("../store/profilesStore");
                localStorage.removeItem('bf_session_optimistic');
                localStorage.removeItem('supabase.auth.token');
                clearActiveProfile();
                authStore.set({
                    user: null, token: null, isVIP: false, vipUntil: null, vipPlan: null, loading: false, initialized: true,
                    favorites: [], history: [], watchedMovies: [], watchedEpisodes: {}, username: null, avatar: '1', activeSeconds: 0, nickname: null, nicknameChanges: 0,
                    activeProfileId: null, isKidsProfile: false
                });
                await supabase.auth.signOut();
                const isPt = document.getElementById('stats-data-layer')?.getAttribute('data-lang') === 'pt';
                window.location.href = isPt ? '/login' : '/en/login';
            } catch (err) {
                console.error("Erro ao deslogar:", err);
                localStorage.removeItem('bf_session_optimistic');
                const isPt = document.getElementById('stats-data-layer')?.getAttribute('data-lang') === 'pt';
                window.location.href = isPt ? '/login' : '/en/login';
            }
        };
    }

