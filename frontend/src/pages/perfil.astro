<script>
    import { authStore, initAuth, updateUsername, updateAvatar, updateNickname } from "../store/authStore";
    import { favoritesStore } from "../store/favoritesStore";
    import { profilesStore, getActiveProfile } from "../store/profilesStore";
    import { podeCriarPerfis } from "../services/vipPlans.js";

    function getAvatarPath(avatarId: any) {
        if (!avatarId) return `/avatars/avatar_1.svg`;
        const avatarStr = String(avatarId);
        if (avatarStr.startsWith('http://') || avatarStr.startsWith('https://')) {
            return avatarStr;
        }
        const id = parseInt(avatarStr || '1', 10);
        if (id > 5) {
            return `/avatars/avatar_${id}.png`;
        }
        return `/avatars/avatar_${id}.svg`;
    }

    function formatTimeAgo(ts: any, lang = 'pt') {
        if (!ts) return lang === 'pt' ? 'Recentemente' : 'Recently';
        const now = Date.now();
        const diff = now - parseInt(ts, 10);
        if (isNaN(diff) || diff < 0) return lang === 'pt' ? 'Recentemente' : 'Recently';
        const mins = Math.floor(diff / 60000);
        const hrs = Math.floor(mins / 60);
        const days = Math.floor(hrs / 24);

        if (lang === 'pt') {
            if (mins < 1) return 'Assistido agora';
            if (mins < 60) return `Assistido há ${mins} min`;
            if (hrs < 24) return `Assistido há ${hrs} h`;
            return `Assistido há ${days} dia${days > 1 ? 's' : ''}`;
        } else {
            if (mins < 1) return 'Watched now';
            if (mins < 60) return `Watched ${mins} min ago`;
            if (hrs < 24) return `Watched ${hrs} h ago`;
            return `Watched ${days} day${days > 1 ? 's' : ''} ago`;
        }
    }

    function formatVipPlan(plan: any, lang = 'pt') {
        if (!plan) return lang === 'pt' ? 'VIP Ativo' : 'VIP Active';
        const clean = String(plan).toLowerCase().trim();
        if (clean === 'mensal') return lang === 'pt' ? 'VIP Mensal' : 'Monthly VIP';
        if (clean === 'trimestral') return lang === 'pt' ? 'VIP Trimestral' : 'Quarterly VIP';
        if (clean === 'anual') return lang === 'pt' ? 'VIP Anual' : 'Annual VIP';
        if (clean === 'vitalicio') return lang === 'pt' ? 'VIP Vitalício' : 'Lifetime VIP';
        if (clean === 'diamond_mensal') return lang === 'pt' ? 'VIP Diamond Mensal' : 'VIP Diamond Monthly';
        if (clean === 'diamond_trimestral') return lang === 'pt' ? 'VIP Diamond Trimestral' : 'VIP Diamond Quarterly';
        if (clean === 'diamond_anual') return lang === 'pt' ? 'VIP Diamond Anual' : 'VIP Diamond Annual';
        if (clean === 'black_mensal') return lang === 'pt' ? 'VIP Black Mensal' : 'VIP Black Monthly';
        if (clean === 'black_trimestral') return lang === 'pt' ? 'VIP Black Trimestral' : 'VIP Black Quarterly';
        if (clean === 'black_anual') return lang === 'pt' ? 'VIP Black Anual' : 'VIP Black Annual';
        
        return clean
            .split('_')
            .map(word => word.charAt(0).toUpperCase() + word.slice(1))
            .join(' ');
    }

    function formatWatchedTime(seconds: any, lang = 'pt') {
        if (seconds === undefined || seconds === null) {
            return lang === 'pt' ? 'Não registrado (histórico antigo)' : 'Unrecorded (old history)';
        }
        const secs = parseInt(seconds, 10);
        if (isNaN(secs) || secs < 60) {
            return lang === 'pt' ? 'Tempo assistido: < 1 min' : 'Watched: < 1 min';
        }
        const mins = Math.floor(secs / 60);
        const hrs = Math.floor(mins / 60);
        const remainingMins = mins % 60;

        if (lang === 'pt') {
            if (hrs > 0) {
                return `Tempo assistido: ${hrs}h ${remainingMins}m`;
            }
            return `Tempo assistido: ${mins} min`;
        } else {
            if (hrs > 0) {
                return `Watched: ${hrs}h ${remainingMins}m`;
            }
            return `Watched: ${mins} min`;
        }
    }

    // Sincroniza informações de VIP e perfil com a UI do cabeçalho
    // Card "Assistindo como" — só aparece pra quem tem direito a múltiplos perfis.
    function syncAccountProfilesCard() {
        const card = document.getElementById('account-profiles-card');
        if (!card) return;

        const { vipPlan, user } = authStore.get();
        if (!user || !podeCriarPerfis(vipPlan)) {
            card.classList.add('hidden');
            card.classList.remove('flex');
            return;
        }

        card.classList.remove('hidden');
        card.classList.add('flex');

        // Sem linha de perfil (conta ainda sem account_profiles, ou a lista ainda
        // carregando) o card cai na identidade da própria conta em vez de estampar "---",
        // que o usuário lê como perfil quebrado.
        const state = authStore.get();
        const active = getActiveProfile() || {
            name: state.username || state.nickname || (state.user?.email || '').split('@')[0],
            avatar: state.avatar
        };
        const nameEl = document.getElementById('active-profile-name');
        const avatarEl = document.getElementById('active-profile-avatar');
        if (nameEl) nameEl.textContent = active.name || '';
        if (avatarEl) avatarEl.src = getAvatarPath(active.avatar);
    }

