---
// src/pages/filme/[slug].astro
// @ts-nocheck
import "../../styles/global.css";
export const prerender = false;

// Reduzindo o cache na CDN para evitar problemas de comentários misturados em diferentes episódios
Astro.response.headers.set(
    "Cache-Control",
    "public, s-maxage=3600, stale-while-revalidate=86400",
);

import LayoutCardsStreaming from "../../layouts/LayoutCardsStreaming.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import BetterComments from "../components/BetterComments.astro";
import TrailerModal from "../components/TrailerModal.astro";
// Só esta rota (e /serie/[slug]) dispara `multicanaishd:open-torrent`, então só ela paga o
// TorrentModal. Antes ele vinha do BaseLayout e carregava em toda página do site.
import TorrentModal from "../components/TorrentModal.astro";
import { getTMDBDetails, getTMDBRecommendations } from "../../services/tmdb.js";
import OndeAssistir from "../components/OndeAssistir.astro";
import { getGenreByIdOrSlug } from "../../utils/genres";
import { slugify } from "../../utils/slugify.js";
import { slugDeDetalhes } from "../../utils/canonicalSlug.js";
import { resolveRotatedSlug } from "../../services/urlRotationService.js";
import { upstreamUnavailableResponse } from "../../utils/upstreamUnavailable.js";
import {
    isMobileUA as checkMobileUA,
    getDetailPreloadImageSet,
} from "../../utils/mobile";
import { axiomService } from "../../services/axiom-service.js";

// i18n
import { getLangFromUrl, useTranslations } from "../../i18n/utils";
import { detectLocale } from "../../utils/localeDetection.js";
import { slugCanonicoParaIdioma } from "../../utils/slugCanonico.js";
import { obterParDeSlugs } from "../../services/contentSlugPairs.js";
import { getSiteUrl } from "../../services/env-adapter.js";
import { buildEmbedUrl, getShopUrl, getEmbedPublicKey } from "../../services/streamEmbedService.js";
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const isPt = lang === "pt";
const langPrefix = isPt ? "" : `/${lang}`;
const siteUrl = getSiteUrl(Astro.url);

const userAgent = Astro.request.headers.get("user-agent") || "";
const isMobileUA = checkMobileUA(userAgent);

// Leva usuário estrangeiro/nacional pra versão correta do idioma mesmo entrando
// direto numa página de conteúdo (sem passar pela home antes).
//
// O slug do destino é resolvido AQUI, e não deixado pra página de destino corrigir com um
// segundo redirect — a cadeia 302 -> 301 -> 200 fazia uma visita custar três requisições e
// respondia por ~12% do tráfego do site. Ver utils/slugCanonico.js.
const { activeLocale, isCrawler, isManual, isRewrittenEn, isBrowserNavigation } =
    detectLocale(Astro);
if (!isManual && !isRewrittenEn && !isCrawler && isBrowserNavigation && activeLocale !== lang) {
    // NUNCA cachear este redirect na borda: o destino depende do cookie de idioma e do
    // país do visitante, mas a chave de cache da Cloudflare é só a URL. Um 302 cacheado
    // aqui prenderia TODOS os visitantes no idioma do primeiro que passou. O
    // Cache-Control público setado no topo do arquivo vale só pro HTML de fato renderizado.
    Astro.response.headers.set("Cache-Control", "private, no-store");
    const targetPrefix = activeLocale === "en" ? "/en" : "";
    const idParaSlug = Astro.params.slug?.match(/^(\d+)/)?.[1];
    const slugDestino = await slugCanonicoParaIdioma(
        idParaSlug,
        "movie",
        activeLocale,
        Astro.params.slug,
    );
    return Astro.redirect(
        `${targetPrefix}/filme/${slugDestino}${Astro.url.search}`,
        302,
    );
}

const { slug } = Astro.params;
const type = "movie";

// Astro.rewrite("/404") reinicia o pipeline de middleware pro novo path, então o log de
// requisição no middleware.js só enxerga "/404" genérico — logamos aqui, com a URL original
// ainda intacta, pra saber de fato qual slug quebrou.
const logNotFound = (reason) => {
    const p = axiomService.ingest({
        _time: new Date().toISOString(),
        type: "content_not_found",
        path: Astro.url.pathname,
        reason,
        platform: "multicanaishd-web",
    });
    if (Astro.locals.runtime?.waitUntil) {
        Astro.locals.runtime.waitUntil(p);
    } else {
        p.catch(() => {});
    }
};

const idMatch = slug.match(/^(\d+)/);
const id = idMatch ? idMatch[1] : null;

// Sem ID não há o que buscar — 404 legítimo. Mas ID válido com parte textual vazia
// ('/filme/47002-') NÃO é 404: é um link nosso mal gerado pra título em script não-latino,
// e 404-ar matava conteúdo que existe. Deixa seguir; o redirect canônico mais abaixo manda
// pra URL certa, que agora é garantidamente não-vazia via contentSlug().
if (!id) {
    Astro.response.status = 404;
    logNotFound("invalid_slug");
    return Astro.rewrite("/404");
}

// Sem chave por padrão: `isVIP` no SSR é sempre false (ver comentário mais abaixo, HTML
// precisa ser cacheável e não pode variar por usuário) — quem decide se inclui a chave (VIP =
// sem anúncio da StreamBetter) é o cliente, via isVip() real, remontando a URL na hora.
const embedUrl = buildEmbedUrl({ kind: "movie", tmdbId: id, includeKey: false });

const removableSeoParams = [
    "id",
    "type",
    "fromSearch",
    "play",
    "fbclid",
    "gclid",
    "gclsrc",
    "dclid",
    "msclkid",
    "utm_source",
    "utm_medium",
    "utm_campaign",
    "utm_term",
    "utm_content",
    "debug",
];
if (removableSeoParams.some((param) => Astro.url.searchParams.has(param))) {
    const cleanParams = new URLSearchParams(Astro.url.searchParams);
    removableSeoParams.forEach((param) => cleanParams.delete(param));
    for (const key of Array.from(cleanParams.keys())) {
        if (key.startsWith("utm_")) cleanParams.delete(key);
    }
    const qs = cleanParams.toString() ? `?${cleanParams.toString()}` : "";
    // langPrefix obrigatório: em /en/* o Astro.url.pathname é o path PT (a rota /en reescreve
    // para a PT com ?lang=en). Sem o prefixo, uma URL inglesa com parâmetro de tracking era
    // 301-ada para a página em PORTUGUÊS — o oposto do canônico que ela mesma declara.
    return Astro.redirect(`${langPrefix}${Astro.url.pathname}${qs}`, 301);
}

const fromSearch = Astro.url.searchParams.get("fromSearch");

let response, dadosMulti, ano, backUrl, recommendationsResponse,
    // Alternates de idioma (ver services/contentSlugPairs.js): ficam fora do try porque quem
    // consome é o BaseLayout, no corpo do arquivo. O objeto vazio (dois nulls) é o sentinela
    // de "não sei os slugs do outro idioma" — ver o comentário no ponto onde ele é preenchido.
    alternates = { pt: null, en: null };

// --- MASTER PARALLELIZATION (Zero-Wait) ---
const [tmdbDetails, tmdbRecs] = await Promise.all([
    getTMDBDetails(id, type, lang).catch((e) => {
        console.error(`[Filme] Fallback TMDB details:`, e.message);
        return null;
    }),
    getTMDBRecommendations(id, type, lang).catch((e) => {
        console.error(`[Filme] Fallback recommendations:`, e.message);
        return { results: [] };
    }),
]);

try {
    response = tmdbDetails;
    recommendationsResponse = tmdbRecs;

    // Falha de origem ≠ conteúdo inexistente. getTMDBDetails devolve `{ notFound: true }`
    // só quando o TMDB confirma 404; timeout, 429 e 5xx viram exceção e chegam aqui como
    // null. Antes os dois casos caíam no mesmo rewrite("/404"), então um blip do TMDB
    // desindexava URLs válidas que estão no sitemap. Ver upstreamUnavailable.js.
    if (
        !response ||
        response.success === false ||
        (!response.title && !response.name && !response.notFound)
    ) {
        console.error(
            `🔴 [Filme] Origem indisponível para o item: ${id}.`,
            response,
        );
        logNotFound("tmdb_load_failed");
        return upstreamUnavailableResponse(lang);
    }

    if (response.notFound) {
        Astro.response.status = 404;
        logNotFound("tmdb_not_found");
        return Astro.rewrite("/404");
    }

    dadosMulti = {
        id: id,
        name: response.title || response.name,
        date: response.release_date || null,
        bio: response.overview,
        vote: response.vote_average || 0,
        genres: response.genres?.map((g) => g.name).join(", ") || "N/A",
        imdbId: response.imdb_id || null,
        poster: response.poster_path
            ? `https://image.tmdb.org/t/p/w500${response.poster_path}`
            : null,
        backdrop: response.backdrop_path
            ? `https://image.tmdb.org/t/p/w1280${response.backdrop_path}`
            : null,
        runtime: response.runtime || 100,
    };

    // SEO Hygiene & Anti-DMCA URL Rotation: Redireciona se o slug textual estiver desatualizado
    // Se a obra sofreu rotação Anti-DMCA (Google/Lumen), o current_slug rotacionado tem prioridade.
    // Cada idioma tem sua própria rotação (colunas _en em url_rotations): o canônico desta rota
    // precisa do idioma DELA — passar o idioma errado mandaria o visitante de /en/ para um slug
    // em português (ou vice-versa) e geraria um 301 em cada pageview.
    const canonicalSlug = slugDeDetalhes(id, response, lang);
    const expectedSlug = await resolveRotatedSlug(id, 'movie', canonicalSlug, lang);

    if (slug !== expectedSlug) {
        const langPrefix = isPt ? "" : `/${lang}`;
        const safeParams = new URLSearchParams();
        for (const [key, value] of Astro.url.searchParams.entries()) {
            if (!["lang", "id", "type"].includes(key)) {
                safeParams.set(key, value);
            }
        }
        const qs = safeParams.toString() ? `?${safeParams.toString()}` : "";
        return Astro.redirect(`${langPrefix}/filme/${expectedSlug}${qs}`, 301);
    }

    // Alternates de idioma calculados de verdade (ver services/contentSlugPairs.js).
    // Espelhar o path e trocar /en só funciona quando o slug é igual nos dois idiomas — aqui
    // não é: em pt-BR o canônico é o título traduzido, em en é o nome em inglês. O espelho
    // caía no 301 da rota de destino, e o Google descarta o par de idiomas inteiro por isso.
    //
    // O objeto é SEMPRE passado, mesmo vazio, de propósito: `null` no SEO.astro significa
    // "esta rota não informa" e cai no espelhamento (correto para hub/gênero/canal). Objeto
    // com os dois lados nulos significa "esta rota CONFirma que não sabe os dois slugs" — e aí
    // o alternate é omitido, que é o lado conservador. Sem essa distinção, conteúdo sem mapa
    // voltava silenciosamente ao espelhamento quebrado.
    const parDeSlugs = await obterParDeSlugs(id, "movie", Astro.url);
    if (parDeSlugs) {
        if (isPt) {
            alternates = {
                pt: `${siteUrl}/filme/${expectedSlug}`,
                en: parDeSlugs.en ? `${siteUrl}/en/filme/${id}-${parDeSlugs.en}` : null,
            };
        } else {
            // Aqui o idioma NÃO é o da rota: estamos montando o alternate do PT a partir de uma
            // página EN, então o slug que está sendo resolvido é o português — lang 'pt' fixo.
            const ptSlug = parDeSlugs.pt
                ? await resolveRotatedSlug(id, "movie", `${id}-${parDeSlugs.pt}`, 'pt')
                : null;
            alternates = {
                pt: ptSlug ? `${siteUrl}/filme/${ptSlug}` : null,
                en: `${siteUrl}/en/filme/${expectedSlug}`,
            };
        }
    }

    // Cast & Crew
    dadosMulti.cast = response.credits?.cast
        ? response.credits.cast.slice(0, 8)
        : [];
    dadosMulti.director =
        response.credits?.crew?.find((p) => p.job === "Director") || null;

    ano = dadosMulti.date ? dadosMulti.date.split("-")[0] : "N/A";

    backUrl = isPt ? "/" : "/en";
    if (fromSearch === "true") {
        const referer = Astro.request.headers.get("referer");
        if (referer) {
            const searchTerm = referer.split("q=")[1]?.split("&")[0];
            if (searchTerm) backUrl = "/results?q=" + searchTerm;
        }
    }

    const primaryGenre = response.genres?.[0] || null;
    const genreObj = primaryGenre ? getGenreByIdOrSlug(primaryGenre.id) : null;
    dadosMulti.genreSlug = genreObj
        ? genreObj.slug
        : slugify(primaryGenre?.name || "");
    dadosMulti.trailerKey = response?.trailer_key || null;
    dadosMulti.voteCount = response.vote_count || 1;
} catch (error) {
    console.error("Erro ao carregar dados do filme:", error);
    const logPromise = axiomService.logError(error, { rota: `/filme/${slug}` });
    if (Astro.locals.runtime?.waitUntil) {
        Astro.locals.runtime.waitUntil(logPromise);
    } else {
        logPromise.catch(() => {});
    }
    // Exceção ao montar os dados de um título que o TMDB retornou com sucesso é bug nosso,
    // não URL inexistente — 404 aqui desindexava a página por um erro de código passageiro.
    return upstreamUnavailableResponse(lang);
}

const anoSuffix = ano && ano !== "N/A" ? ` (${ano})` : "";
// Ordem escolhida pelas top-queries reais do Search Console: "X dublado", "X online
// gratis" e "X completo dublado" respondem por praticamente todo o clique.
// Para títulos longos (> 25 caracteres), suprimimos sufixos redundantes para não truncar no SERP.
const isNomeLongo = (dadosMulti.name || "").length > 25;
const pageTitle = isPt
    ? isNomeLongo
        ? `Assistir ${dadosMulti.name}${anoSuffix} Dublado Online Grátis - MultiCanaisHD`
        : `Assistir ${dadosMulti.name}${anoSuffix} Completo Dublado Online Grátis - Legendado em HD - MultiCanaisHD`
    : isNomeLongo
        ? `${t("meta.watch")} ${dadosMulti.name}${anoSuffix} Dubbed Online Free - MultiCanaisHD`
        : `${t("meta.watch")} ${dadosMulti.name}${anoSuffix} Full Movie Dubbed ${t("meta.online_free") || "Online Free"} - Subtitled in HD - MultiCanaisHD`;
const h1Title = dadosMulti.name;
const ctaPrefix = isPt
    ? `Assista ${dadosMulti.name} (${ano}) online grátis em HD! `
    : `Watch ${dadosMulti.name} (${ano}) online free in HD! `;
const pageDescription = dadosMulti.bio
    ? `${ctaPrefix}${dadosMulti.bio.substring(0, 150).replace(/\s+\S*$/, "")}...`
    : t("content.synopsis_fallback", { name: dadosMulti.name });

// Constante de propósito. O `supabase.auth.getSession()` que alimentava isto NUNCA devolvia
// sessão: no SSR do Worker o cliente público é criado sem storage nem cookie, então a sessão
// (que vive no localStorage do navegador) é invisível pro servidor — exatamente o que já
// estava documentado em redirect/[slug].astro, onde o mesmo código foi removido antes.
// Na prática `isVIP` já era false pra todo mundo, VIP incluso; o que saiu foi uma chamada de
// auth e uma consulta a `profiles` no caminho crítico de toda página, produzindo nada.
//
// Quem resolve o VIP de verdade é o cliente, via authStore (`data-user-vip` abaixo serve só
// de valor inicial). Manter isto como constante também garante que o HTML do SSR não varie
// por usuário — condição necessária pra este HTML poder ser cacheado.
const isVIP = false;
// Fica null de propósito: o plano depende do último pagamento (services/vipPlans.js) e o
// SSR não tem sessão pra buscá-lo. `data-user-plan` vazio faz o cliente cair no authStore,
// que já resolveu o plano — emitir um palpite aqui sobrescreveria o valor certo.
const vipPlan = null;

// Dados estruturados via @graph. Sem VideoObject, AggregateRating, FAQPage e dateModified
// dinâmico: vídeo, contagem e nota eram do TMDB (não nossos) e o FAQ é o mesmo em milhares
// de páginas — tudo isso é "structured data spam" pelas diretrizes do Google e arrisca ação
// manual que derruba os rich results do domínio inteiro.
const movieSchema = {
    "@type": "Movie",
    name: dadosMulti.name,
    image: dadosMulti.poster,
    description: pageDescription,
    datePublished: dadosMulti.date,
    genre: dadosMulti.genres,
    duration: `PT${dadosMulti.runtime}M`,
    director: dadosMulti.director
        ? { "@type": "Person", name: dadosMulti.director.name }
        : undefined,
    actor: dadosMulti.cast?.map((actor) => ({
        "@type": "Person",
        name: actor.name,
    })),
    potentialAction: {
        "@type": "WatchAction",
        target: {
            "@type": "EntryPoint",
            urlTemplate: `${siteUrl}${langPrefix}${Astro.url.pathname}`,
            actionPlatform: [
                "http://schema.org/DesktopWebPlatform",
                "http://schema.org/MobileWebPlatform",
            ],
        },
        actionAccessibilityRequirement: {
            "@type": "ActionAccessSpecification",
            category: "free",
            availabilityStarts: dadosMulti.date ? `${dadosMulti.date}T00:00:00Z` : undefined,
        },
    },
};

const keywords = isPt
    ? `${dadosMulti.name}, assistir ${dadosMulti.name} online, assistir ${dadosMulti.name} online gratis, assistir ${dadosMulti.name} dublado, assistir ${dadosMulti.name} legendado, ${dadosMulti.name} dublado online, assistir filme ${dadosMulti.name}, assistir ${dadosMulti.name} completo gratis, onde assistir ${dadosMulti.name}, ${dadosMulti.name} online hd`
    : `watch ${dadosMulti.name} online, watch ${dadosMulti.name} online free, watch ${dadosMulti.name} free stream, stream ${dadosMulti.name} online, ${dadosMulti.name} free online, where to watch ${dadosMulti.name} free, watch ${dadosMulti.name} hd stream`;

const breadcrumbSchema = {
    "@type": "BreadcrumbList",
    itemListElement: [
        {
            "@type": "ListItem",
            position: 1,
            name: t("nav.home"),
            item: siteUrl,
        },
        {
            "@type": "ListItem",
            position: 2,
            name: t("nav.movies"),
            item: `${siteUrl}${isPt ? "" : "/en"}/explorar?type=movie`,
        },
        {
            "@type": "ListItem",
            position: 3,
            name: dadosMulti.name,
            item: `${siteUrl}${langPrefix}${Astro.url.pathname}`,
        },
    ],
};

// A pergunta é "Onde assistir X?" porque é assim que a busca acontece; a resposta é o
// MultiCanaisHD, sem citar catálogo de terceiro (ver a nota em components/OndeAssistir.astro).
const respostaOndeAssistir = isPt
    ? `Você pode assistir ${dadosMulti.name} completo, dublado e legendado, online e grátis no MultiCanaisHD — basta clicar no botão "Assistir" acima e escolher entre as opções de servidor.`
    : `You can watch ${dadosMulti.name} in full, dubbed and subtitled, online and free on MultiCanaisHD — just click the "Watch" button above and choose between the server options.`;

const faqSchema = {
    "@type": "FAQPage",
    mainEntity: [
        {
            "@type": "Question",
            name: isPt
                ? `Onde assistir ${dadosMulti.name}?`
                : `Where to watch ${dadosMulti.name}?`,
            acceptedAnswer: {
                "@type": "Answer",
                text: respostaOndeAssistir,
            },
        },
        {
            "@type": "Question",
            name: isPt
                ? `${dadosMulti.name} está disponível dublado?`
                : `Is ${dadosMulti.name} available dubbed?`,
            acceptedAnswer: {
                "@type": "Answer",
                text: isPt
                    ? `Sim, ${dadosMulti.name} está disponível dublado em português e também com legendas no MultiCanaisHD. Você pode trocar de servidor a qualquer momento para encontrar a opção de áudio que preferir.`
                    : `Yes, ${dadosMulti.name} is available dubbed and with subtitles on MultiCanaisHD. You can switch servers at any time to find your preferred audio option.`,
            },
        },
        {
            "@type": "Question",
            name: isPt
                ? `É grátis assistir ${dadosMulti.name} no MultiCanaisHD?`
                : `Is it free to watch ${dadosMulti.name} on MultiCanaisHD?`,
            acceptedAnswer: {
                "@type": "Answer",
                text: isPt
                    ? `Sim, assistir ${dadosMulti.name} no MultiCanaisHD é totalmente grátis em qualidade HD. Também oferecemos um plano VIP opcional sem anúncios.`
                    : `Yes, watching ${dadosMulti.name} on MultiCanaisHD is completely free in HD quality. We also offer an optional ad-free VIP plan.`,
            },
        },
    ],
};

const relatedMovies = await Promise.all(
    (recommendationsResponse?.results || [])
        .filter((item) => item?.id && (item.title || item.name))
        .slice(0, 5)
        .map(async (item) => {
            const itemCanonicalSlug = slugDeDetalhes(item.id, item, lang);
            return {
                id: item.id,
                name: item.title || item.name,
                // slugify cru aqui gerava link interno divergente do canônico da página de destino —
                // ou seja, um 301 garantido por clique (e no JSON-LD, por rastreio). Mesma lógica
                // pra rotação Anti-DMCA: se a recomendação também foi rotacionada, o link já deve
                // sair apontando pro slug novo em vez de gerar outro 301 no clique. O idioma é o
                // da rota, porque itemCanonicalSlug também foi calculado com ele.
                slug: await resolveRotatedSlug(item.id, 'movie', itemCanonicalSlug, lang),
            };
        }),
);

const finalJsonLd = {
    "@context": "https://schema.org",
    "@graph": [movieSchema, breadcrumbSchema],
};

---

<BaseLayout
    title={pageTitle}
    description={pageDescription}
    image={dadosMulti.backdrop || dadosMulti.poster}
    preloadImageSet={dadosMulti.backdrop
        ? getDetailPreloadImageSet(response.backdrop_path, isMobileUA)
        : null}
    preloadImage={!response.backdrop_path && dadosMulti.poster
        ? dadosMulti.poster
        : null}
    preloadImageSizes="100vw"
    type="video.movie"
    keywords={keywords}
    jsonLd={finalJsonLd}
    alternates={alternates}
>
    <main
        class="container mx-auto px-4 py-8 xl:px-8 max-w-[1450px] mt-24 sm:mt-28"
    >
        <div
            id="slug-data-layer"
            hidden
            data-id={id}
            data-type={type}
            data-slug={slug}
            data-embed-url={embedUrl}
            data-embed-base={getShopUrl()}
            data-embed-key={getEmbedPublicKey()}
            data-genres={dadosMulti.genres}
            data-poster={dadosMulti.poster}
            data-title={dadosMulti.name}
            data-user-vip={isVIP ? "true" : "false"}
            data-user-plan={vipPlan || ""}
            data-imdb-id={dadosMulti.imdbId}
            data-backdrop={dadosMulti.backdrop}
            data-trailer-key={dadosMulti.trailerKey}
            data-lang={lang}
            data-t-watched={t("player.watched")}
            data-t-mark-movie-watched={t("player.mark_movie_watched")}
            data-t-movie-watched={t("player.movie_watched")}
        >
        </div>

        <div class="flex items-center gap-2 mb-6">
            <a
                href={backUrl}
                class="p-2 bg-white/5 hover:bg-[#DF0912] rounded-full transition-all group"
            >
                <svg
                    class="w-5 h-5 text-gray-400 group-hover:text-white"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                    ><path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M15 19l-7-7 7-7"></path></svg
                >
            </a>
            <div class="h-4 w-px bg-white/10 mx-1"></div>
            <div
                class="flex items-center gap-2 text-xs font-black uppercase tracking-tighter text-gray-500"
            >
                <a href={backUrl} class="hover:text-white transition-colors"
                    >{t("nav.home")}</a
                >
                <span>/</span>
                <span class="text-white truncate max-w-[150px] sm:max-w-none"
                    >{dadosMulti.name}</span
                >
            </div>
