        />
    </main>

    <script>
        import { authStore, updateCloudStats } from "../../store/authStore";
        import { favoritesStore } from "../../store/favoritesStore";
        import { showToast } from "../../store/toastStore";

        window.BetterPlayer = {
            state: {
                initialized: false,
                contentId: null,
                contentType: "movie",
                lang: "pt",
            },
            isVip() {
                const dl = document.getElementById("slug-data-layer");
                let storeVip = false;
                try {
                    if (typeof authStore !== "undefined") {
                        storeVip = authStore.get()?.isVIP || false;
                    }
                } catch (e) {}
                // Mesma regra do BaseLayout: a sessão otimista do localStorage também
                // conta. Sem ela, enquanto o check real não confirma (ou quando falha, ex:
                // rede ruim/VPN), o site mostrava "VIP" mas o player montava a URL do
                // embed SEM a chave — e o VIP via anúncio.
                let optimisticVip = false;
                try {
                    const raw = localStorage.getItem("bf_session_optimistic");
                    const session = raw && raw !== "undefined" ? JSON.parse(raw) : null;
                    optimisticVip =
                        session?.isVIP === true &&
                        (!session.vipUntil || new Date(session.vipUntil) > new Date());
                } catch (e) {}
                return dl?.dataset.userVip === "true" || storeVip || optimisticVip;
            },
            init() {
                try {
                    const dl = document.getElementById("slug-data-layer");
                    if (!dl) return;
                    this.state.contentId = dl.dataset.id;
                    this.state.lang = dl.dataset.lang || "pt";

                    // Navegação SPA reaproveita este objeto: zera o progresso do conteúdo
                    // anterior pra ele não vazar como `start` ou como posição salva deste.
                    this._endedHandled = false;
                    this._vipWaitStart = 0;
                    clearTimeout(this._vipWaitTimer);
                    this._progress = {
                        currentTime: 0,
                        duration: 0,
                        lastPersist: 0,
                        dirty: false,
                    };

                    // Robust VIP check with fallback (Pilar 2)
                    let userVip = false;
                    try {
                        userVip = this.isVip();
                    } catch (e) {
                        console.error(
                            "[BetterPlayer] Error checking VIP status:",
                            e,
                        );
                        userVip = dl.dataset.userVip === "true";
                    }

                    if (userVip) {
                        try {
                            document
                                .getElementById("noAdsBtn")
                                ?.classList.add("hidden");
                        } catch (e) {}
                    }

                    try {
                        this.setupEvents();
                    } catch (e) {
                        console.error(
                            "[BetterPlayer] Error setting up events:",
                            e,
                        );
                    }

                    try {
                        this.updateVIPUI();
                    } catch (e) {
                        console.error(
                            "[BetterPlayer] Error updating VIP UI:",
                            e,
                        );
                    }

                    try {
                        this.updateWatchedUI();
                    } catch (e) {
                        console.error(
                            "[BetterPlayer] Error updating watched UI:",
                            e,
                        );
                    }

                    try {
                        let favs = [];
                        try {
                            favs = favoritesStore?.get() || [];
                        } catch (err) {
                            console.error(
                                "[BetterPlayer] Error getting favoritesStore:",
                                err,
                            );
                        }
                        this.updateFavoriteUI(favs);
                    } catch (e) {
                        console.error(
                            "[BetterPlayer] Error updating favorite UI:",
                            e,
                        );
                    }

                    try {
                        this.updatePlayer();
                    } catch (e) {
                        console.error(
                            "[BetterPlayer] Error updating player:",
                            e,
                        );
                    }

                    try {
                        this.startHeartbeat();
                    } catch (e) {
                        console.error(
                            "[BetterPlayer] Error starting heartbeat:",
                            e,
                        );
                    }

                    this.state.initialized = true;
                } catch (e) {
                    console.error(
                        "[BetterPlayer] Critical error during init():",
                        e,
                    );
                }
            },
            setupEvents() {
                const els = {
                    fav: document.getElementById("favBtn"),
                    mark: document.getElementById("markMovieWatchedBtn"),
                    trailer: document.getElementById("trailerBtn"),
                    share: document.getElementById("shareBtn"),
                    download: document.getElementById("downloadBtn"),
                    embed: document.getElementById("embedBtn"),
                    cinema: document.getElementById("cinemaModeBtn"),
                };

                if (els.fav) els.fav.onclick = () => this.toggleFavorite();
                if (els.mark)
                    els.mark.onclick = () => this.toggleMovieWatched();
                if (els.trailer)
                    els.trailer.onclick = (e) => {
                        const key = e.currentTarget.dataset.key;
                        if (key)
                            document.dispatchEvent(
                                new CustomEvent("multicanaishd:open-trailer", {
                                    detail: { key },
                                }),
                            );
                    };
                if (els.share) els.share.onclick = () => this.share();
                if (els.download) els.download.onclick = () => this.download();
                if (els.embed) els.embed.onclick = () => this.openEmbed();
                if (els.cinema)
                    els.cinema.onclick = () => this.toggleCinemaMode();

                // Tela Cheia Customizada
                const fsBtn = document.getElementById("customFullscreenBtn");
                const wrapper = document.getElementById("playerWrapper");

                if (fsBtn && wrapper) {
                    fsBtn.addEventListener("click", () => {
                        try {
                            if (!document.fullscreenElement) {
                                if (wrapper.requestFullscreen) {
                                    wrapper.requestFullscreen();
                                } else if (wrapper.webkitRequestFullscreen) {
                                    wrapper.webkitRequestFullscreen();
                                } else if (wrapper.msRequestFullscreen) {
                                    wrapper.msRequestFullscreen();
                                }
                            } else {
                                if (document.exitFullscreen) {
                                    document.exitFullscreen();
                                }
                            }
                        } catch (err) {
                            console.error("Erro ao alternar tela cheia:", err);
                        }
                    });

                    document.addEventListener("fullscreenchange", () => {
                        const enterIcon =
                            document.getElementById("fs-icon-enter");
                        const exitIcon =
                            document.getElementById("fs-icon-exit");
                        if (document.fullscreenElement) {
                            enterIcon?.classList.add("hidden");
                            exitIcon?.classList.remove("hidden");
                            wrapper.classList.remove("rounded-xl");
                        } else {
                            enterIcon?.classList.remove("hidden");
                            exitIcon?.classList.add("hidden");
                            wrapper.classList.add("rounded-xl");
                        }
                    });
                }

                // Handled via page-level Event Delegation for robustness (Astro ViewTransitions compatibility)
            },
            async share() {
                const dl = document.getElementById("slug-data-layer");
                const title = dl?.dataset.title || "MultiCanaisHD";
                if (navigator.share) {
                    try {
                        await navigator.share({
                            title,
                            text: `Assista ${title} online em HD no MultiCanaisHD!`,
                            url: window.location.href,
                        });
                    } catch (e) {}
                } else {
                    navigator.clipboard.writeText(window.location.href);
                    showToast("Link copiado!", "success");
                }
            },
            download() {
                const dl = document.getElementById("slug-data-layer");
                const imdbId = dl?.dataset.imdbId;
                const title = dl?.dataset.title || "MultiCanaisHD";
                if (!imdbId) {
                    showToast(
                        "ID do IMDb não disponível para este filme.",
                        "error",
                    );
                    return;
                }
                document.dispatchEvent(
                    new CustomEvent("multicanaishd:open-torrent", {
                        detail: {
                            id: this.state.contentId,
                            tmdbId: this.state.contentId,
                            imdbId,
                            title,
                            type: "movie",
                        },
                    }),
                );
            },
            openEmbed() {
                window.open("https://streambetter.lol", "_blank", "noopener");
            },
            toggleCinemaMode() {
                const wrapper = document.getElementById("player-main-grid");
                const header = document.getElementById("main-header");
                if (!wrapper) return;
                const isCinema = wrapper.classList.toggle("cinema-mode");

                if (isCinema) {
                    header?.classList.add("opacity-0", "pointer-events-none");
                    wrapper.scrollIntoView({
                        behavior: "smooth",
                        block: "start",
                    });
                    document.body.style.overflow = "hidden"; // Trava scroll para focar no player
                    showToast("Modo Cinema Ativado", "info");
                } else {
                    header?.classList.remove(
                        "opacity-0",
                        "pointer-events-none",
                    );
                    document.body.style.overflow = "";
                    showToast("Modo Cinema Desativado", "info");
                }
            },
            // Monta a URL do iframe na hora, do zero: inclui a chave pública (StreamBetter
            // some com o anúncio dela) só se o viewer atual for VIP. Como o SSR nunca sabe o
            // VIP real (HTML precisa ser cacheável, ver comentário acima de `embedUrl`), essa
            // decisão só pode ser tomada aqui, no cliente.
            buildPlayerUrl() {
                const dl = document.getElementById("slug-data-layer");
                const base = dl?.dataset.embedBase || "";
                const id = dl?.dataset.id || this.state.contentId;
                if (!base || !id) return dl?.dataset.embedUrl || "";
                const params = new URLSearchParams();
                const key = dl?.dataset.embedKey || "";
                if (this.isVip() && key) params.set("key", key);

                const start = this.currentStartSeconds();
                if (start > 0) params.set("start", String(start));

                return `${base}/filme/${id}?${params.toString()}`;
            },
            // Segundo em que o player deve começar. A posição viva desta sessão tem prioridade
            // sobre a salva: se o iframe recarregar no meio (ex: o check de VIP terminou e a URL
            // ganhou/perdeu a chave), a pessoa volta pra onde estava, não pro ponto inicial.
            currentStartSeconds() {
                const live = Number(this._progress?.currentTime) || 0;
                if (live > 30) return Math.round(live);
                return this.readSavedStart();
            },
            readSavedStart() {
                try {
                    const item = (authStore.get()?.history || []).find(
                        (i) => i?.id == this.state.contentId,
                    );
                    const resume = Number(item?.resume_seconds) || 0;
                    const duration = Number(item?.duration_seconds) || 0;
                    // Abaixo de 30s não vale retomar (é praticamente o começo), e a menos de
                    // 1 min do fim retomar é pior que recomeçar — cai direto nos créditos.
                    if (resume > 30 && (!duration || resume < duration - 60)) {
                        return Math.round(resume);
                    }
                } catch (e) {}
                return 0;
            },
            // Compara duas URLs de embed ignorando `start`. Esse parâmetro muda conforme a
            // reprodução avança, e se entrasse na comparação o iframe se recarregaria sozinho
            // a cada atualização de progresso (updateVIPUI roda a cada mudança do authStore).
            sameEmbedTarget(a, b) {
                const norm = (u) => {
                    try {
                        const url = new URL(u, window.location.origin);
                        url.searchParams.delete("start");
                        return url.toString();
                    } catch (e) {
                        return u || "";
                    }
                };
                return norm(a) === norm(b);
            },
            // true enquanto não dá pra saber se o viewer é VIP: snapshot não diz VIP e o
            // authStore ainda não confirmou. Teto de 5s pra um auth pendurado não travar o player.
            waitingVipCheck() {
                if (this.isVip()) return false;
                let initialized = true;
                try {
                    initialized = authStore.get()?.initialized !== false;
                } catch (e) {}
                if (initialized) return false;
                if (!this._vipWaitStart) this._vipWaitStart = Date.now();
                if (Date.now() - this._vipWaitStart >= 5000) return false;
                clearTimeout(this._vipWaitTimer);
                this._vipWaitTimer = setTimeout(() => this.updatePlayer(), 5100 - (Date.now() - this._vipWaitStart));
                return true;
            },
            updatePlayer() {
                const pf = document.getElementById("playerFrame");
                if (!pf) return;

                // Se o snapshot otimista já diz VIP, carrega com chave na hora. Se não diz, só
                // carrega depois do check real: trocar a URL pra "com chave" depois não adianta,
                // o anúncio da StreamBetter já disparou nos primeiros segundos sem chave (VIP
                // via anúncio na 1ª carga e não no reload). updateVIPUI() chama isto de novo
                // quando o authStore inicializa.
                if (this.waitingVipCheck()) return;
                const embedUrl = this.buildPlayerUrl();
                if (embedUrl && !this.sameEmbedTarget(pf.src, embedUrl)) {
                    pf.src = embedUrl;
                    this.saveHistory();
                }
            },
            updateFavoriteUI(favorites) {
                const btn = document.getElementById("favBtn");
                const dl = document.getElementById("slug-data-layer");
                let user = null;
                try {
                    if (typeof authStore !== "undefined") {
                        user = authStore.get()?.user;
                    }
                } catch (e) {}
                if (!user || !btn) {
                    btn?.classList.add("hidden");
                    btn?.classList.remove("flex");
                    return;
                }
                btn.classList.remove("hidden");
                btn.classList.add("flex");
                const isFav =
                    Array.isArray(favorites) &&
                    favorites.some((f) => f.id == this.state.contentId);
                btn.className = isFav
                    ? "flex items-center gap-1.5 px-3 py-2 rounded-lg bg-[#DF0912] text-white text-xs font-bold transition-all shadow-lg shadow-red-900/20"
                    : "flex items-center gap-1.5 px-3 py-2 rounded-lg bg-[#1D2437] hover:bg-[#333] text-gray-300 text-xs font-bold transition-all border border-white/5";
                document
                    .getElementById("favIcon")
                    ?.setAttribute("fill", isFav ? "currentColor" : "none");
                const text = document.getElementById("favText");
                if (text)
                    text.textContent = isFav
                        ? dl?.dataset.tSaved || "Salvo"
                        : dl?.dataset.tWatchlist || "Minha Lista";
            },
            updateWatchedUI() {
                const state = authStore.get();
                const btn = document.getElementById("markMovieWatchedBtn");
                const dl = document.getElementById("slug-data-layer");
                if (!state.user || !btn) {
                    btn?.classList.add("hidden");
                    btn?.classList.remove("flex");
                    return;
                }
                btn.classList.remove("hidden");
                btn.classList.add("flex");
                const isWatched = (state.watchedMovies || []).includes(
                    String(this.state.contentId),
                );
                btn.className = isWatched
                    ? "flex items-center gap-1.5 px-3 py-2 rounded-lg bg-green-500 text-white text-xs font-bold transition-all shadow-lg shadow-green-900/20"
                    : "flex items-center gap-1.5 px-3 py-2 rounded-lg bg-[#1D2437] hover:bg-[#333] text-gray-300 text-xs font-bold transition-all border border-white/5";
                const text = document.getElementById("movieWatchedText");
                if (text)
                    text.textContent = isWatched
                        ? dl?.dataset.tMovieWatched || "Visto"
                        : dl?.dataset.tMarkMovieWatched || "Marcar Visto";
            },
            updateVIPUI() {
                const isVip = this.isVip();
                const noAdsBtn = document.getElementById("noAdsBtn");
                if (isVip) {
                    noAdsBtn?.classList.add("hidden");
                    const vipBtn = document.getElementById("vipBtn");
                    if (vipBtn) {
                        const badge = document.createElement("span");
                        badge.className =
                            "flex items-center gap-2 px-4 py-2 text-xs font-black rounded-lg border bg-indigo-500/10 text-indigo-400 border-indigo-500/30";
                        badge.innerHTML = "VIP Ativo 💎";
                        vipBtn.parentNode?.replaceChild(badge, vipBtn);
                    }
                } else {
                    noAdsBtn?.classList.remove("hidden");
                }
                // updatePlayer() só troca o pf.src se a URL (com/sem chave) realmente mudou —
                // seguro chamar toda vez que o VIP resolve/muda (inclusive antes do primeiro
                // load, quando authStore ainda não confirmou e updatePlayer mostra o loading).
                this.updatePlayer();
            },
            toggleFavorite() {
                const dl = document.getElementById("slug-data-layer");
                const state = authStore.get();
                if (!state.user || !dl) return;
                const favs = favoritesStore.get() || [];
                const isFav = favs.some((f) => f.id == this.state.contentId);
                const newList = isFav
                    ? favs.filter((f) => f.id != this.state.contentId)
                    : [
                          {
                              id: this.state.contentId,
                              title: dl.dataset.title,
                              poster: dl.dataset.poster,
                              backdrop: dl.dataset.backdrop,
                              type: "movie",
                              slug: dl.dataset.slug,
                              timestamp: Date.now(),
                          },
                          ...favs,
                      ];
                favoritesStore.set(newList);
                updateCloudStats({ favorites: newList });
                showToast(
                    isFav ? "Removido" : "Adicionado!",
                    isFav ? "error" : "success",
                );
            },
            async toggleMovieWatched() {
                const state = authStore.get();
                if (!state.user) return;
                const watched = state.watchedMovies || [];
                const isWatched = watched.includes(
                    String(this.state.contentId),
                );
                const newList = isWatched
                    ? watched.filter((id) => id != this.state.contentId)
                    : [String(this.state.contentId), ...watched];
                await updateCloudStats({ watchedMovies: newList });
                this.updateWatchedUI();
                showToast(
                    isWatched ? "Removido" : "Assistido!",
                    isWatched ? "error" : "success",
                );
            },
            saveHistory() {
                const dl = document.getElementById("slug-data-layer");
                const state = authStore.get();
                if (!state.user || !dl) return;
                const history = state.history ? [...state.history] : [];
                const idx = history.findIndex(
                    (i) => i?.id == this.state.contentId,
                );
                const existingItem = idx > -1 ? history[idx] : null;
                const item = {
                    ...(existingItem || {}),
                    id: this.state.contentId,
                    title: dl.dataset.title,
                    poster: dl.dataset.poster,
                    backdrop: dl.dataset.backdrop,
                    type: "movie",
                    slug: dl.dataset.slug,
                    url: window.location.pathname,
                    timestamp: Date.now(),
                    genreName: dl.dataset.genres?.split(",")[0]?.trim() || "",
                    resume_seconds: existingItem?.resume_seconds || 0,
                    duration_seconds: existingItem?.duration_seconds || 0,
                    watched_seconds: existingItem?.watched_seconds || 0,
                };
                if (idx > -1) history.splice(idx, 1);
                history.unshift(item);
                updateCloudStats({ history: history.slice(0, 50) });
            },
            // Progresso vindo do iframe da StreamBetter (postMessage `streambetter:progress`,
            // ~15s + nos eventos de play/pause/seek/end). É a ÚNICA fonte de posição que temos:
            // o embed não aceita comando de volta, então isso serve pra exibir onde parou —
            // não dá pra mandar o player retomar sozinho.
            _progress: { currentTime: 0, duration: 0, lastPersist: 0, dirty: false },
            onPlayerProgress(data) {
                // `tmdbId` vem no payload: confirma que o progresso é deste filme. Sem isso,
                // um player remanescente de outra página (navegação SPA) gravaria posição no
                // conteúdo errado.
                if (
                    data?.tmdbId != null &&
                    String(data.tmdbId) !== String(this.state.contentId)
                ) {
                    return;
                }

                if (data?.state === "ended") {
                    this.handlePlaybackEnded();
                    return;
                }

                const currentTime = Number(data?.currentTime);
                const duration = Number(data?.duration);
                // duration só é confiável depois que o player leu os metadados; até lá vem 0/NaN.
                if (
                    !Number.isFinite(currentTime) ||
                    !Number.isFinite(duration) ||
                    duration <= 0 ||
                    currentTime < 0
                ) {
                    return;
                }

                this._progress.currentTime = currentTime;
                this._progress.duration = duration;
                this._progress.dirty = true;

                // Grava no máximo a cada 30s: o evento chega a cada ~15s e updateCloudStats
                // escreve o histórico inteiro no Supabase a cada chamada.
                if (Date.now() - this._progress.lastPersist >= 30000) {
                    this.persistProgress();
                }
            },
            persistProgress() {
                if (!this._progress?.dirty) return;
                const state = authStore.get();
                if (!state.user) return;
                const history = state.history ? [...state.history] : [];
                const idx = history.findIndex(
                    (i) => i?.id == this.state.contentId,
                );
                // Sem entrada no histórico ainda (saveHistory não rodou): nada a atualizar.
                if (idx === -1) return;

                history[idx] = {
                    ...history[idx],
                    resume_seconds: Math.round(this._progress.currentTime),
                    duration_seconds: Math.round(this._progress.duration),
                };
                this._progress.dirty = false;
                this._progress.lastPersist = Date.now();
                // `timestamp` fica como está de propósito: o card não precisa pular pro topo
                // do "Continuar assistindo" a cada 30s de reprodução.
                updateCloudStats({ history });
            },
            // `state: 'ended'` do player. Antes disso só dava pra inferir pelo currentTime perto
            // da duration, o que errava com quem pula os créditos ou pausa no fim.
            async handlePlaybackEnded() {
                if (this._endedHandled) return;
                this._endedHandled = true;

                // Zera a posição salva: sem isso o card ficaria travado em "1min restantes"
                // pra sempre, e reabrir o filme cairia direto nos créditos via `start`.
                this._progress = {
                    currentTime: 0,
                    duration: 0,
                    lastPersist: 0,
                    dirty: false,
                };

                const state = authStore.get();
                if (!state.user) return;

                const history = (state.history || []).map((i) =>
                    i?.id == this.state.contentId
                        ? { ...i, resume_seconds: 0, duration_seconds: 0 }
                        : i,
                );

                // Marcação automática: só ADICIONA. Nunca desmarca, senão reassistir um filme
                // já visto o tiraria da lista de assistidos ao terminar.
                const watched = state.watchedMovies || [];
                const jaMarcado = watched.includes(String(this.state.contentId));

                await updateCloudStats({
                    history,
                    ...(jaMarcado
                        ? {}
                        : {
                              watchedMovies: [
                                  String(this.state.contentId),
                                  ...watched,
                              ],
                          }),
                });
                this.updateWatchedUI();
            },
            startHeartbeat() {
                if (this._heartbeatInterval) {
                    clearInterval(this._heartbeatInterval);
                }

                this._lastInteraction = Date.now();
                this._isStillWatchingWaiting = false;

                const activityEvents = [
                    "mousemove",
                    "click",
                    "keypress",
                    "touchstart",
                    "scroll",
                ];
                const handleActivity = () => {
                    if (!this._isStillWatchingWaiting) {
                        this._lastInteraction = Date.now();
                    }
                };

                activityEvents.forEach((evt) =>
                    document.addEventListener(evt, handleActivity),
                );

                const handleResume = () => {
                    this._lastInteraction = Date.now();
                    this._isStillWatchingWaiting = false;
                    this.sendPing();
                };
                document.addEventListener(
                    "multicanaishd:still-watching-resume",
                    handleResume,
                );

                this._cleanupHeartbeat = () => {
                    activityEvents.forEach((evt) =>
                        document.removeEventListener(evt, handleActivity),
                    );
                    document.removeEventListener(
                        "multicanaishd:still-watching-resume",
                        handleResume,
                    );
                    if (this._heartbeatInterval)
                        clearInterval(this._heartbeatInterval);
                };

                this._heartbeatInterval = setInterval(() => {
                    const state = authStore.get();
                    if (!state.user) return;
                    if (document.visibilityState !== "visible") return;

                    const idleTime = Date.now() - this._lastInteraction;
                    const THREE_HOURS = 3 * 3600 * 1000;

                    if (idleTime > THREE_HOURS) {
                        if (!this._isStillWatchingWaiting) {
                            this._isStillWatchingWaiting = true;
                            document.dispatchEvent(
                                new CustomEvent("multicanaishd:still-watching"),
                            );
                        }
                        return;
                    }

                    this.sendPing();
                }, 60000);
            },
            async sendPing() {
                const { token, user } = authStore.get();
                if (!token || !user) return;

                try {
                    const res = await fetch("/api/watch/heartbeat", {
                        method: "POST",
                        headers: {
                            Authorization: `Bearer ${token}`,
                            "Content-Type": "application/json",
                        },
                        body: JSON.stringify({
                            mediaId: this.state.contentId,
                            type: this.state.contentType,
                        }),
                    });
                    const data = await res.json();
                    if (data.success) {
                        console.log(
                            `%c💓 [Heartbeat] Ping enviado. Segundos ativos: ${data.activeSeconds}`,
                            "color: #df0912; font-weight: bold;",
                        );

                        const current = authStore.get();
                        let updatedHistory = current.history
                            ? [...current.history]
                            : [];
                        const itemIdx = updatedHistory.findIndex(
                            (i) => i.id == this.state.contentId,
                        );

                        if (itemIdx > -1) {
                            const item = { ...updatedHistory[itemIdx] };
                            item.watched_seconds =
                                (item.watched_seconds || 0) + 60;
                            item.timestamp = Date.now();
                            updatedHistory[itemIdx] = item;

                            authStore.set({
                                ...current,
                                activeSeconds: data.activeSeconds,
                                history: updatedHistory,
                            });
                            updateCloudStats({ history: updatedHistory });
                        } else {
                            this.saveHistory();
                            const reCurrent = authStore.get();
                            let reHistory = reCurrent.history
                                ? [...reCurrent.history]
                                : [];
                            const reIdx = reHistory.findIndex(
                                (i) => i.id == this.state.contentId,
                            );
                            if (reIdx > -1) {
                                const item = { ...reHistory[reIdx] };
                                item.watched_seconds = 60;
                                reHistory[reIdx] = item;

                                authStore.set({
                                    ...reCurrent,
                                    activeSeconds: data.activeSeconds,
                                    history: reHistory,
                                });
                                updateCloudStats({ history: reHistory });
                            }
                        }
                    }
                } catch (e) {
                    console.error(
                        "❌ [Heartbeat] Falha ao enviar batida:",
                        e.message,
                    );
                }
            },
        };

        // Inscrições globais únicas (evita double toast e garante reatividade)
        if (!window._BetterPlayerSubscribed) {
            authStore.subscribe(() => {
                if (window.BetterPlayer?.state?.initialized) {
                    window.BetterPlayer.updateWatchedUI();
                    window.BetterPlayer.updateVIPUI?.();
                }
            });
            favoritesStore.subscribe((favs) => {
                if (window.BetterPlayer?.state?.initialized) {
                    window.BetterPlayer.updateFavoriteUI?.(favs);
                }
            });

            // Progresso do player da StreamBetter. O listener é registrado uma vez só e
            // delega pro window.BetterPlayer da página atual (filme ou série) — o mesmo
            // padrão das assinaturas acima, necessário porque o ViewTransitions troca o
            // objeto BetterPlayer a cada navegação SPA sem recarregar este módulo.
            window.addEventListener("message", (event) => {
                if (event.data?.type !== "streambetter:progress") return;

                // A doc manda filtrar por `type` porque o embed publica com targetOrigin '*'.
                // Só isso não basta aqui: a página roda scripts de anúncio de terceiros em
                // iframes, e qualquer um deles poderia forjar esse evento e envenenar o
                // histórico. Conferimos a origem contra a base do embed que nós mesmos montamos.
                const embedBase =
                    document.getElementById("slug-data-layer")?.dataset
                        .embedBase;
                if (embedBase) {
                    let expectedOrigin = "";
                    try {
                        expectedOrigin = new URL(embedBase).origin;
                    } catch (e) {}
                    if (expectedOrigin && event.origin !== expectedOrigin) {
                        console.warn(
                            `[BetterPlayer] Progresso ignorado: origem ${event.origin} não confere com ${expectedOrigin}.`,
                        );
                        return;
                    }
                }

                if (!window.BetterPlayer?.state?.initialized) return;
                window.BetterPlayer.onPlayerProgress?.(event.data);
            });

            // Fecha a aba / minimiza no celular: grava o que ainda não passou pelo throttle.
            window.addEventListener("pagehide", () => {
                window.BetterPlayer?.persistProgress?.();
            });

            window._BetterPlayerSubscribed = true;
        }

        document.addEventListener("astro:page-load", () =>
            window.BetterPlayer.init(),
        );
        document.addEventListener("astro:before-preparation", () => {
            if (window.BetterPlayer) {
                // Navegação SPA pra outra página: descarrega o progresso pendente antes de
                // perder o contexto do conteúdo atual.
                window.BetterPlayer.persistProgress?.();
                window.BetterPlayer.state.initialized = false;
                if (
                    typeof window.BetterPlayer._cleanupHeartbeat === "function"
                ) {
                    window.BetterPlayer._cleanupHeartbeat();
                }
            }
        });

    </script>

    <TrailerModal />
    <TorrentModal />
</BaseLayout>

