const keywords = isPt
    ? "changelog multicanaishd, atualizações multicanaishd, novidades multicanaishd, versoes multicanaishd, o que mudou multicanaishd, notas de lançamento"
    : "multicanaishd changelog, multicanaishd updates, multicanaishd release notes, what is new multicanaishd, multicanaishd versions";

const changelogSchema = {
    "@context": "https://schema.org",
    "@type": "SoftwareApplication",
    "name": "MultiCanaisHD",
    "operatingSystem": "All",
    "applicationCategory": "EntertainmentApplication",
    "softwareVersion": LATEST_VERSION,
    "releaseNotes": `${siteUrl}${Astro.url.pathname}`,
    "offers": {
        "@type": "Offer",
        "price": "0.00",
        "priceCurrency": "USD"
    }
};
---

<BaseLayout
    title={t('changelog.title')}
    description={t('changelog.desc')}
    keywords={keywords}
    jsonLd={changelogSchema}
>
    <main class="flex-grow container mx-auto px-4 py-12 mt-24 sm:mt-32 max-w-3xl">
            <div class="mb-12">
                <h2 class="text-3xl md:text-4xl font-black text-white mb-2">
                    {t('changelog.header')}
                </h2>
                <p class="text-gray-400 text-sm">
                    {t('changelog.subtitle')}
                </p>
            </div>

            <div class="space-y-6" id="changelog-list">
                {
                    versoes.map((v, index) => (
                        <article
                            class={`changelog-item bg-[#161B28] border border-white/5 rounded-xl p-6 transition-all duration-300 hover:border-[#DF0912]/30 ${index >= ITEMS_PER_PAGE ? "hidden" : ""}`}
                        >
                            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-4 border-b border-white/5 pb-4">
                                <div>
                                    <div class="flex items-center gap-3">
                                        <h3 class="text-xl font-bold text-white">
                                            v{v.versao}
                                        </h3>
                                        {index === 0 && (
                                            <span class="px-2 py-0.5 rounded bg-[#DF0912] text-white text-[10px] font-bold uppercase tracking-wider">
                                                {t('changelog.current_badge')}
                                            </span>
                                        )}
                                    </div>
                                    <span class="text-sm text-gray-500 font-mono">
                                        {v.data}
                                    </span>
                                </div>
                                {v.titulo && (
                                    <div class="sm:text-right">
                                        <h4 class="text-gray-300 font-bold text-sm">
                                            {v.titulo}
                                        </h4>
                                    </div>
                                )}
                            </div>

                            {v.desc && (
                                <p class="text-gray-400 text-sm mb-6 leading-relaxed">
                                    {v.desc}
                                </p>
                            )}

                            <ul class="space-y-2">
                                {v.mudancas.map((m) => {
                                    let badgeColor =
                                        "bg-gray-700 text-gray-300"; // default
                                    if (m.cor === "green")
                                        badgeColor =
                                            "bg-green-500/10 text-green-400 border border-green-500/20";
                                    if (m.cor === "blue")
                                        badgeColor =
                                            "bg-blue-500/10 text-blue-400 border border-blue-500/20";
                                    if (m.cor === "orange")
                                        badgeColor =
                                            "bg-orange-500/10 text-orange-400 border border-orange-500/20";

                                    return (
                                        <li class="flex items-start gap-3 text-sm">
                                            <span
                                                class={`flex-shrink-0 px-2 py-0.5 rounded text-[10px] font-bold uppercase tracking-wide mt-0.5 ${badgeColor}`}
                                            >
                                                {m.tag}
                                            </span>
                                            <span class="text-gray-300 leading-snug">
                                                {m.texto}
                                            </span>
                                        </li>
                                    );
                                })}
                            </ul>
                        </article>
                    ))
                }
            </div>

            {
                versoes.length > ITEMS_PER_PAGE && (
                    <div class="mt-8 text-center">
                        <button
                            id="loadMoreBtn"
                            class="px-6 py-3 bg-[#161B28] hover:bg-[#DF0912] text-gray-300 hover:text-white font-bold rounded-lg border border-white/5 hover:border-[#DF0912] transition-all duration-300 shadow-lg hover:shadow-red-900/20 text-sm"
                        >
                            {t('changelog.load_more')}
                        </button>
                    </div>
                )
            }
        </main>


        <script>
            // @ts-nocheck
            document.addEventListener("astro:page-load", () => {
                const loadMoreBtn = document.getElementById("loadMoreBtn");
                const hiddenItems = document.querySelectorAll(
                    ".changelog-item.hidden",
                );
                let currentIndex = 0;
                const itemsPerLoad = 3;

                if (loadMoreBtn) {
                    loadMoreBtn.addEventListener("click", () => {
                        let revealedCount = 0;

                        // Revela os próximos itens ocultos
                        for (let i = 0; i < hiddenItems.length; i++) {
                            const item = hiddenItems[i];
                            if (item.classList.contains("hidden")) {
                                item.classList.remove("hidden");
                                // Pequena animação de entrada
                                item.style.opacity = "0";
                                item.style.transform = "translateY(10px)";
                                setTimeout(() => {
                                    item.style.transition = "all 0.3s ease";
                                    item.style.opacity = "1";
                                    item.style.transform = "translateY(0)";
                                }, 50);

                                revealedCount++;
                                if (revealedCount >= itemsPerLoad) break;
                            }
                        }

                        // Verifica se ainda tem itens ocultos
                        const remainingHidden = document.querySelectorAll(
                            ".changelog-item.hidden",
                        ).length;
                        if (remainingHidden === 0) {
                            loadMoreBtn.style.display = "none";
                        }
                    });
                }
            });
        </script>
    </BaseLayout>

<style>
    @reference 'tailwindcss';
    ::-webkit-scrollbar {
        width: 8px;
    }
    ::-webkit-scrollbar-track {
        background: #0E111A;
    }
    ::-webkit-scrollbar-thumb {
        background: #333;
        border-radius: 4px;
    }
    ::-webkit-scrollbar-thumb:hover {
        background: #df0912;
    }
</style>
