---
// @ts-nocheck
export const prerender = false;
import BaseLayout from "../layouts/BaseLayout.astro";
import { fetchTrending } from "../services/trendingService";
// i18n
import { getLangFromUrl, useTranslations } from "../i18n/utils";
import { contentSlug } from "../utils/slugify.js";
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const isPt = lang === "pt";
const langPrefix = isPt ? "" : `/${lang}`;

// .catch() obrigatório (§2.2 do code.md): sem ele, uma falha do trending lança dentro do
// frontmatter e o safety net do middleware (middleware.js:282-295) transforma TODA página
// 404 do site numa resposta 200 "Erro Interno" com noindex. O Google para de remover as URLs
// mortas do índice justamente quando mais precisa removê-las.
const trending = await fetchTrending("all", "week", lang).catch(() => []);
const discoveryItems = trending.slice(0, 6);

---

<BaseLayout
    title={t('404.title')}
    description={t('404.desc')}
    robots="noindex, follow"
    bodyClass="antialiased selection:bg-[#DF0912]/30"
>

        <!-- Main Content (Centered) -->
        <main class="flex-grow relative flex flex-col items-center justify-center text-center px-4 py-20 overflow-hidden">
            
            <!-- Animated Gradient Background -->
            <div class="absolute inset-0 z-0 pointer-events-none overflow-hidden">
                <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[60vw] h-[60vw] bg-[#DF0912] rounded-full blur-[180px] opacity-10 animate-pulse"></div>
            </div>

            <div class="relative z-10 flex flex-col items-center justify-center max-w-2xl mx-auto space-y-8">
                
                <!-- Large Glitch Number -->
                <div class="relative">
                    <span class="text-[12rem] md:text-[18rem] leading-none font-black text-white/5 select-none absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2">
                        404
                    </span>
                    <h2 class="text-[10rem] md:text-[14rem] leading-none font-black text-white drop-shadow-[0_20px_50px_rgba(223,9,18,0.3)] tracking-tighter motion-safe:animate-bounce">
                        404
                    </h2>
                </div>
                
                <div class="space-y-4">
                    <h3 class="text-3xl md:text-5xl font-black text-white tracking-tight uppercase italic">
                        {t('404.lost')}
                    </h3>
                    <p class="text-gray-400 text-base md:text-xl font-medium max-w-lg mx-auto leading-relaxed" set:html={t('404.subtitle')}>
                    </p>
                </div>
                
                <div class="pt-6 flex flex-col sm:flex-row gap-4 items-center">
                    <a 
                        href={langPrefix + "/"} 
                        data-astro-prefetch 
                        class="group inline-flex items-center justify-center gap-3 bg-[#DF0912] hover:bg-white hover:text-black text-white px-10 py-5 rounded-none font-black uppercase tracking-tighter text-sm transition-all duration-500 shadow-2xl shadow-red-900/40 hover:scale-105"
                    >
                        <svg class="w-5 h-5 transition-transform group-hover:-translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
                        </svg>
                        {t('404.back_home')}
                    </a>
                    <button 
                        onclick="history.back()"
                        class="px-10 py-5 bg-white/5 hover:bg-white/10 text-white font-black uppercase tracking-tighter text-sm border border-white/10 transition-all active:scale-95 hover:border-white/20"
                    >
                        {t('404.back_page')}
                    </button>
                </div>

                <!-- Discovery Grid (Phase 12 - Smart 404) -->
                <div class="pt-24 w-full">
                    <div class="flex items-center gap-3 mb-8 justify-center">
                        <span class="w-1.5 h-6 bg-[#DF0912]"></span>
                        <h4 class="text-xl font-black text-white tracking-tighter uppercase italic">
                            {t('404.discover')}
                        </h4>
                    </div>
                    
                    <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-4 w-full max-w-5xl mx-auto px-4">
                        {discoveryItems.map((item) => {
                            const title = item.title || item.name;
                            // contentSlug, não slugify: título não-latino virava slug vazio → link quebrado.
                            const slug = contentSlug(title);
                            const type = item.media_type || (item.title ? "movie" : "tv");
                            const year = (item.release_date || item.first_air_date || "").split("-")[0];
                            const image = item.poster_path ? `https://image.tmdb.org/t/p/w500${item.poster_path}` : null;
                            
                            return (
                                <a 
                                    href={`${langPrefix}/${type === 'movie' ? 'filme' : 'serie'}/${item.id}-${slug}`}
                                    class="group/item relative aspect-[2/3] overflow-hidden bg-white/5 border border-white/5 transition-all duration-500 hover:scale-105 hover:border-[#DF0912]/30 shadow-2xl"
                                >
                                    {image ? (
                                        <img src={image} alt={title} class="w-full h-full object-cover transition-transform duration-700 group-hover/item:scale-110" />
                                    ) : (
                                        <div class="w-full h-full flex items-center justify-center p-4 text-center text-xs font-bold text-gray-500 uppercase">{title}</div>
                                    )}
                                    <div class="absolute inset-x-0 bottom-0 p-3 bg-gradient-to-t from-black via-black/80 to-transparent translate-y-2 opacity-0 group-hover/item:translate-y-0 group-hover/item:opacity-100 transition-all duration-300">
                                        <p class="text-[10px] text-white font-black truncate uppercase tracking-tighter">{title}</p>
                                        <div class="flex items-center gap-2 mt-1">
                                            <span class="text-[8px] text-[#DF0912] font-black uppercase italic">{year}</span>
                                            <span class="text-[8px] text-gray-500 font-bold uppercase">{type === 'movie' ? t('home.hero_genre') : t('nav.series')}</span>
                                        </div>
                                    </div>
                                </a>
                            );
                        })}
                    </div>
                </div>
            </div>
        </main>

</BaseLayout>

<style>
    @reference 'tailwindcss';
</style>

