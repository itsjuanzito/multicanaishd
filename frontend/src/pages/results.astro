---
// @ts-nocheck
import Navigation from "./components/Navigation.astro";
import BaseLayout from "../layouts/BaseLayout.astro";


import { buscarNoTMDB } from "../services/tmdb";
import { getSuperflixIds } from "../services/superflix-ids";
import { getLangFromUrl, useTranslations } from "../i18n/utils";
import { contentSlug } from "../utils/slugify.js";
import { resolveRotatedSlug } from "../services/urlRotationService.js";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const isPt = lang === "pt";
const langPrefix = isPt ? "" : `/${lang}`;

const search = Astro.url.searchParams.get("q");

if (!search) {
    return Astro.redirect("/");
}

// Definição das variáveis fora do try para garantir escopo
let resultadosRaw = [];
let idsDisponiveis = null;
let erroSistema = false;
let exibindoSugestao = false;
let sugestaoQuery = "";

try {
    // Busca Paralela (Busca no TMDB + Lista de IDs permitidos)
    const [responseTMDB, idsData] = await Promise.all([
        buscarNoTMDB(search, lang),
        getSuperflixIds(),
    ]);

    // Atribui os resultados
    idsDisponiveis = idsData;
    resultadosRaw = responseTMDB?.results || [];

    // Fallback inteligente para correções ortográficas (Spellcheck)
    if (resultadosRaw.length === 0 && search.trim().length > 2) {
        try {
            const suggestUrl = `https://suggestqueries.google.com/complete/search?client=chrome&q=${encodeURIComponent(search)}`;
            const suggestRes = await fetch(suggestUrl, {
                headers: { 'User-Agent': 'Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36' }
            });
            if (suggestRes.ok) {
                const suggestData = await suggestRes.json();
                const suggestions = suggestData[1] || [];
                const validSuggestions = suggestions.filter(s => s && s.toLowerCase().trim() !== search.toLowerCase().trim());
                if (validSuggestions.length > 0) {
                    let cleanSug = validSuggestions[0].replace(/\b(filme|serie|anime|netflix|onde assistir|completo|dublado|legendado|assistir|gratis|online|elenco|sinopse|critica|significado|tradução|revenge|2026)\b/gi, '').trim();
                    if (!cleanSug) cleanSug = validSuggestions[0];
                    
                    if (cleanSug && cleanSug.toLowerCase().trim() !== search.toLowerCase().trim()) {
                        const responseSuggest = await buscarNoTMDB(cleanSug, lang);
                        const resultsSuggest = responseSuggest?.results || [];
                        if (resultsSuggest.length > 0) {
                            resultadosRaw = resultsSuggest;
                            exibindoSugestao = true;
                            sugestaoQuery = cleanSug;
                        }
                    }
                }
            }
        } catch (suggestErr) {
            console.error("Erro ao carregar sugestões/did-you-mean:", suggestErr);
        }
    }
} catch (error) {
    console.error("Erro ao realizar a busca:", error);
    // Em caso de erro grave (timeout, queda de api), as listas ficam vazias
    // e o erroSistema pode ser ativado se quiser tratar visualmente
}

let resultadosFiltrados = [];

// FILTRO COM FALLBACK: Se IDs disponíveis e não-vazias, filtra. Senão, mostra tudo do TMDB.
if (idsDisponiveis) {
    const { movies, series, anime, doramas } = idsDisponiveis;
    const hasDoramas = doramas && doramas.size > 0;
    const idsAvailable = movies.size + series.size + anime.size + (doramas?.size || 0) > 0;

    if (idsAvailable) {
        // Filtro normal com doramas inclusos
        resultadosFiltrados = resultadosRaw
            .filter((item) => {
                const id = Number(item.id);
                const mediaType = item.media_type;
                if (mediaType === "movie") return movies.has(id);
                else if (mediaType === "tv") return series.has(id) || anime.has(id) || (hasDoramas && doramas.has(id));
                return false;
            })
            .map((item) => {
                const id = Number(item.id);
                let categoria = item.media_type === "tv"
                    ? (anime.has(id) ? "anime" : "serie")
                    : "movie";
                return { ...item, categoria };
            });
    } else {
        // Fallback: Superflix em manutenção → mostra tudo do TMDB sem filtrar
        console.warn("⚠️ IDs indisponíveis (manutenção). Busca sem filtro de disponibilidade.");
        resultadosFiltrados = resultadosRaw
            .filter(item => item.media_type === "movie" || item.media_type === "tv")
            .map(item => ({
                ...item,
                categoria: item.media_type === "movie" ? "movie" : "serie"
            }));
    }
} else {
    console.error("⚠️ Falha crítica ao carregar IDs.");
    resultadosFiltrados = [];
}

// Resolve slugs anti-DMCA em paralelo para todos os resultados
try {
    await Promise.all(
        resultadosFiltrados.map(async (item) => {
            const mediaType = item.categoria === 'movie' ? 'movie' : 'series';
            // contentSlug, não slugify: este fallback é o sufixo da URL final /filme|/serie.
            const fallback = `${item.id}-${contentSlug(item.title || item.name)}`;
            // O idioma vem da rota: a rotação é por idioma (colunas _en em url_rotations) e o
            // resultado do TMDB já veio no idioma da busca, então o canônico também é desse idioma.
            item._resolvedSlug = await resolveRotatedSlug(String(item.id), mediaType, fallback, lang);
        })
    );
} catch (e) {
    // fallback silencioso — cada item usará titleSlug abaixo se _resolvedSlug ausente
}

---

<BaseLayout
    title={t('results.meta_title', { query: search })}
    description={t('results.meta_desc', { query: search })}
    keywords={`buscar filmes, buscar séries, assistir ${search}, resultados da busca, multicanaishd, achar animes`}
>
        <main class="flex-grow container mx-auto px-4 sm:px-6 lg:px-8 py-8 mt-20 sm:mt-24">
            <div class="mb-8 border-b border-white/5 pb-6">
                <h2 class="text-3xl font-bold text-white mb-2">
                    {t('search.results_for')} <span class="text-[#DF0912] italic"
                        >"{search}"</span
                    >
                </h2>

                {
                    erroSistema ? (
                        <div class="p-4 bg-red-500/10 border border-red-500/20 rounded-lg text-red-400 text-sm mt-2 flex items-center gap-2">
                            <svg
                                class="w-5 h-5 shrink-0"
                                fill="none"
                                viewBox="0 0 24 24"
                                stroke="currentColor"
                            >
                                <path
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    stroke-width="2"
                                    d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"
                                />
                            </svg>
                            <span>
                                {t('search.service_unavailable_desc')}
                            </span>
                        </div>
                    ) : (
                        <p class="text-gray-400 text-sm">
                            {resultadosFiltrados.length}{" "}
                            {resultadosFiltrados.length === 1
                                ? t('search.title_found')
                                : t('search.found_suffix')}
                            .
                        </p>
                    )
                }
            </div>

            {
                exibindoSugestao && (
                    <div class="mb-8 p-5 bg-white/[0.03] backdrop-blur-xl border border-white/10 rounded-2xl flex items-center gap-4 animate-fade-in shadow-2xl relative overflow-hidden group">
                        <div class="absolute inset-0 bg-gradient-to-r from-[#DF0912]/10 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500 pointer-events-none" />
                        <div class="w-12 h-12 rounded-xl bg-[#DF0912]/15 border border-[#DF0912]/30 flex items-center justify-center text-[#DF0912] shrink-0 shadow-lg relative">
                            <span class="absolute w-2 h-2 rounded-full bg-[#DF0912] top-1 right-1 animate-ping" />
                            <span class="absolute w-2 h-2 rounded-full bg-[#DF0912] top-1 right-1" />
                            <svg class="w-6 h-6 fill-current" viewBox="0 0 24 24">
                                <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 15h-2v-6h2v6zm0-8h-2V7h2v2z" />
                            </svg>
                        </div>
                        <div class="flex-grow">
                            <p class="text-sm text-gray-400 font-medium">
                                {t('search.showing_results_for', { query: search })}
                            </p>
                            <a
                                href={`${langPrefix}/results?q=${encodeURIComponent(sugestaoQuery)}`}
                                class="text-lg font-bold text-white hover:text-[#DF0912] transition-colors inline-flex items-center gap-2 mt-0.5 group-link"
                            >
                                <span class="text-[#DF0912] underline decoration-wavy decoration-[#DF0912]/50 group-hover:decoration-[#DF0912] underline-offset-4 transition-all">
                                    {sugestaoQuery}
                                </span>
                                <svg class="w-4 h-4 text-gray-400 group-hover:text-[#DF0912] group-hover:translate-x-1 transition-all" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7" />
                                </svg>
                            </a>
                        </div>
                    </div>
                )
            }

            {
                resultadosFiltrados.length > 0 ? (
                    <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 xl:grid-cols-6 gap-4 sm:gap-6">
                        {resultadosFiltrados.map((item) => {
                            const title = item.title || item.name;
                            const titleSlug = contentSlug(title);
                            const imgUrl = item.poster_path
                                ? `https://image.tmdb.org/t/p/w500${item.poster_path}`
                                : `https://placehold.co/500x750/1f1f1f/FFF?text=${isPt ? 'SEM+IMAGEM' : 'NO+IMAGE'}`;
                            const type =
                                item.categoria === "movie" ? "movie" : "tv";
                            const rating = item.vote_average
                                ? item.vote_average.toFixed(1)
                                : "0.0";
                            const year =
                                (
                                    item.release_date ||
                                    item.first_air_date ||
                                    ""
                                ).split("-")[0] || "N/A";

                            let labelCategoria =
                                item.categoria === "serie"
                                    ? t('nav.series')
                                    : item.categoria === "anime"
                                      ? t('genre.anime')
                                      : t('home.hero_genre');

                            const resolvedSlug = item._resolvedSlug || `${item.id}-${titleSlug}`;
                            return (
                                <a
                                    href={`${langPrefix}/${type === 'movie' ? 'filme' : 'serie'}/${resolvedSlug}?fromSearch=true`}
                                    data-astro-prefetch
                                    class="group relative flex flex-col bg-[#161B28] rounded-xl overflow-hidden transition-all duration-300 hover:-translate-y-2 hover:shadow-2xl hover:shadow-red-900/10"
                                >
                                    <div class="relative aspect-[2/3] overflow-hidden">
                                        <img
                                            src={imgUrl}
                                            alt={title}
                                            loading="lazy"
                                            class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-110"
                                        />
                                        <div class="absolute top-2 left-2 flex flex-col gap-1">
                                            <span class="px-2 py-0.5 rounded bg-black/60 backdrop-blur-md text-[10px] font-bold text-white uppercase border border-white/10">
                                                {labelCategoria}
                                            </span>
                                        </div>
                                        <div class="absolute inset-0 bg-black/60 opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex items-center justify-center">
                                            <div class="w-12 h-12 rounded-full bg-[#DF0912] flex items-center justify-center transform scale-0 group-hover:scale-100 transition-transform duration-300 delay-75 shadow-lg">
                                                <svg
                                                    class="w-5 h-5 text-white fill-current ml-1"
                                                    viewBox="0 0 24 24"
                                                >
                                                    <path d="M8 5v14l11-7z" />
                                                </svg>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="p-3 flex flex-col flex-grow border-t border-white/5">
                                        <h3 class="text-sm font-bold text-white leading-tight line-clamp-2 group-hover:text-[#DF0912] transition-colors mb-auto">
                                            {title}
                                        </h3>
                                        <div class="flex items-center justify-between mt-3 text-xs text-gray-400">
                                            <span>{year}</span>
                                            <div class="flex items-center gap-1 text-yellow-500">
                                                <svg
                                                    class="w-3 h-3 fill-current"
                                                    viewBox="0 0 20 20"
                                                >
                                                    <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                                                </svg>
                                                <span class="font-bold">
                                                    {rating}
                                                </span>
                                            </div>
                                        </div>
                                    </div>
                                </a>
                            );
                        })}
                    </div>
                ) : (
                    <div class="flex flex-col items-center justify-center py-20 text-center">
                        <div class="w-24 h-24 bg-[#161B28] rounded-full flex items-center justify-center mb-6 border border-white/5">
                            {erroSistema ? (
                                <svg
                                    class="w-10 h-10 text-red-500"
                                    fill="none"
                                    viewBox="0 0 24 24"
                                    stroke="currentColor"
                                >
                                    <path
                                        stroke-linecap="round"
                                        stroke-linejoin="round"
                                        stroke-width="2"
                                        d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"
                                    />
                                </svg>
                            ) : (
                                <svg
                                    class="w-10 h-10 text-gray-500"
                                    fill="none"
                                    stroke="currentColor"
                                    viewBox="0 0 24 24"
                                >
                                    <path
                                        stroke-linecap="round"
                                        stroke-linejoin="round"
                                        stroke-width="2"
                                        d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"
                                    />
                                </svg>
                            )}
                        </div>
                        <h3 class="text-xl font-bold text-white mb-2">
                            {erroSistema
                                ? t('search.service_unavailable')
                                : t('search.no_results_title')}
                        </h3>
                        <p class="text-gray-400 max-w-md mx-auto mb-8">
                            {erroSistema
                                ? t('search.service_unavailable_desc')
                                : t('search.no_results_desc', { search: search })}
                        </p>
                        <a
                            href={langPrefix === "" ? "/" : langPrefix}
                            class="px-6 py-3 bg-[#DF0912] hover:bg-[#be080f] text-white font-bold rounded-lg transition-colors shadow-lg shadow-red-900/20"
                        >
                            {t('404.back_home')}
                        </a>
                    </div>
                )
            }
        </main>

</BaseLayout>

<style>
    @reference 'tailwindcss';
    .line-clamp-2 {
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }
    ::-webkit-scrollbar {
        width: 8px;
    }
    ::-webkit-scrollbar-track {
        background: #0E111A;
    }
    ::-webkit-scrollbar-thumb {
        background: #333;
        border-radius: 4px;
    }
    ::-webkit-scrollbar-thumb:hover {
        background: #df0912;
    }
    @keyframes fadeIn {
        from {
            opacity: 0;
            transform: translateY(10px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }
    .animate-fade-in {
        animation: fadeIn 0.6s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }
</style>
