                                        ))}
                                    </div>
                                </div>
                            )}
                        </div>
                    )}
                </div>

                <div class="lg:col-span-1">
                    <div
                        class="bg-[#161B28] rounded-xl border border-white/5 h-full max-h-[600px] flex flex-col"
                    >
                        <div class="p-4 border-b border-white/5">
                            <h3
                                class="text-white font-bold text-sm uppercase tracking-wide"
                            >
                                {t('tv.see_also')}
                            </h3>
