                        <div
                            id="sidebar-canais"
                            class="overflow-y-auto flex-grow p-2 space-y-1 custom-scrollbar"
                            data-categoria={categoria}
                            data-current-id={id}
                            data-lang-prefix={langPrefix}
                        >
                            {
                                canaisRelacionados.length === 0 ? (
                                    <div class="p-6 text-center text-gray-500 text-xs italic">
                                        {isPt ? "Nenhum canal relacionado disponível" : "No related channels available"}
                                    </div>
                                ) : (
                                    canaisRelacionados.slice(0, 120).map((c) => {
                                        const isVip = isVipChannel(c, vipIds);
                                        return (
                                            <a
                                                href={`${langPrefix}/canal/${slugify(c.nome)}`}
                                                data-is-vip={isVip}
                                                class="flex items-center gap-3 p-2 rounded-lg hover:bg-white/5 transition-colors group relative overflow-hidden"
                                            >
                                                <div class="w-10 h-10 rounded bg-black/20 flex items-center justify-center p-1 border border-white/5 group-hover:border-[#DF0912]/30 flex-shrink-0">
                                                    <img
                                                        src={c.imagem}
                                                        alt={c.nome}
                                                        class="w-full h-full object-contain"
                                                    />
                                                </div>
                                                <div class="flex-1 min-w-0 flex flex-col justify-center">
                                                    <div class="flex items-center gap-1.5 min-w-0">
                                                        <p class="text-sm font-bold text-gray-200 group-hover:text-white truncate">
                                                            {c.nome}
                                                        </p>
                                                        {isVip && (
                                                            <span class="flex-shrink-0 px-1 py-0.5 bg-[#DF0912]/20 border border-[#DF0912]/40 rounded text-[7px] font-black text-[#DF0912] uppercase tracking-tighter">VIP</span>
                                                        )}
                                                    </div>
                                                    <p class="text-[9px] text-gray-500 font-medium">
                                                        {c.categoria}
                                                    </p>
                                                    {nowPlayingMap[c.id] && (
                                                        <div class="mt-0.5">
                                                            <p class="text-[10px] text-[#DF0912] font-bold truncate" title={nowPlayingMap[c.id].title}>
                                                                {nowPlayingMap[c.id].title}
                                                            </p>
                                                            <div class="w-full h-[2px] bg-black/30 rounded-full overflow-hidden mt-0.5">
                                                                <div class="h-full bg-[#DF0912] rounded-full" style={`width: ${nowPlayingMap[c.id].progress}%`}></div>
                                                            </div>
                                                        </div>
                                                    )}
                                                </div>
                                                <div class="w-1.5 h-1.5 rounded-full bg-green-500/50 group-hover:bg-green-500 flex-shrink-0" />
                                            </a>
                                        );
                                    })
                                )
                            }
                        </div>
                    </div>
                </div>
            </div>
        )}
    </main>

        <footer class="border-t border-gray-800 mt-auto py-6">
            <div class="container mx-auto px-4 text-center">
                <p class="text-gray-400 text-xs">© 2026 MultiCanaisHD</p>
            </div>
        </footer>

        <script>
            import { authStore, updateCloudStats } from "../../store/authStore";

            // Helper seguro para obter a sessão otimista sem risco de crash no JSON.parse
            function getSafeOptimisticSession() {
                try {
                    if (typeof localStorage !== 'undefined') {
                        const raw = localStorage.getItem('bf_session_optimistic');
                        if (raw && raw !== 'undefined') {
                            return JSON.parse(raw) || {};
                        }
                    }
                } catch (e) {}
                return {};
            }

            // O gate VIP desta pagina roda no astro:page-load, mas o `window._authStore` so
            // aparece depois do nuclear loader do BaseLayout (1s no desktop, 3.5s no mobile, ou
            // no primeiro clique). Quem chega sem `bf_session_optimistic` no localStorage --
            // primeira visita, storage limpo, aba anonima -- caia no ramo bloqueado, e a
            // destrava reativa estava guardada por `if (window._authStore)`, justamente o que
            // ainda nao existia: o cadeado ficava permanente pra VIP pagante ate um F5.
            // `authStore` e importado aqui em cima e e o MESMO singleton (globalThis), entao
            // da pra assinar na hora, sem esperar loader nenhum.
            // Recarrega uma vez so. A destrava do ramo bloqueado depende de um F5 (o player
            // e montado no outro listener, fora deste escopo); sem a trava, uma sessao que
            // diga VIP mas nao persista o `bf_session_optimistic` entraria em loop de reload.
            function destravarComReload() {
                try {
                    const chave = 'bf_canal_destrava_' + (document.querySelector('main')?.dataset.id || window.location.pathname);
                    if (sessionStorage.getItem(chave) === '1') {
                        console.warn('[Canal] Ja recarreguei uma vez por causa do gate VIP; nao vou entrar em loop.');
                        return;
                    }
                    sessionStorage.setItem(chave, '1');
                } catch (e) {}
                window.location.reload();
            }

            function aoVirarVip(callback) {
                try {
                    const store = window._authStore || authStore;
                    if (!store?.subscribe) return () => {};
                    if (store.get?.()?.isVIP) {
                        callback();
                        return () => {};
                    }
                    const unsubscribe = store.subscribe((state) => {
                        if (state?.isVIP) {
                            callback();
                            try { unsubscribe(); } catch (e) {}
                        }
                    });
                    return unsubscribe;
                } catch (e) {
                    console.error("[Canal] Falha ao observar mudanca de VIP:", e);
                    return () => {};
                }
            }

            // Espera a sessao REAL antes de decidir se bloqueia. O gate roda no
            // astro:page-load, mas quem inicializa a sessao e o nuclear loader do BaseLayout,
            // que so comeca 1s (desktop) ou 3.5s (mobile) depois -- ou no primeiro clique.
            // Decidir antes disso trata VIP pagante como visitante, e o
            // `multicanaishd:open-vip` que sai daqui nao e um modal: sem #vip-modal no DOM da
            // pagina de canal, o interceptor do BaseLayout faz `location.href = "/vip"` e
            // chuta o assinante pra fora do canal.
            // So esperamos quando ha rastro de sessao no storage; visitante de verdade segue direto.
            function haRastroDeSessao() {
                try {
                    if (localStorage.getItem('bf_session_optimistic')) return true;
                    for (let i = 0; i < localStorage.length; i++) {
                        const chave = localStorage.key(i);
                        if (chave && (chave.startsWith('sb-') || chave.includes('supabase.auth.token'))) return true;
                    }
                } catch (e) {}
                return false;
            }

            async function esperarSessaoResolver(timeoutMs = 6000) {
                if (!haRastroDeSessao()) return;
                const store = window._authStore || authStore;
                if (store?.get?.()?.initialized) return;

                await new Promise((resolve) => {
                    let pronto = false;
                    const terminar = () => {
                        if (pronto) return;
                        pronto = true;
                        try { cancelar?.(); } catch (e) {}
                        clearTimeout(prazo);
                        resolve(undefined);
                    };
                    const cancelar = store?.subscribe
                        ? store.subscribe((estado) => {
                            if (estado?.initialized || estado?.isVIP) terminar();
                        })
                        : null;
                    const prazo = setTimeout(terminar, timeoutMs);
                });
            }

            document.addEventListener("astro:page-load", async () => {
                const main = document.querySelector('main');
                // VIP Check & Player Unveil
                try {
                    if (main) {
                        const isLocked = main.dataset.locked === "true";
                        if (isLocked) await esperarSessaoResolver();
                        let isUserVip = main.dataset.userVip === "true";
                        const lockedToastMsg = main.dataset.tLockedToast || "Este canal é exclusivo para membros VIP!";

                        // Fallback client-side (Phase 15 - Session Sync)
                        if (!isUserVip) {
                            const { isVIP: storeVip } = (window._authStore || authStore)?.get?.() || { isVIP: false };
                            const sessionData = getSafeOptimisticSession();
                            if (storeVip || sessionData.isVIP === true) {
                                isUserVip = true;
                            }
                        }

                        if (isLocked && !isUserVip) {
                            document.dispatchEvent(new CustomEvent('multicanaishd:open-vip'));
                            import("../../store/toastStore").then(m => m.showToast(lockedToastMsg, "info"));
                            
                            // Unveil the main layout even if locked, so they can use the page/sidebar
                            const container = document.getElementById("canal-player-container");
                            const loader = document.getElementById("player-vip-loader");
                            if (container && loader) {
                                loader.style.opacity = '0';
                                setTimeout(() => {
                                    loader.classList.add('hidden');
                                    container.classList.remove('hidden');
                                    setTimeout(() => container.classList.add('opacity-100'), 50);
                                }, 500);
                            }

                            // Style the fake player mask to represent a premium lock screen
                            const fakePlayer = document.getElementById("fakePlayerMask");
                            if (fakePlayer) {
                                const iconContainer = fakePlayer.querySelector('div.bg-\\[\\#DF0912\\]');
                                if (iconContainer) {
                                    iconContainer.innerHTML = `<svg class="w-8 h-8 text-white animate-pulse" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/></svg>`;
                                }
                                const labelSpan = fakePlayer.querySelector('span');
                                if (labelSpan) {
                                    const lang = main.dataset.lang || "pt";
                                    const isPt = lang === "pt";
                                    labelSpan.textContent = isPt ? "CONTEÚDO EXCLUSIVO VIP - CLIQUE PARA LIBERAR" : "EXCLUSIVE VIP CONTENT - CLICK TO UNLOCK";
                                    labelSpan.className = "text-[#DF0912] text-xs font-black uppercase tracking-widest mt-4 text-center px-4";
                                }
                                fakePlayer.addEventListener("click", (e) => {
                                    e.stopPropagation();
                                    // Re-checa na hora do clique: o gate pode ter travado a pagina
                                    // antes da sessao carregar, e oferecer assinatura pra quem ja
                                    // paga e o pior desfecho possivel.
                                    const jaEhVip = (window._authStore || authStore)?.get?.()?.isVIP === true;
                                    if (jaEhVip) {
                                        destravarComReload();
                                        return;
                                    }
                                    document.dispatchEvent(new CustomEvent('multicanaishd:open-vip'));
                                });
                            }

                            // Reactive VIP unlock listener
                            aoVirarVip(() => {
                                console.log('[Canal] User status changed to VIP. Unlocking player...');
                                destravarComReload();
                            });
                        } else {
                            // Intercept VIP clicks moved to BaseLayout.astro
                            const container = document.getElementById("canal-player-container");
                            const loader = document.getElementById("player-vip-loader");
                            if (container && loader) {
                                loader.style.opacity = '0';
                                setTimeout(() => {
                                    loader.classList.add('hidden');
                                    container.classList.remove('hidden');
                                    setTimeout(() => container.classList.add('opacity-100'), 50);
                                }, 500);
                            }
                        }
                    }
                } catch (e) {
                    console.error("Error checking VIP/unlocking player:", e);
                    // Safe fallback: force hide loader and show player
                    const container = document.getElementById("canal-player-container");
                    const loader = document.getElementById("player-vip-loader");
                    if (container && loader) {
                        loader.classList.add('hidden');
                        container.classList.remove('hidden');
                        container.classList.add('opacity-100');
                    }
                }

                // Lógica do Fake Player (IGUAL AO SLUG.ASTRO)
                const fakePlayer = document.getElementById("fakePlayerMask");
                const playerFrame = document.getElementById("playerFrame");

                console.log('[Canal] Fake player init:', { fakePlayer: !!fakePlayer, playerFrame: !!playerFrame, isDynamic: main?.dataset.dynamic });

                if (fakePlayer && playerFrame) {
                    let loaded = false;

                    // Helper robusto para check de VIP (Fase 15)
                    const checkVip = () => {
                        const { isVIP: storeVip } = (window._authStore || authStore)?.get?.() || { isVIP: false };
                        const ssrVip = main.dataset.userVip === "true";
                        const sessionData = getSafeOptimisticSession();
                        return ssrVip || storeVip || sessionData.isVIP === true;
                    };

                    // Monta a URL do iframe na hora: inclui a chave pública (StreamBetter
                    // some com o anúncio dela) só se o viewer atual for VIP.
                    const buildPlayerUrl = () => {
                        const base = main?.dataset.embedBase || "";
                        const slug = main?.dataset.embedSlug || "";
                        const kind = main?.dataset.embedKind || "canal";
                        if (!base || !slug) return main?.dataset.sourceUrl || "";
                        const params = new URLSearchParams();
                        const key = main?.dataset.embedKey || "";
                        if (checkVip() && key) params.set("key", key);
                        return `${base}/${kind}/${slug}?${params.toString()}`;
                    };

                    const loadPlayer = async (force = false) => {
                        if (loaded && !force) return;

                        const oldFrame = document.getElementById('playerFrame');
                        if (!oldFrame) return;

                        const loader = document.getElementById("player-source-loader");
                        if (loader) {
                            loader.classList.remove("opacity-0");
                            loader.classList.add("opacity-100");
                        }

                        const secureSrc = buildPlayerUrl();

                        if (loader) {
                            loader.classList.replace("opacity-100", "opacity-0");
                        }

                        if (!secureSrc) {
                            const offlineMsg = main?.dataset.offlineMsg || "Canal temporariamente offline.";
                            import("../../store/toastStore").then(m => m.showToast(offlineMsg, "error"));
                            return;
                        }

                        loaded = true;
                        const srcFinal = secureSrc;

                        // Estratégia de Inicialização Estrita (Fase 15 - UX/Segurança)
                        const newFrame = document.createElement('iframe');
                        newFrame.id = 'playerFrame';
                        newFrame.className = 'absolute top-0 left-0 w-full h-full z-10';
                        newFrame.title = oldFrame.title || 'Player';

                        // 1. Configurar atributos de segurança e permissão (Sintaxe Estrita)
                        newFrame.setAttribute('allow', 'autoplay *; fullscreen *; encrypted-media *; picture-in-picture *; web-share *; accelerometer; gyroscope; clipboard-write');
                        newFrame.setAttribute('allowfullscreen', 'true');
                        newFrame.setAttribute('webkitallowfullscreen', 'true');
                        newFrame.setAttribute('mozallowfullscreen', 'true');
                        try {
                            // @ts-ignore
                            newFrame.allowFullscreen = true;
                        } catch(e) {}

                        // 2. Re-anexar handler de limpeza do loader
                        newFrame.onload = () => {
                            const l = document.getElementById('playerLoading');
                            if (l) {
                                l.style.opacity = '0';
                                setTimeout(() => l.style.display = 'none', 500);
                            }
                        };

                        // 3. Inserir no DOM PRIMEIRO
                        oldFrame.replaceWith(newFrame);

                        // 4. Setar SRC POR ÚLTIMO
                        newFrame.src = srcFinal;

                        // 5. Registrar no histórico já no play (canal e jogo), sem depender
                        // do heartbeat de 60s — que descarta o tick se a aba não estiver visível.
                        try {
                            saveHistory();
                        } catch (e) {
                            console.error("Erro ao salvar histórico do canal:", e);
                        }
                    };

                    const isLocked = main?.dataset.locked === "true";
                    // Se o snapshot não diz VIP, espera o check real (teto 5s) antes de montar:
                    // carregar sem chave e recarregar depois não adianta, o anúncio da
                    // StreamBetter já disparou nos primeiros segundos (VIP via anúncio na 1ª
                    // carga e não no reload).
                    if (!checkVip()) {
                        const store = window._authStore || authStore;
                        if (store?.get?.()?.initialized === false) {
                            await new Promise((resolve) => {
                                let unsub = null;
                                const done = () => { clearTimeout(timer); unsub?.(); resolve(); };
                                const timer = setTimeout(done, 5000);
                                try {
                                    unsub = store.subscribe((st) => { if (st?.initialized) done(); });
                                } catch (e) { done(); }
                            });
                        }
                    }
                    const isUserVipNow = checkVip();
                    console.log('[Canal] VIP check final:', { isUserVipNow });

                    if (isLocked && !isUserVipNow) {
                        console.log('[Canal] Canal bloqueado para não-VIP. Fake player exibe cadeado e não reproduz.');
                        // A máscara VIP já foi configurada no bloco VIP Check & Player Unveil acima,
                        // então não adicionamos o listener normal de sintonizar.
                    } else {
                        // Canal liberado (VIP ou não) — carrega direto, sem gate próprio. Anúncio
                        // pra quem não é VIP agora é responsabilidade da StreamBetter (sem chave).
                        if (fakePlayer) {
                            fakePlayer.style.display = "none";
                            fakePlayer.remove();
                        }
                        await loadPlayer();

                        // isUserVipNow é um chute otimista (sessão pode não ter resolvido ainda).
                        // Se confirmar VIP depois, recarrega pra trocar a URL e tirar o anúncio.
                        if (!isUserVipNow) {
                            aoVirarVip(() => {
                                console.log('[Canal] VIP confirmado via Store - recarregando player sem anúncio');
                                loadPlayer(true);
                            });
                        }
                    }
                }

                // Limpeza ao sair da página
                document.addEventListener("astro:before-preparation", () => {
                    if (heartbeatInterval) clearInterval(heartbeatInterval);
                    activityEvents.forEach(evt => document.removeEventListener(evt, handleActivity));
                    document.removeEventListener("multicanaishd:still-watching-resume", handleStillWatchingResume);
                }, { once: true });

                // --- HEARTBEAT SYSTEM ---
                let heartbeatInterval = null;
                let lastInteraction = Date.now();
                let isStillWatchingWaiting = false;

                const activityEvents = ['mousemove', 'click', 'keypress', 'touchstart', 'scroll'];
                const handleActivity = () => {
                    if (!isStillWatchingWaiting) {
                        lastInteraction = Date.now();
                    }
                };
                activityEvents.forEach(evt => document.addEventListener(evt, handleActivity));

                const handleStillWatchingResume = () => {
                    lastInteraction = Date.now();
                    isStillWatchingWaiting = false;
                    sendPing();
                };
                document.addEventListener("multicanaishd:still-watching-resume", handleStillWatchingResume);

                function saveHistory() {
                    const { user } = authStore.get();
                    if (!user || !main) return;
                    
                    const channelId = main.dataset.id;
                    const channelTitle = main.dataset.title;
                    const isDynamic = main.dataset.dynamic === "true";
                    const image = main.dataset.image;
                    const channelType = isDynamic ? 'live_game' : 'live_tv';

                    const current = authStore.get();
                    const history = current.history ? [...current.history] : [];

                    const idx = history.findIndex(i => i.id == channelId);
                    const existingItem = idx > -1 ? history[idx] : null;

                    const item = {
                        ...(existingItem || {}),
                        id: channelId,
                        title: channelTitle,
                        poster: image || '',
                        backdrop: image || '',
                        type: channelType,
                        slug: window.location.pathname.split('/').pop() || '',
                        url: window.location.pathname,
                        timestamp: Date.now(),
                        genreName: isDynamic ? 'Ao Vivo' : 'Canais de TV',
                        watched_seconds: existingItem?.watched_seconds || 0
                    };

                    if (idx > -1) history.splice(idx, 1);
                    history.unshift(item);
                    
                    authStore.set({
                        ...current,
                        history: history.slice(0, 50)
                    });
                    updateCloudStats({ history: history.slice(0, 50) });
                }

                async function sendPing() {
                    const { token, user } = authStore.get();
                    if (!token || !user) return;
                    
                    const channelId = main?.dataset.id;
                    if (!channelId) return;

                    try {
                        const res = await fetch("/api/watch/heartbeat", {
                            method: "POST",
                            headers: {
                                "Authorization": `Bearer ${token}`,
                                "Content-Type": "application/json"
                            },
                            body: JSON.stringify({
                                mediaId: channelId,
                                type: "channel"
                            })
                        });
                        const data = await res.json();
                        if (data.success) {
                            console.log(`%c💓 [Heartbeat TV] Ping enviado. Segundos ativos: ${data.activeSeconds}`, "color: #df0912; font-weight: bold;");
                            
                            const current = authStore.get();
                            let updatedHistory = current.history ? [...current.history] : [];
                            const itemIdx = updatedHistory.findIndex(i => i.id == channelId);
                            
                            if (itemIdx > -1) {
                                const item = { ...updatedHistory[itemIdx] };
                                item.watched_seconds = (item.watched_seconds || 0) + 60;
                                item.timestamp = Date.now();
                                updatedHistory[itemIdx] = item;
                                
                                authStore.set({
                                    ...current,
                                    activeSeconds: data.activeSeconds,
                                    history: updatedHistory
                                });
                                updateCloudStats({ history: updatedHistory });
                            } else {
                                saveHistory();
                                const reCurrent = authStore.get();
                                let reHistory = reCurrent.history ? [...reCurrent.history] : [];
                                const reIdx = reHistory.findIndex(i => i.id == channelId);
                                if (reIdx > -1) {
                                    const item = { ...reHistory[reIdx] };
                                    item.watched_seconds = 60;
                                    reHistory[reIdx] = item;
                                    
                                    authStore.set({
                                        ...reCurrent,
                                        activeSeconds: data.activeSeconds,
                                        history: reHistory
                                    });
                                    updateCloudStats({ history: reHistory });
                                }
                            }
                        }
                    } catch (e) {
                        console.error("❌ [Heartbeat TV] Falha ao enviar batida:", e.message);
                    }
                }

                // Loop a cada 60 segundos
                heartbeatInterval = setInterval(() => {
                    const state = authStore.get();
                    if (!state.user) return;
                    if (document.visibilityState !== "visible") return;

                    const idleTime = Date.now() - lastInteraction;
                    const THREE_HOURS = 3 * 3600 * 1000;

                    if (idleTime > THREE_HOURS) {
                        if (!isStillWatchingWaiting) {
                            isStillWatchingWaiting = true;
                            document.dispatchEvent(new CustomEvent("multicanaishd:still-watching"));
                        }
                        return;
                    }

                    sendPing();
                }, 60000);

                // Lógica do botão de Embed — abre o embed público da StreamBetter numa nova aba
                const embedBtn = document.getElementById("embedBtn");
                if (embedBtn) {
                   embedBtn.addEventListener("click", () => {
                       window.open("https://streambetter.lol", "_blank", "noopener");
                   });
                }

                // Lógica de Tela Cheia Customizada (Fase 15)
                const fsBtn = document.getElementById("customFullscreenBtn");
                const wrapper = document.getElementById("playerWrapper");

                if (fsBtn && wrapper) {
                    fsBtn.addEventListener("click", () => {
                        try {
                            if (!document.fullscreenElement) {
                                if (wrapper.requestFullscreen) {
                                    wrapper.requestFullscreen();
                                } else if (wrapper.webkitRequestFullscreen) {
                                    wrapper.webkitRequestFullscreen();
                                } else if (wrapper.msRequestFullscreen) {
                                    wrapper.msRequestFullscreen();
                                }
                            } else {
                                if (document.exitFullscreen) {
                                    document.exitFullscreen();
                                }
                            }
                        } catch (err) {
                            console.error("Erro ao alternar tela cheia:", err);
                        }
                    });

                    document.addEventListener("fullscreenchange", () => {
                        const enterIcon = document.getElementById("fs-icon-enter");
                        const exitIcon = document.getElementById("fs-icon-exit");
                        if (document.fullscreenElement) {
                            enterIcon?.classList.add("hidden");
                            exitIcon?.classList.remove("hidden");
                            wrapper.classList.remove("rounded-xl"); // Melhora a estética full
                        } else {
                            enterIcon?.classList.remove("hidden");
                            exitIcon?.classList.add("hidden");
                            wrapper.classList.add("rounded-xl");
                        }
                    });
                }
            });
        </script>

</BaseLayout>

