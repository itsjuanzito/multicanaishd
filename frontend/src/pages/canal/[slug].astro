                                class="flex items-center gap-2 px-4 py-2 rounded-lg bg-orange-500 hover:bg-orange-600 text-white text-sm font-bold transition-all w-full sm:w-auto justify-center shadow-lg shadow-orange-900/20 active:scale-95"
                            >
                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
                                </svg>
                                {t('player.report_error')}
                            </button>
                            <button
                                id="embedBtn"
                                class="flex items-center gap-2 px-4 py-2 rounded-lg bg-[#1D2437] hover:bg-[#333] text-gray-300 hover:text-[#DF0912] text-sm font-bold transition-all border border-white/5 shadow-md active:scale-95"
                                title={t('player.embed')}
                            >
                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4" />
                                </svg>
                                {t('player.embed')}
                            </button>
