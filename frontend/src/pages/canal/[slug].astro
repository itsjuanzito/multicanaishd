---
// src/pages/canal.astro
// @ts-nocheck
import "../../styles/global.css";
export const prerender = false;
import { getCanalById, fetchCanais, fetchVipChannels, getNowPlayingBulk, withCeiling } from "../../services/channelsService.js";
import BaseLayout from "../../layouts/BaseLayout.astro";

// i18n
import { getLangFromUrl, useTranslations } from "../../i18n/utils";
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const isPt = lang === "pt";
const langPrefix = isPt ? "" : `/${lang}`;

const { slug } = Astro.params;
if (!slug) return Astro.redirect("/");

// --- ENVIRONMENT CONFIGURATION ---
import { setRuntimeEnv, getSiteUrl } from "../../services/env-adapter.js";

if (Astro.locals?.runtime?.env) {
    setRuntimeEnv(Astro.locals.runtime.env);
}
const siteUrl = getSiteUrl(Astro.url);

// --- MASTER PARALLELIZATION (Zero-Wait Architecture) ---
// Disparamos TUDO simultaneamente para o TTFB ser sub-segundo
const isMatchSlug = slug.toLowerCase().includes('-x-') || slug.toLowerCase().startsWith('jogo-');

// Tetos rígidos — mesma razão e mesmo padrão de LayoutCardTV.astro.
//
// O `.catch()` abaixo pega REJEIÇÃO, não pega TRAVAMENTO. Sem teto, o await ficava pendurado,
// a resposta HTTP nunca fechava e a Cloudflare devolvia 524 depois de ~125s: medido em
// produção, 11 de 20 requisições a /canal/* nunca respondiam (524 explícito em 125,4s).
// 5xx em massa é justamente o que faz o Google cortar o crawl budget (§4.2 das regras).
//
// 7s espelha o PER_SOURCE_TIMEOUT_MS da home (não 2.5s como no card da home: aqui a lista é
// o conteúdo principal, e um teto apertado demais converteria canal bom em estado degradado).
const SSR_DATA_CEILING_MS = 7000;
const SSR_EPG_CEILING_MS = 3000;

const [canaisResult, vipChannels] = await withCeiling(
    Promise.all([
        fetchCanais(isMatchSlug).catch(e => {
            console.error(`[Canal] Fallback fetchCanais:`, e.message);
            return [];
        }),
        fetchVipChannels().catch(e => {
            console.error(`[Canal] Fallback fetchVipChannels:`, e.message);
            return [];
        })
    ]),
    SSR_DATA_CEILING_MS,
    [[], []]
);

const canaisTV = canaisResult || [];

// Busca por Slug (Lógica Principal)
import { slugify } from "../../utils/slugify.js";
import {
    buildEmbedUrl,
    getShopUrl,
    getEmbedPublicKey,
} from "../../services/streamEmbedService.js";

const normalizeVipKey = (value) => {
    if (value === null || value === undefined) return '';
    return String(value)
        .toLowerCase()
        .trim()
        .normalize('NFD')
        .replace(/[\u0300-\u036f]/g, '')
        .replace(/[^a-z0-9]+/g, '-')
        .replace(/^-+|-+$/g, '');
};

const buildVipLookupSet = (ids = []) =>
    new Set((ids || []).flatMap((id) => {
        const raw = String(id);
        const normalized = normalizeVipKey(id);
        return normalized ? [raw, normalized] : [raw];
    }));

const buildVipCandidates = (channelLike) => {
    const candidates = new Set();
    const push = (v) => {
        if (!v) return;
        const raw = String(v).trim();
        if (!raw) return;
        candidates.add(raw);
        const normalized = normalizeVipKey(raw);
        if (normalized) candidates.add(normalized);
    };

    const title = channelLike?.nome || channelLike?.name || '';
    push(channelLike?.id);
    push(channelLike?.slug);
    if (title) {
        const titleSlug = slugify(title);
        push(titleSlug);
        push(`jogo_${titleSlug}`);
    }
    return candidates;
};

const isVipChannel = (channelLike, vipSet) => Array.from(buildVipCandidates(channelLike)).some((k) => vipSet.has(k));
const cleanSlug = slug.toLowerCase().replace(/^jogo-/, '').replace(/^jogo_/, '');
let canal = canaisTV.find(c => {
    const cleanId = String(c.id).toLowerCase().replace(/^jogo-/, '').replace(/^jogo_/, '');
    const cleanName = slugify(c.nome || "");
    return cleanId === cleanSlug || cleanName === cleanSlug;
});

// Slug canônico de canal fixo = o nome slugificado. A rota também casa por ID numérico
// (`/canal/123`), e as duas formas respondiam 200 cada uma com canonical PRÓPRIA — várias URLs
// concorrentes para o mesmo canal, dividindo sinal. Mesma regra de /filme e /serie: 301 para o
// canônico. Só o caso numérico é redirecionado de propósito: slug de jogo (`jogo-*`, `a-x-b`)
// é efêmero e já sai com noindex, e mexer nele arriscaria a URL de uma partida ao vivo.
if (canal && !isMatchSlug && /^\d+$/.test(cleanSlug)) {
    const slugCanonicoCanal = slugify(canal.nome || "");
    if (slugCanonicoCanal && slugCanonicoCanal !== cleanSlug) {
        return Astro.redirect(`${langPrefix}/canal/${slugCanonicoCanal}`, 301);
    }
}

// Canal fixo (não jogo) fora de uma lista que CARREGOU não existe: 404 de verdade. Antes
// qualquer /canal/<lixo> respondia 200 indexável — soft 404 que gastava rastreamento. Lista
// vazia é falha do upstream, não prova de inexistência: essa cai no estado degradado abaixo,
// e o estado degradado NÃO tira mais o canal do índice (ver shouldNoindex).
if (!canal && !isMatchSlug && canaisTV.length > 0) {
    Astro.response.status = 404;
    return Astro.rewrite("/404");
}

let isExpiredEvent = false;
if (!canal) {
    console.warn(`[Canal] Slug ${slug} não encontrado nos canais ativos. Renderizando estado de Transmissão Encerrada.`);
    isExpiredEvent = true;
    
    // Objeto mock seguro e amigável para evitar erros downstream (Código À Prova de Falhas)
    canal = {
        id: `expired_${slug}`,
        nome: slug.replace(/-/g, ' ').replace(/(^\w|\s\w)/g, m => m.toUpperCase()), // Formata slug amigavelmente (ex: Flamengo X Vasco)
        categoria: isPt ? "Esportes" : "Sports",
        imagem: "/placeholder.jpg",
        url: ""
    };
}

// `isExpiredEvent` sozinho NÃO pode decidir o noindex: ele também fica true quando a lista de
// canais veio vazia (falha/travamento do upstream — ver os tetos no topo desta página), e aí
// TODO /canal/<canal-fixo> saía com `noindex, nofollow`. Isso fazia o Google descartar canais
// de verdade (SBT, ESPN, Telecine...) por causa de uma instabilidade passageira da fonte —
// exatamente as URLs que mais têm demanda de busca.
//
// O noindex fica reservado ao que é efêmero por natureza: evento de jogo (`jogo-*` ou
// `<time>-x-<time>`), que sai do ar sozinho depois da partida. É a mesma regra que
// tests/unit/seo-channel.test.js já afirmava — e que a página não implementava.
const shouldNoindex = isExpiredEvent && isMatchSlug;

const id = canal.id;
const isDynamicChannel = String(id).startsWith('jogo_');
const nomeDecodificado = canal.nome || t('tv.fallback_name');
const categoria = canal.categoria || t('tv.fallback_category');

// Sem chave por padrão: `isVIP` no SSR é sempre false (HTML precisa ser cacheável, não pode
// variar por usuário) — quem decide se inclui a chave (VIP = sem anúncio da StreamBetter) é
// o cliente, via checkVip() real, remontando a URL na hora.
const embedUrl = buildEmbedUrl({
    kind: isDynamicChannel ? "game" : "channel",
    slug: slugify(nomeDecodificado),
    includeKey: false,
});

// Filtro rápido de relacionados (Normalização Master de Categorias - Pilar 3)
const canaisRelacionados = canaisTV.filter((c) => 
    c.categoria && categoria && 
    c.categoria.trim().toLowerCase() === categoria.trim().toLowerCase() && 
    String(c.id) !== String(id)
);

// Guia de programação (Agora passando + Próximos) — canal atual + relacionados exibidos na sidebar
const epgIds = [id, ...canaisRelacionados.map((c) => c.id)];
// Tetos por fonte, no mesmo espírito da home: o EPG é enfeite (o cliente reidrata via
// /api/epg.json), então estourar aqui não pode segurar a resposta da página.
const nowPlayingMap = await withCeiling(getNowPlayingBulk(epgIds), SSR_EPG_CEILING_MS, {});
const currentNowPlaying = nowPlayingMap[id] || null;

// Dados VIP
const vipIdsArray = (vipChannels || []).map((id) => String(id));
const vipIds = buildVipLookupSet(vipIdsArray);
const isChannelLocked = isVipChannel({ id, nome: nomeDecodificado, slug }, vipIds);

// Constante de propósito — mesma razão documentada em filme/[slug].astro e, antes dele, em
// redirect/[slug].astro: o `supabase.auth.getSession()` que alimentava isto nunca devolvia
// sessão no SSR do Worker, então já era false pra todo mundo, VIP incluso. Quem resolve o VIP
// de verdade é o cliente — nesta página o script já combina `ssrVip || storeVip ||
// sessionData.isVIP`, então o valor do SSR só entrava como o `false` que ele sempre foi.
// Como constante, o HTML do SSR não varia por usuário, que é condição pra poder ser cacheado.
const isUserVip = false;
// --------------------------------

const seoTitle = isPt
    ? `Assistir ${nomeDecodificado} Ao Vivo em HD Online Grátis - MultiCanaisHD TV`
    : `Watch ${nomeDecodificado} Live Stream Online Free in HD - MultiCanaisHD TV`;

const seoDescription = isPt
    ? `Assista ${nomeDecodificado} ao vivo grátis em HD. Acompanhe a transmissão em tempo real sem travamentos e com a melhor qualidade de som e imagem no MultiCanaisHD.`
    : `Watch ${nomeDecodificado} live stream online for free in high quality. Enjoy real-time broadcast with no ads and zero delay on MultiCanaisHD.`;

// Esquemas de dados estruturados dinâmicos: SportsEvent para partidas, BroadcastService para canais normais
let gameStartDate = new Date().toISOString();
if (canal?.hora_inicio) {
    const ts = String(canal.hora_inicio).length <= 10 ? canal.hora_inicio * 1000 : canal.hora_inicio;
    gameStartDate = new Date(ts).toISOString();
}
const gameEndDate = new Date(new Date(gameStartDate).getTime() + (2 * 60 * 60 * 1000)).toISOString();

const canalJsonLd = isDynamicChannel 
    ? {
        "@context": "https://schema.org",
        "@type": "SportsEvent",
        "name": nomeDecodificado,
        "description": seoDescription,
        "startDate": gameStartDate,
        "endDate": gameEndDate,
        "image": canal?.imagem,
        "url": Astro.url.href,
        "sport": "Football/Soccer",
        "eventStatus": "https://schema.org/EventScheduled",
        "eventAttendanceMode": "https://schema.org/OnlineEventAttendanceMode",
        "location": {
            "@type": "VirtualLocation",
            "url": Astro.url.href
        },
        "offers": {
            "@type": "Offer",
            "url": Astro.url.href,
            "price": "0",
            "priceCurrency": "BRL",
            "availability": "https://schema.org/InStock",
            "validFrom": gameStartDate
        },
        "organizer": {
            "@type": "Organization",
            "name": "MultiCanaisHD",
            "url": siteUrl
        },
        "performer": {
            "@type": "PerformingGroup",
            "name": nomeDecodificado
        },
        "liveBroadcast": {
            "@type": "BroadcastEvent",
            "isLiveBroadcast": true,
            "name": nomeDecodificado,
            "videoFormat": "HD",
            "startDate": gameStartDate,
            "endDate": gameEndDate
        }
      }
    : {
        "@context": "https://schema.org",
        "@graph": [
            {
                "@type": "BroadcastService",
                "@id": `${siteUrl}/canal/${slug}#service`,
                "name": nomeDecodificado,
                "broadcastDisplayName": nomeDecodificado,
                "videoFormat": "HD",
                "inLanguage": isPt ? "pt-BR" : "en-US",
                "description": seoDescription,
                "url": `${siteUrl}${langPrefix}/canal/${slug}`,
                "hasBroadcastChannel": {
                    "@type": "BroadcastChannel",
                    "@id": `${siteUrl}/canal/${slug}#channel`,
                    "broadcastChannelId": slug,
                    "providesBroadcastService": `${siteUrl}/canal/${slug}#service`
                }
            }
        ]
      };

const keywords = isDynamicChannel
    ? (isPt
        ? `assistir ${nomeDecodificado} ao vivo, assistir ${nomeDecodificado} online gratis, ${nomeDecodificado} ao vivo online, onde assistir ${nomeDecodificado}, futebol ao vivo gratis, assistir futebol online, jogo do ${nomeDecodificado.split('x')[0]?.trim()} ao vivo, jogo ${nomeDecodificado} online gratis`
        : `watch ${nomeDecodificado} live, watch ${nomeDecodificado} online free, ${nomeDecodificado} live stream free, where to watch ${nomeDecodificado} live, free soccer stream, stream sports online free, watch sports online free`)
    : (isPt
        ? `assistir ${nomeDecodificado} ao vivo, assistir ${nomeDecodificado} online gratis, canal ${nomeDecodificado} ao vivo online, onde assistir ${nomeDecodificado}, tv ao vivo online gratis, canais de tv online, multicanaishd tv`
        : `watch ${nomeDecodificado} live, watch ${nomeDecodificado} online free, canal ${nomeDecodificado} live stream free, free live tv online, stream channels online, watch tv live online free`);

---

<BaseLayout
    title={seoTitle}
    description={seoDescription}
    image={canal?.imagem}
    type="video.other"
    keywords={keywords}
    jsonLd={canalJsonLd}
    robots={shouldNoindex ? "noindex, nofollow" : undefined}
>
    <Fragment slot="head">
        <script type="application/ld+json" set:html={JSON.stringify({
            "@context": "https://schema.org",
            "@type": "BreadcrumbList",
            "itemListElement": [
                { "@type": "ListItem", "position": 1, "name": t('nav.home'), "item": siteUrl },
                { "@type": "ListItem", "position": 2, "name": isDynamicChannel ? (isPt ? "Jogos Ao Vivo" : "Live Games") : (isPt ? "Canais de TV" : "TV Channels"), "item": `${siteUrl}${isPt ? '' : '/en'}/canais` },
                { "@type": "ListItem", "position": 3, "name": nomeDecodificado, "item": `${siteUrl}${Astro.url.pathname}` }
            ]
        })}></script>
    </Fragment>

    <main
        class="flex-grow container mx-auto px-4 py-8 mt-24 sm:mt-28 max-w-7xl relative min-h-[500px]"
        data-locked={isChannelLocked}
        data-user-vip={isUserVip}
        data-id={id}
        data-title={nomeDecodificado}
        data-channel-id={id}
        data-image={canal?.imagem}
        data-source-url={embedUrl}
        data-embed-base={getShopUrl()}
        data-embed-key={getEmbedPublicKey()}
        data-embed-kind={isDynamicChannel ? "jogo" : "canal"}
        data-embed-slug={slugify(nomeDecodificado)}
        data-dynamic={isDynamicChannel}
        data-t-locked-toast={t('tv.locked_toast')}
        data-t-authenticating={t('tv.authenticating')}
        data-tuning-prefix={t('tv.tuning_prefix')}
        data-offline-msg={t('tv.offline_msg')}
        data-lang={lang}
    >
        {isExpiredEvent ? (
            <!-- EXPIRATION STATE CARD (Zero-Broken-Images, Highly Optimized) -->
            <div class="flex flex-col items-center justify-center py-12 md:py-20 animate-fade-in relative z-10 w-full">
                <div class="relative w-full max-w-2xl bg-white/[0.02] backdrop-blur-xl border border-white/10 rounded-2xl p-8 md:p-12 text-center shadow-2xl overflow-hidden group">
                    <!-- Glow Accent -->
                    <div class="absolute -top-24 -left-24 w-48 h-48 bg-[#DF0912]/10 rounded-full blur-3xl group-hover:bg-[#DF0912]/20 transition-all duration-700"></div>
                    <div class="absolute -bottom-24 -right-24 w-48 h-48 bg-red-600/10 rounded-full blur-3xl group-hover:bg-red-600/20 transition-all duration-700"></div>

                    <!-- Pulsing Badge -->
                    <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-[#DF0912]/10 border border-[#DF0912]/30 text-[#DF0912] text-xs font-black uppercase tracking-wider mb-6 animate-pulse">
                        <span class="w-2.5 h-2.5 rounded-full bg-[#DF0912] shadow-[0_0_8px_#DF0912]"></span>
                        {isPt ? "Transmissão Encerrada" : "Broadcast Ended"}
                    </div>

                    <!-- Title & Description -->
                    <h1 class="text-2xl md:text-4xl font-extrabold text-white mb-4 tracking-tight leading-tight">
                        {isPt ? `Esta partida ao vivo terminou` : `This live match has ended`}
                    </h1>
                    <p class="text-gray-400 text-sm md:text-base max-w-md mx-auto mb-8 font-medium leading-relaxed">
                        {isPt 
                            ? `O evento "${nomeDecodificado}" ou transmissão foi finalizado. Partidas ao vivo e canais esportivos são temporários e transmitidos em tempo real durante o jogo oficial.` 
                            : `The live stream for "${nomeDecodificado}" is no longer active. Sports events and temporary channels are only active during official game hours.`
                        }
                    </p>

                    <!-- Call To Actions -->
                    <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
                        <a 
                            href={`${langPrefix}/canais`} 
                            class="w-full sm:w-auto inline-flex items-center justify-center gap-2.5 px-8 py-4 bg-[#DF0912] hover:bg-red-600 active:scale-95 text-white font-extrabold text-sm uppercase tracking-wider rounded-xl transition-all duration-300 shadow-xl shadow-red-950/20"
                        >
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z" />
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                            </svg>
                            {isPt ? "Ver Canais Ao Vivo" : "View Live Channels"}
                        </a>
                        <a 
                            href={`${langPrefix || "/"}`} 
                            class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-8 py-4 bg-white/[0.04] hover:bg-white/[0.08] border border-white/10 active:scale-95 text-gray-300 hover:text-white font-extrabold text-sm uppercase tracking-wider rounded-xl transition-all duration-300"
                        >
                            {isPt ? "Ir para o Início" : "Back to Home"}
                        </a>
                    </div>
                </div>

                <!-- Premium Channels Recommendation Section -->
                <div class="w-full mt-16 animate-fade-in delay-200">
                    <div class="flex items-center justify-between mb-8 border-b border-white/5 pb-4">
                        <div class="flex items-center gap-3">
                            <div class="w-8 h-8 rounded-lg bg-[#DF0912]/10 border border-[#DF0912]/30 flex items-center justify-center text-[#DF0912]">
                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 4v16M17 4v16M3 8h4m10 0h4M3 12h18M3 16h4m10 0h4M4 20h16a1 1 0 001-1V5a1 1 0 00-1-1H4a1 1 0 00-1 1v14a1 1 0 001 1z" />
                                </svg>
                            </div>
                            <h2 class="text-xl md:text-2xl font-black text-white uppercase tracking-tight">
                                {isPt ? "Canais de TV Recomendados" : "Recommended TV Channels"}
                            </h2>
                        </div>
                        <span class="text-xs font-bold text-gray-500 uppercase tracking-widest hidden sm:inline">{canaisTV.filter(c => !String(c.id).startsWith('jogo_')).length} {isPt ? "Canais Disponíveis" : "Channels Available"}</span>
                    </div>

                    <!-- TV Channels Grid -->
                    <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-6 gap-4 w-full">
                        {canaisTV
                            .filter(c => !String(c.id).startsWith('jogo_'))
                            .slice(0, 12)
                            .map((c) => {
                                const isVip = isVipChannel(c, vipIds);
                                return (
                                    <a
                                        href={`${langPrefix}/canal/${slugify(c.nome)}`}
                                        data-is-vip={isVip}
                                        class="group relative bg-[#161B28]/60 hover:bg-[#161B28] border border-white/5 hover:border-[#DF0912]/30 rounded-xl p-4 flex flex-col items-center text-center transition-all duration-300 hover:scale-[1.03] hover:shadow-xl hover:shadow-black/40 overflow-hidden"
                                    >
                                        <!-- VIP Tag -->
                                        {isVip && (
                                            <span class="absolute top-2.5 right-2.5 px-1.5 py-0.5 bg-[#DF0912]/20 border border-[#DF0912]/40 rounded text-[8px] font-black text-[#DF0912] uppercase tracking-wider">VIP</span>
                                        )}
                                        
                                        <!-- Channel Logo -->
                                        <div class="w-16 h-16 rounded-lg bg-black/20 flex items-center justify-center p-2 border border-white/5 group-hover:border-white/10 mb-4 transition-colors">
                                            <img
                                                src={c.imagem || "/placeholder.jpg"}
                                                alt={c.nome}
                                                class="w-full h-full object-contain filter group-hover:scale-105 transition-transform"
                                                loading="lazy"
                                                onerror="this.src='/placeholder.jpg'"
                                            />
                                        </div>
                                        
                                        <!-- Channel Info -->
                                        <h3 class="text-sm font-bold text-gray-200 group-hover:text-white line-clamp-1 mb-1 truncate w-full">
                                            {c.nome}
                                        </h3>
                                        <p class="text-[10px] text-gray-500 font-semibold uppercase tracking-wider">
                                            {c.categoria}
                                        </p>
                                        
                                        <!-- Hover Arrow Animation -->
                                        <div class="absolute bottom-2 right-2 opacity-0 group-hover:opacity-100 transition-all duration-300 transform translate-x-2 group-hover:translate-x-0">
                                            <svg class="w-3.5 h-3.5 text-[#DF0912]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                                            </svg>
                                        </div>
                                    </a>
                                );
                            })
                        }
                    </div>
                </div>
            </div>
        ) : (
            <!-- 1. Loader de Verificação -->
            <div id="player-vip-loader" class="absolute inset-0 z-[60] flex flex-col items-center justify-center bg-[#060911] transition-opacity duration-500">
                <div class="w-12 h-12 border-4 border-[#DF0912] border-t-transparent rounded-full animate-spin mb-6"></div>
                <p class="text-gray-500 text-[10px] font-black uppercase tracking-[0.4em] animate-pulse">{t('tv.authenticating')}</p>
            </div>

            <!-- 2. Container do Player (Bloqueado por Padrão) -->
            <div id="canal-player-container" class="hidden opacity-0 transition-opacity duration-700 grid grid-cols-1 lg:grid-cols-4 gap-6 h-full">
                <div class="lg:col-span-3 flex flex-col gap-4">
                    <div
                        id="playerWrapper"
                        class="relative w-full aspect-video bg-black rounded-xl overflow-hidden shadow-2xl shadow-black/50 border border-white/5 group z-10"
                    >
                        <div
                            id="playerLoading"
                            class="absolute inset-0 flex flex-col items-center justify-center bg-[#0a0a0a] z-10 transition-opacity duration-500 pointer-events-none"
                        >
                            <div
                                class="w-12 h-12 border-4 border-[#DF0912] border-t-transparent rounded-full animate-spin mb-4"
                            >
                            </div>
                            <p class="text-gray-400 text-sm animate-pulse">
                                {t('tv.tuning_prefix')} {nomeDecodificado}...
                            </p>
                        </div>

                        <iframe
                            id="playerFrame"
                            src=""
                            title={`${t('tv.watch_title_prefix')} ${nomeDecodificado}`}
                            allow="autoplay; fullscreen; encrypted-media; picture-in-picture; accelerometer; gyroscope; clipboard-write; web-share"
                            allowfullscreen="true"
                            webkitallowfullscreen="true" 
                            mozallowfullscreen="true"
                            class="absolute top-0 left-0 w-full h-full z-10"
