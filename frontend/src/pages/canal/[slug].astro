                    </div>

                    {currentNowPlaying && (
                        <div class="bg-[#161B28] p-4 rounded-xl border border-white/5">
                            <div class="flex items-center gap-2 mb-2">
                                <span class="w-2 h-2 rounded-full bg-[#DF0912] animate-pulse"></span>
                                <span class="text-[10px] font-black text-[#DF0912] uppercase tracking-widest">
                                    {isPt ? "Agora Passando" : "Now Playing"}
                                </span>
