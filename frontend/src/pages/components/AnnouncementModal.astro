---
// src/pages/components/AnnouncementModal.astro
---

<div id="announce-modal-overlay" class="fixed inset-0 z-[300] hidden items-center justify-center bg-black/85 backdrop-blur-md transition-opacity duration-500">
    <div id="announce-modal-content" class="relative w-[92%] max-w-2xl max-h-[90dvh] overflow-y-auto rounded-[1.5rem] sm:rounded-[2.5rem] border border-white/10 bg-[#0f0f0f] shadow-[0_0_100px_rgba(0,0,0,0.8)] scale-95 opacity-0 transition-all duration-500 scrollbar-hide">
        
        <!-- Background Glows -->
        <div class="absolute -top-24 -left-24 w-64 h-64 bg-red-600/10 rounded-full blur-[100px]"></div>
        <div class="absolute -bottom-24 -right-24 w-64 h-64 bg-blue-600/10 rounded-full blur-[100px]"></div>

        <!-- Close Button -->
        <button id="announce-modal-close" class="absolute right-4 top-4 sm:right-6 sm:top-6 z-50 w-10 h-10 flex items-center justify-center rounded-full bg-white/5 hover:bg-white/10 text-gray-400 hover:text-white transition-all group" aria-label="Fechar">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 group-hover:rotate-90 transition-transform duration-300" fill="none" viewBox="0 0 24 24" stroke="currentColor">
               <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M6 18L18 6M6 6l12 12" />
            </svg>
        </button>

        <div class="relative z-10 p-6 sm:p-12">
            <div class="mb-10">
                <span class="inline-block px-4 py-1.5 rounded-full bg-red-500/10 border border-red-500/20 text-red-500 text-[10px] font-black uppercase tracking-widest mb-4">Novidades 2026</span>
                <h2 class="text-2xl sm:text-5xl font-black text-white tracking-tighter leading-none mb-4">
                    O MultiCanaisHD evoluiu. <br/> <span class="text-transparent bg-clip-text bg-gradient-to-r from-red-500 to-white">Veja o que há de novo!</span>
                </h2>
                <p class="text-gray-400 text-sm sm:text-base leading-relaxed max-w-lg">
                    Lançamos novos recursos focados em você, usuário VIP, e na nossa comunidade de desenvolvedores.
                </p>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <!-- VIP Card -->
                <div class="group relative p-6 rounded-3xl bg-gradient-to-br from-red-600/20 to-transparent border border-red-500/20 hover:border-red-500/40 transition-all duration-300">
                    <div class="w-12 h-12 rounded-2xl bg-red-500 flex items-center justify-center text-white mb-6 shadow-lg shadow-red-900/40 group-hover:scale-110 transition-transform">
                        <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2L1 12h3v9h6v-6h4v6h6v-9h3L12 2z"/></svg>
                    </div>
                    <h3 class="text-xl font-bold text-white mb-2 tracking-tight">MultiCanaisHD VIP</h3>
                    <p class="text-gray-400 text-xs leading-relaxed mb-6">Tenha acesso a canais exclusivos e jogos ao vivo, sem anúncios e muito mais.</p>
                    <button id="announce-modal-vip" class="flex w-full items-center justify-center gap-2 rounded-xl bg-red-600 px-4 py-3 text-xs font-black text-white uppercase tracking-widest transition-all hover:bg-red-700 hover:shadow-lg hover:shadow-red-900/40">
                        Seja VIP Agora
                    </button>
                </div>

                <!-- API Card -->
                <div class="group relative p-6 rounded-3xl bg-white/5 border border-white/5 hover:border-white/10 transition-all duration-300">
                    <div class="w-12 h-12 rounded-2xl bg-white/10 flex items-center justify-center text-white mb-6 group-hover:scale-110 transition-transform">
                        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4" /></svg>
                    </div>
                    <h3 class="text-xl font-bold text-white mb-2 tracking-tight">API Gratuita</h3>
                    <p class="text-gray-400 text-xs leading-relaxed mb-6">Integre nosso catálogo de filmes, séries e animes, canais de tv e jogos ao vivo em seu site de graça com nosso player robusto.</p>
                    <a href="https://streambetter.lol" target="_blank" rel="noopener" id="announce-modal-api" class="flex w-full items-center justify-center gap-2 rounded-xl bg-white/5 px-4 py-3 text-xs font-black text-white uppercase tracking-widest transition-all hover:bg-white/10 border border-white/10">
                        Explorar API
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    function initAnnounceModal() {
        const modalId = "bf_announcement_v1_seen";
        // Usamos sessionStorage para mostrar apenas uma vez por "sessão" (aba aberta)
        if (sessionStorage.getItem(modalId)) return;

        // [VIP FIX] Não mostra anúncios de "Novidades" (que promovem o VIP) para quem já é VIP
        let sessionData = {};
        try {
            const raw = localStorage.getItem('bf_session_optimistic');
            if (raw && raw !== 'undefined') {
                sessionData = JSON.parse(raw) || {};
            }
        } catch (e) {}
        if (sessionData.isVIP === true) return;

        const overlay = document.getElementById("announce-modal-overlay");
        const content = document.getElementById("announce-modal-content");
        const closeBtn = document.getElementById("announce-modal-close");
        const vipBtn = document.getElementById("announce-modal-vip");
        const apiBtn = document.getElementById("announce-modal-api");

        if (!overlay || !content) return;

        const closeModal = () => {
            content.classList.remove("scale-100", "opacity-100");
            content.classList.add("scale-95", "opacity-0");
            sessionStorage.setItem(modalId, "true");
            
            setTimeout(() => {
                overlay.classList.remove("flex");
                overlay.classList.add("hidden");
            }, 500);
        };

        // Mostra o modal após um longo delay (30s) apenas para humanos
        const isBot = navigator.webdriver === true || /lighthouse|pagespeed|bot|crawler|spider/i.test(navigator.userAgent);

        if (isBot) return;

        // Inicia a contagem regressiva de 30 segundos apenas após a primeira interação real do usuário
        const triggerEvents = ['mousedown', 'keydown', 'touchstart', 'scroll'];
        let timer;
        const startTimer = () => {
            triggerEvents.forEach(e => window.removeEventListener(e, startTimer));
            
            timer = setTimeout(() => {
                overlay.classList.remove("hidden");
                overlay.classList.add("flex");
                
                setTimeout(() => {
                    content.classList.remove("scale-95", "opacity-0");
                    content.classList.add("scale-100", "opacity-100");
                }, 50);
            }, 30000);
        };

        triggerEvents.forEach(e => window.addEventListener(e, startTimer, { passive: true, once: true }));

        closeBtn?.addEventListener("click", () => {
            triggerEvents.forEach(e => window.removeEventListener(e, startTimer));
            clearTimeout(timer);
            closeModal();
        });
        apiBtn?.addEventListener("click", () => {
            triggerEvents.forEach(e => window.removeEventListener(e, startTimer));
            clearTimeout(timer);
            closeModal();
        });
        
        vipBtn?.addEventListener("click", () => {
            triggerEvents.forEach(e => window.removeEventListener(e, startTimer));
            clearTimeout(timer);
            closeModal();
            // Dispara o evento global para abrir o modal de VIP
            document.dispatchEvent(new CustomEvent('multicanaishd:open-vip'));
        });
        
        overlay.addEventListener("click", (e) => {
            if (e.target === overlay) {
                triggerEvents.forEach(e => window.removeEventListener(e, startTimer));
                clearTimeout(timer);
                closeModal();
            }
        });
    }

    document.addEventListener("astro:page-load", initAnnounceModal);
</script>
