                                        </svg>
                                        <span class="text-[9px] font-black text-white uppercase tracking-wider italic">{status.label}</span>
                                    </div>
                                )}
                            </div>

                            {/* League Badge */}
                            <div class="absolute top-3 right-3 z-20">
                                <div class="bg-black/60 px-2.5 py-1.5 border border-white/10">
                                    <span class="text-[8px] font-black text-white/80 uppercase tracking-wider truncate max-w-[100px] block">
                                        {league}
                                    </span>
                                </div>
                            </div>

                            {/* VIP Badge */}
                            {isVip && (
                                <div class="absolute bottom-3 right-3 z-20">
                                    <div class="bg-black rounded-lg p-2 shadow-2xl border border-white/5 group-hover:scale-110 transition-transform duration-300">
                                        <svg class="w-4 h-4 text-[#DF0912]" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
                                    </div>
                                </div>
                            )}

                            {/* Content - Clean Design */}
                            <div class="p-5 pt-12 aspect-square flex flex-col justify-center">
                                {/* Teams */}
                                <div class="flex items-center justify-center gap-4 sm:gap-6">
                                    {/* Home Team */}
                                    <div class="flex flex-col items-center gap-3">
                                        {homeTeam?.image ? (
                                            <div class="w-20 h-20 bg-white/5 rounded-full p-3 border border-white/10 group-hover:border-[#DF0912]/40 group-hover:bg-white/10 transition-all duration-300">
                                                <img
                                                    src={homeTeam.image?.includes('cloudfront.net') ? `${homeTeam.image}?w=96&h=96&fit=max` : homeTeam.image}
                                                    alt={homeTeam.name}
