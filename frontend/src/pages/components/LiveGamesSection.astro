---
import { slugify } from '../../utils/slugify';
// src/pages/components/LiveGamesSection.astro
// Seção de Jogos Ao Vivo - Cards fixos premium

import { fetchTodayRelevantGames, isGameLive } from '../../services/liveGamesService';
import { fetchVipChannels } from '../../services/channelsService.js';

// i18n
import { getLangFromUrl, useTranslations } from "../../i18n/utils";
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const isPt = lang === "pt";
const langPrefix = isPt ? "" : `/${lang}`;

const { initialGames = null, initialVipIds = null } = Astro.props;

const normalizeVipKey = (value) => {
    if (value === null || value === undefined) return '';
    return String(value)
        .toLowerCase()
        .trim()
        .normalize('NFD')
        .replace(/[\u0300-\u036f]/g, '')
        .replace(/[^a-z0-9]+/g, '-')
        .replace(/^-+|-+$/g, '');
};

const buildVipCandidates = (rawId, title) => {
    const candidates = new Set();
    const push = (v) => {
        if (!v) return;
        const raw = String(v).trim();
        if (!raw) return;
        candidates.add(raw);
        const normalized = normalizeVipKey(raw);
        if (normalized) candidates.add(normalized);
    };
    push(rawId);
    if (title) {
        const titleSlug = slugify(title);
        push(titleSlug);
        push(`jogo_${titleSlug}`);
    }
    return candidates;
};

// Buscar IDs VIP no SSR (Cached & Timeout-Safe)
let vipIds = new Set();
let vipIdsArray = [];
try {
    const vipData = initialVipIds || await fetchVipChannels();
    vipIdsArray = (vipData || []).map((id) => String(id));
    vipIds = new Set(vipIdsArray.flatMap((id) => [id, normalizeVipKey(id)]).filter(Boolean));
} catch (e) {
    console.error('[LiveGamesSection] Erro ao buscar VIPs:', e);
}

let liveGames = [];
if (initialGames) {
    liveGames = initialGames;
} else {
    try {
        liveGames = await fetchTodayRelevantGames();
    } catch (e) {
        console.error("[LiveGamesSection] Erro SSR:", e);
        liveGames = [];
    }
}
// Helper para normalizar timestamps para segundos (Pilar 4: Consistência de Dados)
const normalizeTimestamp = (ts) => {
    if (!ts) return 0;
    const num = Number(ts);
    return num > 9999999999 ? Math.floor(num / 1000) : num;
};

// A fonte não manda mais timer.end — sem isso assumimos 2h30 de duração (mesmo fallback
// do recovery client-side), senão todo jogo cai em "unknown" e nunca aparece como ao vivo/encerrado.
const DEFAULT_GAME_DURATION = 9000;
function resolveGameEnd(start, endRaw) {
    const end = normalizeTimestamp(endRaw);
    if (end) return end;
    return start ? start + DEFAULT_GAME_DURATION : 0;
}

// Helper para peso do status (Pilar 5: Inteligência de Negócio)
function getStatusWeight(game) {
    const start = normalizeTimestamp(game?.data?.timer?.start);
    const end = resolveGameEnd(start, game?.data?.timer?.end);
    const now = Math.floor(Date.now() / 1000);

    if (!start || !end) return 1; // unknown tratamos como upcoming
    if (now >= start && now <= end) return 0; // Ao Vivo
    if (now < start) return 1; // Próximo
    return 2; // Encerrado — removido imediatamente, sem ocupar vaga de jogo ao vivo
}

// Filtra os jogos encerrados (Pilar 5: Inteligência de Negócio)
liveGames = liveGames.filter(game => getStatusWeight(game) !== 2);

// Ordena os jogos: Ao Vivo (0) > Próximos (1) > Encerrados (2)
liveGames.sort((a, b) => {
    const weightA = getStatusWeight(a);
    const weightB = getStatusWeight(b);
    
    if (weightA !== weightB) {
        return weightA - weightB;
    }
    
    // Se ambos forem próximos, ordena pelo mais próximo de começar
    if (weightA === 1) {
        const startA = normalizeTimestamp(a?.data?.timer?.start) || 0;
        const startB = normalizeTimestamp(b?.data?.timer?.start) || 0;
        return startA - startB;
    }
    
    return 0;
});

// Limita a 8 jogos para não sobrecarregar (Pilar 4: Otimização)
const displayGames = liveGames.slice(0, 4);

// Helper para verificar status do jogo
function getGameStatus(game) {
    const start = normalizeTimestamp(game?.data?.timer?.start);
    const end = resolveGameEnd(start, game?.data?.timer?.end);

    if (!start || !end) {
        return { type: 'unknown', label: t('live.match_start').toUpperCase() };
    }
    
    const now = Math.floor(Date.now() / 1000);
    
    if (now >= start && now <= end) {
        return { type: 'live', label: t('live.status_live') };
    }
    if (now < start) {
        const diffMin = Math.ceil((start - now) / 60);
        
        if (diffMin > 60) {
            const date = new Date(start * 1000);
            const timeStr = date.toLocaleTimeString('pt-BR', { 
                hour: '2-digit', 
                minute: '2-digit', 
                hour12: false, 
                timeZone: 'America/Sao_Paulo' 
            });
            return { 
                type: 'upcoming', 
                label: `${t('live.at')} ${timeStr}` 
            };
        }
        
        return { type: 'upcoming', label: `${t('live.in')} ${diffMin}${t('live.min')}` };
    }
    return { type: 'ended', label: t('live.status_ended') };
}

// Helper para gerar ID do canal igual ao channelsService.js
function generateCanalId(title) {
    if (!title) return 'jogo_unknown';
    return `jogo_${title.toLowerCase().trim().normalize('NFD').replace(/[\u0300-\u036f]/g, "").replace(/ /g, '-').replace(/[^\w-]/g, '')}`;
}

// Extrai times do título "Time A x Time B"
function parseTeamsFromTitle(title) {
    if (!title) return { home: { name: null, image: null }, away: { name: null, image: null } };
    const parts = title.split(/\s+[xX]\s+/);
    return {
        home: { name: parts[0]?.trim() || null, image: null },
        away: { name: parts[1]?.trim() || null, image: null },
    };
}

// Helper para formatar hora (HH:mm)
function formatUnixTime(timestamp) {
    const ts = normalizeTimestamp(timestamp);
    if (!ts) return "";
    try {
        const date = new Date(ts * 1000);
        return date.toLocaleTimeString('pt-BR', { 
            hour: '2-digit', 
            minute: '2-digit', 
            hour12: false,
            timeZone: 'America/Sao_Paulo'
        });
    } catch (e) {
        return "";
    }
}
---

