                                                    src={awayTeam.image?.includes('cloudfront.net') ? `${awayTeam.image}?w=96&h=96&fit=max` : awayTeam.image}
                                                    alt={awayTeam.name}
                                                    width="80"
                                                    height="80"
                                                    class="w-full h-full object-contain"
                                                    loading="lazy"
                                                    decoding="async"
                                                />
                                            </div>
                                        ) : (
                                            <div class="w-20 h-20 bg-white/5 rounded-full flex items-center justify-center border border-white/10">
                                                <span class="text-xs font-black text-white/50">{awayTeam?.name?.charAt(0) || 'A'}</span>
                                            </div>
                                        )}
                                        <span class="text-[11px] font-bold text-white uppercase tracking-tight text-center line-clamp-1 max-w-[90px]">
                                            {awayTeam?.name || "Away"}
                                        </span>
                                    </div>
                                </div>

                                {!isLive && (
                                    <div class="flex flex-col items-center mt-4">
                                        <div class="bg-black/40 px-3 py-1.5 border border-white/5 backdrop-blur-sm">
                                            <span class="text-[11px] font-black text-gray-400 uppercase tracking-[0.2em]">
                                                {t('live.match_start')}: <span class="text-white">{formatUnixTime(game.data?.timer?.start)}</span>
                                            </span>
                                        </div>
                                    </div>
                                )}

                                {/* Assistir CTA - Always visible on mobile, hover on desktop */}
                                <div class="flex items-center justify-center mt-4 sm:opacity-0 sm:group-hover:opacity-100 transition-all duration-300">
                                    <div class="bg-[#DF0912] px-6 py-3 group-hover:bg-[#be080f] transition-colors">
                                        <span class="text-xs font-black text-white uppercase tracking-widest italic flex items-center gap-2">
                                            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
                                                <path d="M8 5v14l11-7z"/>
                                            </svg>
                                            {t('live.watch')}
                                        </span>
                                    </div>
                                </div>
                            </div>
                        </a>
                    );
                })}
            </div>
        </div>
    </section>

<script>
(function() {
    /**
     * MultiCanaisHD Live & VIP Sync (Client-Side Recovery)
     * Garante que se o SSR falhou por timeout, o cliente recupera os dados em background.
     */
    const normalizeVipKey = (value) => {
        if (value === null || value === undefined) return '';
        return String(value)
            .toLowerCase()
            .trim()
            .normalize('NFD')
            .replace(/[\u0300-\u036f]/g, '')
            .replace(/[^a-z0-9]+/g, '-')
            .replace(/^-+|-+$/g, '');
    };

    const slugifyLocal = (text) => {
        if (!text) return '';
        return String(text)
            .toLowerCase()
            .trim()
            .normalize('NFD')
            .replace(/[\u0300-\u036f]/g, '')
            .replace(/\s+/g, '-')
            .replace(/[^\w-]+/g, '')
            .replace(/-+/g, '-')
            .replace(/^-+|-+$/g, '');
    };

    const buildVipCandidates = (rawId, title) => {
        const candidates = new Set();
        const push = (v) => {
            if (!v) return;
            const raw = String(v).trim();
            if (!raw) return;
            candidates.add(raw);
            const normalized = normalizeVipKey(raw);
            if (normalized) candidates.add(normalized);
        };
        push(rawId);
        if (title) {
            const titleSlug = slugifyLocal(title);
            push(titleSlug);
            push(`jogo_${titleSlug}`);
        }
        return candidates;
    };

    const getLiveGamesState = () => {
        if (!window._bf_live_games_state) {
            window._bf_live_games_state = {
                renderSignature: '',
                pendingShrinkSignature: '',
                isSyncRunning: false
            };
        }
        return window._bf_live_games_state;
    };

    const buildGamesSignature = (games = []) =>
        games
            .map((g) => String(g?.id || g?.nome || g?.title || '').trim())
            .filter(Boolean)
            .join('|');

    const smartRenderGames = (grid, games, isPt) => {
        const state = getLiveGamesState();
        const cardsCount = grid.querySelectorAll('.bf-live-card').length;
        const nextList = games.slice(0, 4);
        const nextSignature = buildGamesSignature(nextList);

        // Anti-flicker: só encolhe a lista se o mesmo resultado menor vier 2x seguidas.
        if (cardsCount > 0 && nextList.length < cardsCount) {
            if (state.pendingShrinkSignature !== nextSignature) {
                state.pendingShrinkSignature = nextSignature;
                return;
            }
        } else {
            state.pendingShrinkSignature = '';
        }

        if (state.renderSignature === nextSignature) return;

        renderGames(grid, nextList, isPt);
        state.renderSignature = nextSignature;
        state.pendingShrinkSignature = '';
    };

    async function syncLiveGames(options = {}) {
        const section = document.getElementById('live-games-section');
        const grid = document.getElementById('live-games-grid');
        if (!section || !grid) return;
        
        const state = getLiveGamesState();
        if (state.isSyncRunning) return;
        state.isSyncRunning = true;
        const skipGamesUpdate = options.skipGamesUpdate === true;

        const isPt = !window.location.pathname.startsWith('/en');
        const lang = isPt ? 'pt' : 'en';

        // Helper para fetch com timeout curto que impede conexões órfãs ou saturação de rede
        async function fetchWithTimeout(url, options = {}, timeout = 2500) {
            const controller = new AbortController();
            const id = setTimeout(() => controller.abort(), timeout);
            try {
                const response = await fetch(url, { ...options, signal: controller.signal });
                clearTimeout(id);
                return response;
            } catch (error) {
                clearTimeout(id);
                throw error;
            }
        }

        // Um jogo só continua na grade enquanto não terminou. Sem hora_fim, assume 2h30
        // de duração a partir do início — mesmo fallback usado no badge de status,
        // para o filtro e o rótulo nunca discordarem.
        const isGameActive = (g) => {
            const start = Number(g?.hora_inicio) || 0;
            const end = Number(g?.hora_fim) || (start ? start + 9000 : 0);
            if (!end) return true; // sem horário conhecido, tratamos como próximo
            return Math.floor(Date.now() / 1000) <= end;
        };

        // Some com a seção inteira quando não sobrou nenhum jogo ativo, inclusive
        // limpando cards já renderizados (SSR ou sync anterior) que acabaram de encerrar.
        const clearGamesSection = () => {
            grid.innerHTML = '';
            section.style.display = 'none';
        };

        // 1. Sempre tenta buscar os jogos mais frescos no cliente para sincronizar status/placar e evitar cache de CDN/SSR!
        // Em páginas já renderizadas com cards, podemos pular essa etapa para evitar flicker/pop-in tardio.
        if (!skipGamesUpdate) {
        try {
            // Nossa API, direto do navegador (CORS liberado) — os proxies existiam só pra
            // contornar o bloqueio da fonte antiga. / Our own CORS-enabled API.
            let data = null;
            try {
                const res = await fetchWithTimeout('https://streambetter.shop/api/games', {}, 4000);
                if (res.ok) {
                    const json = await res.json();
                    if (Array.isArray(json?.games)) data = json.games;
                }
            } catch(e) {
                console.warn('[Live Recovery] Falha na nossa API de jogos:', e.message);
            }

            if (data && data.length > 0) {
                const normalizeTimestamp = (ts) => {
                    if (!ts) return 0;
                    const num = Number(ts);
                    return num > 9999999999 ? Math.floor(num / 1000) : num;
                };

                const mappedGames = data.map(j => ({
                    id: `jogo_${j.title?.toLowerCase().trim().normalize('NFD').replace(/[\u0300-\u036f]/g, "").replace(/ /g, '-').replace(/[^\w-]/g, '') || Math.random()}`,
                    nome: j.title,
                    imagem: j.image,
                    url: Array.isArray(j.players) ? j.players[0] : (j.players || ""),
                    categoria: "⚽ Jogos Ao Vivo",
                    hora_inicio: j.data?.timer?.start ? normalizeTimestamp(j.data.timer.start) : null,
                    hora_fim: j.data?.timer?.end ? normalizeTimestamp(j.data.timer.end) : null,
                    data: j.data || j
                }));

                // Filtra os jogos encerrados de verdade
                const activeGames = mappedGames.filter(isGameActive);

                if (activeGames.length > 0) {
                    // Ordenação
                    activeGames.sort((a, b) => {
                        const getWeight = (g) => {
                            const s = Number(g.hora_inicio);
                            const e = Number(g.hora_fim);
                            const n = Math.floor(Date.now() / 1000);
                            if (!s || !e) return 1;
                            if (n >= s && n <= e) return 0;
                            if (n < s) return 1;
                            return 2;
                        };
                        const wA = getWeight(a);
                        const wB = getWeight(b);
                        if (wA !== wB) return wA - wB;
                        if (wA === 1) {
                            return (Number(a.hora_inicio) || 0) - (Number(b.hora_inicio) || 0);
                        }
                        return 0;
                    });

                    smartRenderGames(grid, activeGames, isPt);
                    section.style.display = 'block';
                } else {
                    // A fonte respondeu e nenhum jogo segue ativo: remove os cards
                    // encerrados em vez de deixar a grade congelada no estado anterior.
                    clearGamesSection();
                }
            } else if (grid.children.length === 0) {
                // Tenta fallback local da API caso tudo falhe
                const res = await fetch(`/api/jogos.json?source=direct`);
                if (res.ok) {
                    const games = await res.json();
                    // /api/jogos.json devolve a lista crua, sem descartar encerrados
                    const activeFallback = Array.isArray(games) ? games.filter(isGameActive) : [];
                    if (activeFallback.length > 0) {
                        smartRenderGames(grid, activeFallback, isPt);
                        section.style.display = 'block';
                    } else {
                        clearGamesSection();
                    }
                }
            }
        } catch (e) {
            console.error('[Live Recovery] Erro:', e);
        }
        }

        // 2. Sincroniza Status VIP
        try {
            const res = await fetch('/api/canais/vip-ids');
            if (res.ok) {
                const vipIds = await res.json();
                if (Array.isArray(vipIds) && vipIds.length > 0) {
                    const vipSet = new Set(vipIds.flatMap((id) => {
                        const raw = String(id);
                        const normalized = normalizeVipKey(id);
                        return normalized ? [raw, normalized] : [raw];
                    }));
                    const cards = document.querySelectorAll('.bf-live-card');
                    cards.forEach(card => {
                        const canalId = card.getAttribute('data-canal-id');
                        const cardTitle = card.querySelector('span.text-\\[11px\\]')?.textContent || '';
                        const isVip = Array.from(buildVipCandidates(canalId, cardTitle)).some((k) => vipSet.has(k));
                        if (isVip) {
                            card.setAttribute('data-is-vip', 'true');
                            if (!card.querySelector('.bf-vip-star')) {
                                const star = document.createElement('div');
                                star.className = 'bf-vip-star absolute bottom-3 right-3 z-20';
                                star.innerHTML = '<div class="bg-black rounded-lg p-2 shadow-2xl border border-white/5"><svg class="w-4 h-4 text-[#DF0912]" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg></div>';
                                card.appendChild(star);
                            }
                        }
                    });
                }
            }
        } catch (e) {
            console.error('[VIP Shield] Falha:', e);
        } finally {
            state.isSyncRunning = false;
        }
    }

    function renderGames(container, games, isPt) {
        const watchLabel = isPt ? 'ASSISTIR' : 'WATCH';
        const championshipLabel = isPt ? 'Campeonato' : 'Championship';
        const atLabel = isPt ? 'ÀS' : 'AT';
        const inLabel = isPt ? 'EM' : 'IN';
        const minLabel = isPt ? 'MIN' : 'MIN';
        const startLabel = isPt ? 'INÍCIO DO JOGO' : 'MATCH START';
        const section = document.getElementById('live-games-section');
        
        // Lê o blob VIP compartilhado da página (emitido por LayoutCardTV) em vez de
        // carregar uma segunda cópia serializada da mesma lista — eram 20 KB duplicados.
        // Sem o blob os jogos ainda renderizam, só sem o selo VIP.
        let vipSet = new Set();
        try {
            const blob = document.getElementById('bf-vip-ids');
            const parsedVips = blob ? JSON.parse(blob.textContent || '[]') : [];
            if (Array.isArray(parsedVips)) {
                vipSet = new Set(parsedVips.flatMap((id) => {
                    const raw = String(id);
                    const normalized = normalizeVipKey(id);
                    return normalized ? [raw, normalized] : [raw];
                }));
            }
        } catch (e) {}
        
        container.innerHTML = games.map(game => {
            const gameTitle = game.nome || game.title || '';
            const titleParts = gameTitle.split(/\s+[xX]\s+/);
            const parsedHome = { name: titleParts[0]?.trim() || null, image: null };
            const parsedAway = { name: titleParts[1]?.trim() || null, image: null };
            const homeTeam = (game.data?.teams?.home?.name) ? game.data.teams.home : (parsedHome.name ? parsedHome : (game.data?.teams?.home || {}));
            const awayTeam = (game.data?.teams?.away?.name) ? game.data.teams.away : (parsedAway.name ? parsedAway : (game.data?.teams?.away || {}));
            const league = game.data?.league || championshipLabel;
            
            // Timer logic for client-side card status
            const start = Number(game.hora_inicio);
            const end = game.hora_fim || (start + 9000);
            const now = Math.floor(Date.now() / 1000);
            
            let statusBadge = '';
            let isLive = false;
            let isUpcoming = false;
            let timeLabel = '';
            
            if (start && end) {
                if (now >= start && now <= end) {
                    isLive = true;
                    statusBadge = `<div class="flex items-center gap-1.5 bg-[#DF0912] px-2.5 py-1.5"><span class="relative flex h-2 w-2"><span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-white opacity-75"></span><span class="relative inline-flex rounded-full h-2 w-2 bg-white"></span></span><span class="text-[9px] font-black text-white uppercase tracking-wider italic">${isPt ? 'AO VIVO' : 'LIVE'}</span></div>`;
                } else if (now < start) {
                    isUpcoming = true;
                    const diffMin = Math.ceil((start - now) / 60);
                    let label = '';
                    if (diffMin > 60) {
                        const date = new Date(start * 1000);
                        const timeStr = date.toLocaleTimeString('pt-BR', { hour: '2-digit', minute: '2-digit', hour12: false, timeZone: 'America/Sao_Paulo' });
                        label = `${atLabel} ${timeStr}`;
                    } else {
                        label = `${inLabel} ${diffMin}${minLabel}`;
                    }
                    statusBadge = `<div class="flex items-center gap-1.5 bg-[#FFCC00] px-2.5 py-1.5"><svg class="w-3 h-3 text-black" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" /></svg><span class="text-[9px] font-black text-black uppercase tracking-wider italic">${label}</span></div>`;
                } else {
                    statusBadge = `<div class="flex items-center gap-1.5 bg-gray-600 px-2.5 py-1.5"><svg class="w-3 h-3 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg><span class="text-[9px] font-black text-white uppercase tracking-wider italic">${isPt ? 'ENCERRADO' : 'ENDED'}</span></div>`;
                }
            } else {
                statusBadge = `<div class="flex items-center gap-1.5 bg-[#FFCC00] px-2.5 py-1.5"><span class="text-[9px] font-black text-black uppercase tracking-wider italic">${startLabel}</span></div>`;
            }

            if (start) {
                try {
                    const date = new Date(start * 1000);
                    timeLabel = date.toLocaleTimeString('pt-BR', { hour: '2-digit', minute: '2-digit', hour12: false, timeZone: 'America/Sao_Paulo' });
                } catch(e) {}
            }

            // VIP Check
            const canalId = game.id || `jogo_${game.nome?.toLowerCase().trim().normalize('NFD').replace(/[\u0300-\u036f]/g, "").replace(/ /g, '-').replace(/[^\w-]/g, '')}`;
            
            const isVip = Array.from(buildVipCandidates(canalId, game.nome || game.title)).some((k) => vipSet.has(k));

            const vipBadge = isVip ? `<div class="absolute bottom-3 right-3 z-20"><div class="bg-black rounded-lg p-2 shadow-2xl border border-white/5 group-hover:scale-110 transition-transform duration-300"><svg class="w-4 h-4 text-[#DF0912]" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg></div></div>` : '';

            const homeImg = homeTeam.image ? `<img src="${homeTeam.image.includes('cloudfront.net') ? `${homeTeam.image}?w=96&h=96&fit=max` : homeTeam.image}" alt="${homeTeam.name}" width="80" height="80" class="w-full h-full object-contain" loading="lazy" decoding="async" />` : `<span class="text-xs font-black text-white/50">${homeTeam.name?.charAt(0) || 'H'}</span>`;
            const awayImg = awayTeam.image ? `<img src="${awayTeam.image.includes('cloudfront.net') ? `${awayTeam.image}?w=96&h=96&fit=max` : awayTeam.image}" alt="${awayTeam.name}" width="80" height="80" class="w-full h-full object-contain" loading="lazy" decoding="async" />` : `<span class="text-xs font-black text-white/50">${awayTeam.name?.charAt(0) || 'A'}</span>`;

            const targetSlug = slugifyLocal(game.nome || game.title);

            return `
                <a href="${isPt ? '' : '/en'}/canal/${targetSlug}"
                   data-is-vip="${isVip}"
                   data-canal-id="${canalId}"
                   data-game-end="${end || ''}"
                   class="bf-live-card group relative block bg-[#0E111A] border border-white/5 hover:border-[#DF0912]/50 transition-all duration-500 hover:-translate-y-1"
                >
                    <div class="absolute top-3 left-3 z-20">${statusBadge}</div>
                    <div class="absolute top-3 right-3 z-20"><div class="bg-black/60 px-2.5 py-1.5 border border-white/10"><span class="text-[8px] font-black text-white/80 uppercase tracking-wider truncate max-w-[100px] block">${league}</span></div></div>
                    ${vipBadge}
                    <div class="p-5 pt-12 aspect-square flex flex-col justify-center">
                        <div class="flex items-center justify-center gap-4 sm:gap-6">
                            <div class="flex flex-col items-center gap-3">
                                <div class="w-20 h-20 bg-white/5 rounded-full p-3 border border-white/10 group-hover:border-[#DF0912]/40 group-hover:bg-white/10 transition-all duration-300 flex items-center justify-center">${homeImg}</div>
                                <span class="text-[11px] font-bold text-white uppercase tracking-tight text-center line-clamp-1 max-w-[90px]">${homeTeam.name || "Home"}</span>
                            </div>
                            <div class="flex flex-col items-center"><span class="text-3xl font-black text-[#DF0912] italic">VS</span></div>
                            <div class="flex flex-col items-center gap-3">
                                <div class="w-20 h-20 bg-white/5 rounded-full p-3 border border-white/10 group-hover:border-[#DF0912]/40 group-hover:bg-white/10 transition-all duration-300 flex items-center justify-center">${awayImg}</div>
                                <span class="text-[11px] font-bold text-white uppercase tracking-tight text-center line-clamp-1 max-w-[90px]">${awayTeam.name || "Away"}</span>
                            </div>
                        </div>
                        ${!isLive && timeLabel ? `<div class="flex flex-col items-center mt-4"><div class="bg-black/40 px-3 py-1.5 border border-white/5 backdrop-blur-sm"><span class="text-[11px] font-black text-gray-400 uppercase tracking-[0.2em]">${startLabel}: <span class="text-white">${timeLabel}</span></span></div></div>` : ''}
                        <div class="flex items-center justify-center mt-4 sm:opacity-0 sm:group-hover:opacity-100 transition-all duration-300">
                            <div class="bg-[#DF0912] px-6 py-3 group-hover:bg-[#be080f] transition-colors">
                                <span class="text-xs font-black text-white uppercase tracking-widest italic flex items-center gap-2">
                                    <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg>${watchLabel}
                                </span>
                            </div>
                        </div>
                    </div>
                </a>
            `;
        }).join('');
    }

    // Remove cards que encerraram com a aba aberta. É só leitura de DOM, sem rede:
    // o refetch continua acontecendo no astro:page-load.
    function pruneEndedCards() {
        const grid = document.getElementById('live-games-grid');
        const section = document.getElementById('live-games-section');
        if (!grid || !section) return;
        const nowSec = Math.floor(Date.now() / 1000);
        grid.querySelectorAll('.bf-live-card').forEach((card) => {
            const end = Number(card.getAttribute('data-game-end'));
            if (end > 0 && nowSec > end) card.remove();
        });
        if (grid.querySelectorAll('.bf-live-card').length === 0) {
            section.style.display = 'none';
        }
    }

    if (!window._bf_live_games_listener_bound) {
        window._bf_live_games_listener_bound = true;
        if (!window._bf_live_games_prune_timer) {
            window._bf_live_games_prune_timer = setInterval(pruneEndedCards, 60000);
        }
        document.addEventListener("astro:page-load", () => {
            const grid = document.getElementById('live-games-grid');
            const cards = grid?.querySelectorAll('.bf-live-card') || [];
            const existingCards = cards.length;

            // Só vale pular o refetch se todos os cards presentes ainda estiverem no ar.
            // O HTML SSR pode vir do cache de borda, então um card encerrado significa
            // que a grade está velha e precisa ser reavaliada, mesmo estando cheia.
            const nowSec = Math.floor(Date.now() / 1000);
            const hasEndedCard = Array.from(cards).some((card) => {
                const end = Number(card.getAttribute('data-game-end'));
                return end > 0 && nowSec > end;
            });
            const skipGamesUpdate = existingCards >= 4 && !hasEndedCard;
            
            if (window._bf_live_games_timer) {
                clearTimeout(window._bf_live_games_timer);
            }

            // Se já temos cards SSR, sincroniza após um delay seguro de 3 segundos para tirar do critical path inicial (PageSpeed/Lighthouse)
            if (existingCards > 0) {
                window._bf_live_games_timer = setTimeout(() => syncLiveGames({ skipGamesUpdate }), 3000);
                return;
            }

            const isMobile = window.matchMedia("(max-width: 768px)").matches;
            const delay = isMobile ? 3000 : 1500;

            if (typeof requestIdleCallback !== 'undefined') {
                requestIdleCallback(() => {
                    window._bf_live_games_timer = setTimeout(() => syncLiveGames({ skipGamesUpdate: false }), delay);
                }, { timeout: delay + 1000 });
            } else {
                window._bf_live_games_timer = setTimeout(() => syncLiveGames({ skipGamesUpdate: false }), delay);
            }
        });
    }
})();
</script>
