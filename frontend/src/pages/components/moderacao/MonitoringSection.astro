---
---

<div id="monitoring-section" class="hidden space-y-4 animate-in fade-in duration-500">
    <div class="flex items-center justify-between gap-3 bg-[#141414] p-4 rounded-xl border border-white/10">
        <h3 class="text-white text-sm font-semibold flex items-center gap-2.5">
            <span class="w-1.5 h-1.5 bg-emerald-500 rounded-full"></span>
            Monitoramento do sistema
            <div id="monitoring-loader" class="animate-spin h-3 w-3 border-2 border-[#DF0912] border-t-transparent rounded-full hidden"></div>
        </h3>
        <button id="refresh-monitoring-btn" class="text-gray-300 hover:text-white bg-white/[0.04] hover:bg-white/[0.08] border border-white/10 transition-colors text-xs font-medium px-3 py-2 rounded-lg">Recarregar</button>
    </div>

    <!-- Saúde de infraestrutura -->
    <div class="bg-[#141414] border border-white/10 rounded-xl p-5">
        <h4 class="text-white text-sm font-semibold mb-4">Saúde da infraestrutura</h4>
        <div id="monitoring-health-grid" class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-3">
            <p class="text-gray-500 text-sm col-span-full">Carregando...</p>
        </div>
    </div>

    <!-- Erros recentes -->
    <div class="bg-[#141414] border border-white/10 rounded-xl overflow-hidden">
        <div class="p-4 border-b border-white/5 flex items-center justify-between gap-3">
            <h3 class="text-white text-sm font-semibold flex items-center gap-2.5">
                <span class="w-1.5 h-1.5 bg-[#DF0912] rounded-full"></span>
                Erros recentes
            </h3>
            <span id="monitoring-5xx-count" class="text-xs bg-[#DF0912]/10 text-[#DF0912] border border-[#DF0912]/20 px-2.5 py-1 rounded-md font-medium shrink-0">0 erros 5xx (1h)</span>
        </div>
        <div id="monitoring-errors-list" class="divide-y divide-white/[0.04] max-h-[480px] overflow-y-auto">
            <p class="text-gray-500 text-sm p-5">Carregando...</p>
        </div>
        <div id="monitoring-errors-empty" class="hidden p-12 text-center">
            <p class="text-gray-500 text-sm">Nenhum erro recente registrado.</p>
        </div>
    </div>

    <!-- Log de requests recentes -->
    <div class="bg-[#141414] border border-white/10 rounded-xl overflow-hidden">
        <div class="p-4 border-b border-white/5">
            <h3 class="text-white text-sm font-semibold flex items-center gap-2.5">
                <span class="w-1.5 h-1.5 bg-sky-500 rounded-full"></span>
                Requisições recentes
            </h3>
        </div>
        <div class="overflow-x-auto max-h-[480px] overflow-y-auto">
            <table class="w-full text-left">
                <thead class="bg-[#141414] text-xs font-medium text-gray-400 sticky top-0">
                    <tr>
                        <th class="px-5 py-3">Hora</th>
                        <th class="px-5 py-3">Origem</th>
                        <th class="px-5 py-3">Método</th>
                        <th class="px-5 py-3">URL</th>
                        <th class="px-5 py-3">Status</th>
                        <th class="px-5 py-3 text-right">Duração</th>
                    </tr>
                </thead>
                <tbody id="monitoring-requests-tbody" class="divide-y divide-white/[0.04]">
                    <tr><td class="px-5 py-4 text-gray-500 text-sm" colspan="6">Carregando...</td></tr>
                </tbody>
            </table>
        </div>
        <div id="monitoring-requests-empty" class="hidden p-12 text-center">
            <p class="text-gray-500 text-sm">Sem requisições registradas (Axiom não configurado).</p>
        </div>
    </div>
</div>

<!-- Modal de detalhes (erro ou requisição) -->
<div id="monitoring-detail-modal" class="hidden fixed inset-0 z-[100] flex items-center justify-center p-4 bg-black/70 backdrop-blur-sm">
    <div class="bg-[#141414] border border-white/10 rounded-xl shadow-2xl max-w-2xl w-full max-h-[80vh] overflow-hidden flex flex-col">
        <div class="p-4 border-b border-white/5 flex items-center justify-between">
            <h3 id="monitoring-detail-title" class="text-white text-sm font-semibold">Detalhes</h3>
            <button id="monitoring-detail-close" class="text-gray-500 hover:text-white transition-colors text-xl leading-none">&times;</button>
        </div>
        <div id="monitoring-detail-body" class="p-5 overflow-y-auto text-xs text-gray-300 space-y-2"></div>
    </div>
</div>
