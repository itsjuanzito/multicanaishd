                <div id="comments-section" class="space-y-4 animate-in fade-in duration-500">
                    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 bg-[#141414] p-4 rounded-xl border border-white/10">
                        <h3 class="text-white text-sm font-semibold flex items-center gap-2.5">
                            <span class="w-1.5 h-1.5 bg-emerald-500 rounded-full"></span>
                            Feed de moderação
                            <div id="loading-spinner" class="animate-spin h-3 w-3 border-2 border-[#DF0912] border-t-transparent rounded-full hidden"></div>
                        </h3>
                        <button id="refresh-comments-btn" class="self-start sm:self-auto text-gray-300 hover:text-white bg-white/[0.04] hover:bg-white/[0.08] border border-white/10 transition-colors text-xs font-medium px-3 py-2 rounded-lg">Recarregar</button>
                    </div>
                    <div id="comments-feed" class="grid gap-3"></div>
                </div>

