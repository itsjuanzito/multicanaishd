---
---

                <div id="stats-section" class="hidden space-y-4 animate-in fade-in duration-500">
                    <div class="bg-[#141414] border border-white/10 p-5 rounded-xl">
                        <div class="flex items-start justify-between flex-wrap gap-3 mb-4">
                            <div>
                                <p class="text-xs text-gray-400 mb-1.5">Usuários online</p>
                                <div class="flex items-end gap-2">
                                    <span id="admin-stat-online" class="text-3xl font-semibold text-emerald-400 leading-none">...</span>
                                    <span class="text-xs text-gray-500 mb-0.5">agora</span>
                                </div>
                            </div>
                            <p class="text-xs text-gray-500">Últimos 5 minutos &middot; o que estão vendo</p>
                        </div>
                        <div id="admin-online-users-list" class="border-t border-white/5 pt-4 space-y-1.5 max-h-72 overflow-y-auto">
                            <p class="text-xs text-gray-500">Carregando...</p>
                        </div>
                    </div>

                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 items-start">
                        <div class="bg-[#141414] border border-white/10 p-5 rounded-xl flex flex-col justify-between">
                            <div>
                                <p class="text-xs text-gray-400 mb-1.5">Total de contas</p>
                                <span id="admin-stat-users" class="text-3xl font-semibold text-white leading-none">...</span>
                            </div>
                            <div class="border-t border-white/5 pt-3 mt-5">
                                <p class="text-xs text-gray-500">Cadastros globais</p>
                            </div>
                        </div>
                        <div class="bg-[#141414] border border-white/10 p-5 rounded-xl flex flex-col justify-between">
                            <div>
                                <p class="text-xs text-gray-400 mb-1.5">Membros VIP (total)</p>
                                <span id="admin-stat-vip" class="text-3xl font-semibold text-indigo-400 leading-none">...</span>
                            </div>
                            <div class="border-t border-white/5 pt-3 mt-5 space-y-2">
                                <div class="flex items-center justify-between text-xs text-gray-400">
                                    <span>1 Mês (R$ 10)</span>
                                    <span id="admin-stat-vip-10" class="text-white font-mono">...</span>
                                </div>
                                <div class="flex items-center justify-between text-xs text-gray-400">
                                    <span>3 Meses (R$ 25)</span>
                                    <span id="admin-stat-vip-25" class="text-white font-mono">...</span>
                                </div>
                                <div class="flex items-center justify-between text-xs text-gray-400">
                                    <span>1 Ano (R$ 80)</span>
                                    <span id="admin-stat-vip-80" class="text-white font-mono">...</span>
                                </div>
                                <div class="flex items-center justify-between text-xs text-[#DF0912] pt-2 border-t border-white/5">
                                    <span>Diamond 1 Mês (R$ 19,90)</span>
                                    <span id="admin-stat-vip-diamond-19" class="text-white font-mono">...</span>
                                </div>
                                <div class="flex items-center justify-between text-xs text-[#DF0912]">
                                    <span>Diamond 3 Meses (R$ 49,90)</span>
                                    <span id="admin-stat-vip-diamond-49" class="text-white font-mono">...</span>
                                </div>
                                <div class="flex items-center justify-between text-xs text-[#DF0912]">
                                    <span>Diamond 1 Ano (R$ 149,90)</span>
                                    <span id="admin-stat-vip-diamond-149" class="text-white font-mono">...</span>
                                </div>
                                <div class="flex items-center justify-between text-xs text-neutral-300 pt-2 border-t border-white/5">
                                    <span>Black 1 Mês (R$ 50)</span>
                                    <span id="admin-stat-vip-black-50" class="text-white font-mono">...</span>
                                </div>
                                <div class="flex items-center justify-between text-xs text-neutral-300">
                                    <span>Black 3 Meses (R$ 125)</span>
                                    <span id="admin-stat-vip-black-125" class="text-white font-mono">...</span>
                                </div>
                                <div class="flex items-center justify-between text-xs text-neutral-300">
                                    <span>Black 1 Ano (R$ 500)</span>
                                    <span id="admin-stat-vip-black-500" class="text-white font-mono">...</span>
                                </div>
                                <div class="flex items-center justify-between text-xs text-gray-500 pt-2 border-t border-white/5">
                                    <span>Manual / Outros</span>
                                    <span id="admin-stat-vip-manual" class="text-white font-mono">...</span>
                                </div>
                            </div>
                        </div>
                    </div>

                </div>

