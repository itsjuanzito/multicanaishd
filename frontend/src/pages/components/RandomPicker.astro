---
// src/components/RandomPicker.astro
import { getLangFromUrl } from "../../i18n/utils";
const lang = getLangFromUrl(Astro.url);
const isPt = lang === "pt";
---

<div 
    id="random-picker-modal" 
    class="fixed inset-0 z-[100] hidden place-items-center p-4" 
    style="display: none;" 
    aria-labelledby="modal-title" 
    role="dialog" 
    aria-modal="true"
>
    
    <div 
        id="picker-backdrop"
        class="fixed inset-0 bg-black/90 backdrop-blur-sm transition-opacity duration-300 opacity-0"
    ></div>

    <div 
        id="picker-content" 
        class="relative w-full max-w-sm h-[75vh] bg-[#0E111A] rounded-3xl overflow-hidden shadow-[0_0_50px_rgba(0,0,0,0.8)] border border-white/10 transform scale-95 opacity-0 transition-all duration-300"
    >
        
        <div class="absolute inset-0">
            <img id="picker-img" src="" class="w-full h-full object-cover opacity-0 transition-opacity duration-500" onload="this.classList.remove('opacity-0')" />
            {/* Solid Overlay V4 */}
            <div class="absolute inset-x-0 bottom-0 h-2/3 bg-black/80"></div>
        </div>

        <div id="picker-loading" class="absolute inset-0 flex flex-col items-center justify-center bg-[#0E111A] z-50 transition-opacity duration-300 opacity-0 pointer-events-none">
            <div class="w-12 h-12 border-4 border-[#DF0912]/30 border-t-[#DF0912] rounded-full animate-spin mb-3"></div>
            <p class="text-gray-400 text-xs font-bold uppercase tracking-widest animate-pulse">Sorteando...</p>
        </div>

        <button id="close-picker" aria-label={isPt ? "Fechar" : "Close"} class="absolute top-4 right-4 z-[60] p-2 bg-black/50 hover:bg-[#DF0912] backdrop-blur-md rounded-full text-white border border-white/10 transition-colors cursor-pointer shadow-lg">
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" /></svg>
        </button>

        <div class="absolute bottom-0 left-0 right-0 p-6 z-10 flex flex-col items-center text-center">
            
            <span id="picker-type" class="mb-3 px-3 py-1 text-[10px] font-black uppercase tracking-widest bg-[#DF0912] text-white rounded shadow-lg">
                FILME
            </span>
            
            <h2 id="picker-title" class="text-2xl md:text-3xl font-black text-white leading-tight drop-shadow-lg line-clamp-2 mb-2">
                Carregando...
            </h2>
            
            <div class="flex items-center gap-3 text-xs font-bold text-gray-300 mb-6">
                <span id="picker-year" class="bg-white/10 px-2 py-1 rounded backdrop-blur-sm border border-white/5">2026</span>
                <span class="flex items-center gap-1 text-[#FFCC00]">
                    ★ <span id="picker-rate">0.0</span>
                </span>
            </div>

            <div class="w-full space-y-3">
                <a id="picker-watch-btn" href="#" class="w-full py-3.5 bg-white hover:bg-gray-200 text-black font-black text-sm rounded-xl shadow-xl transition-transform hover:scale-[1.02] flex items-center justify-center gap-2">
                    <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg>
                    ASSISTIR AGORA
                </a>
                
                <button id="picker-reroll-btn" class="w-full py-3 bg-white/5 hover:bg-white/10 text-white font-bold text-xs rounded-xl backdrop-blur-md border border-white/10 transition-colors flex items-center justify-center gap-2">
                    <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" /></svg>
                    Tentar Outro
                </button>
            </div>
        </div>

    </div>
</div>

<script>
    // @ts-nocheck
    function initRandomPicker() {
        const modal = document.getElementById('random-picker-modal');
        const backdrop = document.getElementById('picker-backdrop');
        const content = document.getElementById('picker-content');
        const loading = document.getElementById('picker-loading');
        const closeBtn = document.getElementById('close-picker');
        const rerollBtn = document.getElementById('picker-reroll-btn');

        const ui = {
            img: document.getElementById('picker-img'),
            title: document.getElementById('picker-title'),
            type: document.getElementById('picker-type'),
            year: document.getElementById('picker-year'),
            rate: document.getElementById('picker-rate'),
            btn: document.getElementById('picker-watch-btn')
        };

        const random = (min, max) => Math.floor(Math.random() * (max - min + 1) + min);

        async function fetchSuggestion() {
            if(loading) loading.classList.remove('opacity-0', 'pointer-events-none');
            
            try {
                const type = Math.random() > 0.4 ? 'movie' : 'tv';
                const randomPage = random(1, 15);
                let url = `/api/trending?type=${type}&time_window=week&page=${randomPage}`;
                
                const response = await fetch(url);
                if (!response.ok) throw new Error("API Error");
                const data = await response.json();
                
                if (!data.results || data.results.length === 0) throw new Error("Vazio");

                const validItems = data.results.filter(i => i.poster_path);
                if(validItems.length === 0) throw new Error("Sem imagens");

                const item = validItems[random(0, validItems.length - 1)];

                if(ui.title) ui.title.textContent = item.title || item.name;
                
                if(ui.img) {
                    ui.img.classList.add('opacity-0');
                    setTimeout(() => {
                        ui.img.src = item.poster_path ? `https://image.tmdb.org/t/p/w780${item.poster_path}` : '/placeholder.jpg';
                    }, 200);
                }

                if(ui.type) ui.type.textContent = type === 'movie' ? 'FILME' : 'SÉRIE';
                if(ui.year) ui.year.textContent = (item.release_date || item.first_air_date || '????').split('-')[0];
                if(ui.rate) ui.rate.textContent = item.vote_average ? item.vote_average.toFixed(1) : '--';
                
                if(ui.btn) {
                    const slug = (item.title || item.name).toLowerCase().normalize("NFD").replace(/[\u0300-\u036f]/g, "").replace(/[^\w\-]+/g, "-");
                    const isEn = window.location.pathname.startsWith('/en');
                    const langPrefix = isEn ? '/en' : '';
                    const pathType = type === 'movie' ? 'filme' : 'serie';
                    ui.btn.href = `${langPrefix}/${pathType}/${item.id}-${slug}`;
                }

                setTimeout(() => {
                   if(loading) loading.classList.add('opacity-0', 'pointer-events-none');
                }, 600);

            } catch (error) {
                console.error("Erro no picker:", error);
                setTimeout(() => fetchSuggestion(), 1000);
            }
        }

        window.openRandomPicker = () => {
            if(!modal || !backdrop || !content) return;
            modal.style.display = 'grid'; 
            modal.classList.remove('hidden');
            document.body.style.overflow = 'hidden';

            setTimeout(() => {
                backdrop.classList.remove('opacity-0');
                content.classList.remove('opacity-0', 'scale-95');
                content.classList.add('scale-100');
            }, 10);
            
            fetchSuggestion();
        };

        function closeModal() {
            if(!modal || !backdrop || !content) return;
            backdrop.classList.add('opacity-0');
            content.classList.add('opacity-0', 'scale-95');
            content.classList.remove('scale-100');
            document.body.style.overflow = '';
            setTimeout(() => {
                modal.style.display = 'none';
                modal.classList.add('hidden');
                if(loading) loading.classList.remove('opacity-0', 'pointer-events-none');
            }, 300);
        }

        if(closeBtn) closeBtn.addEventListener('click', closeModal);
        if(rerollBtn) rerollBtn.addEventListener('click', fetchSuggestion);
        
        if(modal) modal.addEventListener('click', (e) => {
            if(e.target === modal) closeModal();
        });

        document.addEventListener('keydown', (e) => {
            if (e.key === 'Escape' && modal && modal.style.display !== 'none') closeModal();
        });
    }

    document.addEventListener("astro:page-load", initRandomPicker);
</script>
