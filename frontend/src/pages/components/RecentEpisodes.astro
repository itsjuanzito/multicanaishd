---
// src/pages/components/RecentEpisodes.astro
import { fetchRecents } from "../../services/recentsService.js";
// contentSlug em vez de cópia local de slugify: título não-latino virava slug vazio → link quebrado.
import { contentSlug } from "../../utils/slugify.js";
import { getLangFromUrl, useTranslations } from "../../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const isPt = lang === "pt";
const langPrefix = isPt ? "" : `/${lang}`;

// Busca os 16 episódios mais recentes do StreamBetter via SSR (com timeout interno)
// Fetches the 16 most recent episodes from StreamBetter via SSR
let episodes = [];
try {
    const result = await fetchRecents("episodes", { page: 1, limit: 16, force: false });
    if (result.ok && result.body?.success) {
        episodes = result.body.episodes ?? [];
    }
} catch (e) {
    console.error("[RecentEpisodes] Falha ao buscar episódios recentes | Failed to fetch recent episodes:", e);
}

const sectionTitle = isPt ? "Episódios Recentes" : "Recent Episodes";
const sectionSubtitle = isPt ? "últimos lançamentos" : "latest releases";
---

{episodes.length > 0 && (
<section class="pt-6 pb-0 w-full relative group/section overflow-hidden" aria-label={sectionTitle}>
    <!-- Header -->
    <div class="flex items-center justify-between mb-8 px-4 sm:px-6 lg:px-12">
        <div class="flex items-center gap-4">
            <div class="w-1.5 h-10 bg-[#DF0912]"></div>
            <div class="flex flex-col">
                <h2 class="text-2xl sm:text-3xl font-black text-white tracking-tighter uppercase italic">
                    {sectionTitle}
                </h2>
                <p class="text-[9px] text-gray-600 font-black uppercase tracking-[0.4em] opacity-80">
                    {sectionSubtitle}
                </p>
            </div>
        </div>
    </div>

    <!-- Slider container -->
    <div class="relative group/slider">
        <button
            id="recent-ep-prev"
            class="hidden sm:flex absolute left-2 top-1/2 -translate-y-1/2 z-40 w-10 h-10 items-center justify-center opacity-0 group-hover/slider:opacity-100 transition-all duration-300 bg-black/95 hover:bg-[#DF0912] border border-white/5 shadow-2xl backdrop-blur-md hover:scale-110 pointer-events-none group-hover/slider:pointer-events-auto"
            aria-label={isPt ? "Anterior" : "Previous"}
        >
            <svg class="w-5 h-5 text-white" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M15 19l-7-7 7-7"></path></svg>
        </button>

        <div
            id="recent-ep-content"
            class="flex gap-4 sm:gap-5 overflow-x-auto snap-x snap-mandatory scrollbar-hide py-4 px-4 sm:px-6 lg:px-12 w-full scroll-px-4 sm:scroll-px-6 lg:scroll-px-12"
            style="scrollbar-width: none; -ms-overflow-style: none;"
        >
            {episodes.map((ep) => {
                const seriesSlug = contentSlug(ep.series_title ?? "");
                const episodeLabel = isPt
                    ? `T${ep.season_number ?? "?"} E${ep.episode_number ?? "?"}`
                    : `S${ep.season_number ?? "?"} E${ep.episode_number ?? "?"}`;
                const episodeTitle = ep.title ?? (isPt ? "Sem título" : "Untitled");
                const rawThumb = ep.episode_cover || ep.series_cover || "";
                // A API externa retorna imagens do TMDB em /original/ (3840x2160), mas o card
                // renderiza em ~300px de largura; forçamos w342 pra evitar baixar 380+ KiB à toa.
                const thumb = rawThumb.includes("image.tmdb.org")
                    ? rawThumb.replace(/\/t\/p\/(original|w\d+)\//, "/t/p/w342/")
                    : rawThumb;

                // Link pra rota própria do episódio (URL limpa, indexável). Antes usava
                // ?season=&episode=, variante que o Google descarta como "alternativa com canônico".
                // Link to the dedicated episode route (clean, indexable URL) instead of query params.
                const basePath = ep.series_tmdb_id
                    ? `${langPrefix}/serie/${ep.series_tmdb_id}-${seriesSlug}`
                    : null;
                const href = basePath && ep.season_number && ep.episode_number
                    ? `${basePath}/temporada-${ep.season_number}/episodio-${ep.episode_number}`
                    : (basePath ?? "#");

                return (
                    <a
                        href={href}
                        class="recent-ep-card flex-shrink-0 snap-start relative group/card block w-[260px] sm:w-[300px] overflow-hidden bg-[#0a0a0a] border border-white/5 transition-all duration-300 hover:scale-[1.02] hover:z-20 hover:border-[#DF0912]/30"
                        title={`${ep.series_title ?? ""} — ${episodeLabel}`}
                    >
                        <!-- Thumbnail 16:9 -->
                        <div class="relative aspect-video w-full overflow-hidden">
                            {thumb ? (
                                <img
                                    src={thumb}
                                    alt={`${ep.series_title} ${episodeLabel}`}
                                    class="w-full h-full object-cover transition-transform duration-700 group-hover/card:scale-110"
                                    loading="lazy"
                                    decoding="async"
                                    onerror={`this.onerror=null;this.src='https://placehold.co/300x169/141414/FF5555?text=${encodeURIComponent(ep.series_title ?? "?")}';`}
                                />
                            ) : (
                                <div class="w-full h-full bg-gradient-to-br from-[#0E111A] to-[#1a1a1a] flex items-center justify-center">
                                    <svg class="w-10 h-10 text-white/10" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M15 10l4.553-2.069A1 1 0 0121 8.882v6.236a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z"></path></svg>
                                </div>
                            )}

                            <!-- Episode badge -->
                            <div class="absolute top-2 left-2 z-10">
                                <span class="bg-[#DF0912] px-2 py-0.5 text-[9px] font-black text-white uppercase tracking-tight italic skew-x-[-8deg] inline-block shadow-lg">
                                    {episodeLabel}
                                </span>
                            </div>

                            <!-- Play icon on hover -->
                            <div class="absolute inset-0 flex items-center justify-center opacity-0 group-hover/card:opacity-100 transition-all duration-300 bg-black/30">
                                <div class="w-12 h-12 rounded-full bg-[#DF0912]/90 flex items-center justify-center shadow-2xl transform scale-75 group-hover/card:scale-100 transition-transform duration-300">
                                    <svg class="w-5 h-5 text-white ml-0.5" fill="currentColor" viewBox="0 0 24 24"><path d="M8 5v14l11-7z"></path></svg>
                                </div>
                            </div>
                        </div>

                        <!-- Info footer -->
                        <div class="p-3 space-y-1">
                            <p class="text-white text-[11px] font-black uppercase tracking-tight line-clamp-1 italic">
                                {ep.series_title ?? ""}
                            </p>
                            <p class="text-gray-400 text-[10px] font-medium line-clamp-1">
                                {episodeTitle}
                            </p>
                        </div>
                    </a>
                );
            })}
        </div>

        <button
            id="recent-ep-next"
            class="hidden sm:flex absolute right-2 top-1/2 -translate-y-1/2 z-40 w-10 h-10 items-center justify-center opacity-0 group-hover/slider:opacity-100 transition-all duration-300 bg-black/95 hover:bg-[#DF0912] border border-white/5 shadow-2xl backdrop-blur-md hover:scale-110 pointer-events-none group-hover/slider:pointer-events-auto"
            aria-label={isPt ? "Próximo" : "Next"}
        >
            <svg class="w-5 h-5 text-white" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M9 19l7-7-7-7"></path></svg>
        </button>
    </div>
</section>
)}

<script>
    function initRecentEpisodes() {
        const content = document.getElementById("recent-ep-content");
        const prevBtn = document.getElementById("recent-ep-prev");
        const nextBtn = document.getElementById("recent-ep-next");
        if (!content || content.getAttribute("data-ep-init") === "true") return;
        content.setAttribute("data-ep-init", "true");

        function updateBtns() {
            const max = content.scrollWidth - content.clientWidth;
            if (max <= 10) {
                if (prevBtn) prevBtn.style.display = "none";
                if (nextBtn) nextBtn.style.display = "none";
                return;
            }
            if (prevBtn) prevBtn.style.display = content.scrollLeft > 10 ? "flex" : "none";
            if (nextBtn) nextBtn.style.display = content.scrollLeft < max - 10 ? "flex" : "none";
        }

        let ticking = false;
        content.addEventListener("scroll", () => {
            if (!ticking) {
                window.requestAnimationFrame(() => { updateBtns(); ticking = false; });
                ticking = true;
            }
        }, { passive: true });

        if (nextBtn) nextBtn.onclick = () => content.scrollBy({ left: content.clientWidth * 0.85, behavior: "smooth" });
        if (prevBtn) prevBtn.onclick = () => content.scrollBy({ left: -content.clientWidth * 0.85, behavior: "smooth" });

        // Lazy-measure: só mede no primeiro hover para evitar Forced Reflow
        // Lazy-measure: only measures on first hover to avoid Forced Reflow
        const sliderEl = content.closest(".group\\/slider");
        if (sliderEl) {
            let done = false;
            const onInteract = () => {
                if (done) return;
                done = true;
                window.requestAnimationFrame(updateBtns);
                sliderEl.removeEventListener("mouseenter", onInteract);
                sliderEl.removeEventListener("touchstart", onInteract);
            };
            sliderEl.addEventListener("mouseenter", onInteract, { passive: true });
            sliderEl.addEventListener("touchstart", onInteract, { passive: true });
        }

        window.addEventListener("resize", () => {
            if (!ticking) {
                window.requestAnimationFrame(() => { updateBtns(); ticking = false; });
                ticking = true;
            }
        });
    }

    initRecentEpisodes();
    document.addEventListener("astro:page-load", initRecentEpisodes);
</script>

<style is:global>
    #recent-ep-content::-webkit-scrollbar { display: none; }
    .recent-ep-card { border-radius: 0; }
</style>
