---
// src/components/Navigation.astro
const LATEST_VERSION = "3.0.0";

// i18n
import { getLangFromUrl, useTranslations } from "../../i18n/utils";
import { isKidsProfile } from "../../services/kidsProfile.js";
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const isPt = lang === "pt";
const langPrefix = isPt ? "" : `/${lang}`;

const { isMobile = false } = Astro.props;
const currentPath = Astro.url.pathname;

// No perfil infantil o link de canais some junto com a rota (o middleware já redireciona
// /canais): deixar o link visível levaria a criança a um redirect sem explicação.
const isKids = isKidsProfile(Astro);

const navLinks = [
    // `${langPrefix}/` dava "/en/" na versão em inglês, e com trailingSlash: "never" o próprio
    // Astro responde 301 de /en/ para /en — ou seja, o link "Início" do menu, presente em
    // TODA página /en, era um redirect interno. `langPrefix || "/"` fecha isso.
    { name: t('nav.home'), href: `${langPrefix || "/"}`, icon: "home", reload: true },
    { name: t('nav.movies'), href: `${langPrefix}/explorar?type=movie`, icon: "film", reload: true },
    { name: t('nav.series'), href: `${langPrefix}/explorar?type=tv`, icon: "tv", reload: true },
    { name: t('nav.anime') || "Animes", href: `${langPrefix}/explorar?type=anime`, icon: "sparkles", reload: true },
    { name: t('nav.doramas') || "Doramas", href: `${langPrefix}/explorar?type=dorama`, icon: "heart", reload: true },
    ...(isKids ? [] : [{ name: t('nav.channels'), href: `${langPrefix}/canais`, icon: "radio", reload: true }]),
    { name: t('nav.app') || "App", href: `${langPrefix}/app`, icon: "smartphone", reload: true },
];

const extraLinks = [
    { name: t('nav.ranking') || 'Ranking', href: `${langPrefix}/ranking` },
    { name: t('nav.calendar'), href: `${langPrefix}/calendario` },
    { name: t('nav.changelog'), href: `${langPrefix}/changelog`, badge: t('nav.new') },
    { name: 'Status', href: `${langPrefix}/status` },
    { name: t('nav.support'), href: `${langPrefix}/vip` },
];

const desktopExtraLinks = extraLinks;

function isActive(href) {
    const url = new URL(href, Astro.url.origin);
    const pathMatch = currentPath === url.pathname;
    
    // Se for Início, precisa ser exato
    if (url.pathname === '/' || url.pathname === '/en' || url.pathname === '/en/') return pathMatch;
    
    // Se tiver query params (ex: explorar?type=movie), verifica se batem
    if (url.search) {
        return pathMatch && Astro.url.search.includes(url.search.substring(1));
    }

    return pathMatch;
}
---

<div class={`${isMobile ? 'flex flex-col gap-2' : 'flex items-center gap-0.5 lg:gap-1'}`}>
    {navLinks.map(link => (
        <a 
            href={link.href}
            data-astro-reload={link.reload ? "" : undefined}
            class={`
                relative transition-all duration-300 whitespace-nowrap
                ${isMobile
                    ? 'w-full text-left bg-white/5 text-base font-bold px-4 py-3 rounded-2xl'
                    : 'px-1 xl:px-2 py-1 xl:py-1.5 rounded-full text-[10px] xl:text-[13px] font-extrabold'}
                ${isActive(link.href)
                    ? 'bg-white/15 text-white'
                    : 'text-gray-400 hover:text-white hover:bg-white/5'}
            `}
        >
            {link.name}
            {isActive(link.href) && !isMobile && (
                <span class="absolute -bottom-1 left-1/2 -translate-x-1/2 w-1 h-1 bg-[#DF0912] rounded-full shadow-[0_0_8px_#DF0912]"></span>
            )}
        </a>
    ))}

    <!-- "Mais" Dropdown for Desktop -->
    {!isMobile && (
        <div class="relative group ml-0.5">
            <button 
                class="relative flex items-center gap-1 px-1 xl:px-2 py-1 xl:py-1.5 rounded-full text-[10px] xl:text-[13px] font-extrabold text-gray-400 hover:text-white hover:bg-white/5 transition-all whitespace-nowrap"
                aria-label={t('nav.more')}
            >
                <span>{t('nav.more')}</span>
                <span id="explorar-dot" class="changelog-new-badge hidden absolute top-1 right-1 w-1.5 h-1.5 bg-[#DF0912] rounded-full shadow-[0_0_8px_#DF0912]"></span>
                <svg class="w-3.5 h-3.5 transition-transform group-hover:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
            </button>
            <div class="absolute top-full right-0 mt-2 w-48 bg-[#161B28]/95 backdrop-blur-xl border border-white/10 rounded-2xl shadow-2xl py-2 opacity-0 scale-95 pointer-events-none group-hover:opacity-100 group-hover:scale-100 group-hover:pointer-events-auto transition-all duration-200 origin-top-right z-50 before:content-[''] before:absolute before:-top-4 before:left-0 before:right-0 before:h-4">
                {desktopExtraLinks.map(link => (
                    link.href ? (
                        <a 
                            href={link.href} 
                            id={link.name === 'Changelog' ? 'changelog-link' : undefined}
                            class="flex items-center justify-between px-4 py-2 text-sm text-gray-300 hover:text-white hover:bg-white/5 transition-colors"
                        >
                            {link.name}
                            {link.badge && (
                                <span class="changelog-new-badge hidden px-1.5 py-0.5 rounded text-[10px] font-black bg-[#DF0912] text-white uppercase tracking-tighter">
                                    {link.badge}
                                </span>
                            )}
                        </a>
                    ) : (
                        <button id={link.id} class="w-full text-left px-4 py-2 text-sm text-gray-300 hover:text-white hover:bg-white/5 transition-colors">
                            {link.name}
                        </button>
                    )
                ))}
            </div>
        </div>
    )}

    <!-- Extra Links for Mobile -->
    {isMobile && (
        <div class="mt-4 pt-4 border-t border-white/10 grid grid-cols-2 gap-2">
            {extraLinks.map(link => (
                link.href ? (
                    <a
                        href={link.href}
                        id={link.name === 'Changelog' ? 'changelog-link-mob' : undefined}
                        class="relative px-4 py-3 bg-white/5 rounded-2xl text-sm font-bold text-gray-300 text-center"
                    >
                        {link.name}
                        {link.badge && (
                            <span class="changelog-new-badge hidden absolute -top-1 -right-1 px-1.5 py-0.5 rounded-full text-[8px] font-black bg-[#DF0912] text-white uppercase shadow-lg shadow-red-900/40">
                                {link.badge}
                            </span>
                        )}
                    </a>
                ) : (
                    <button id={link.id + '-mob'} class="px-4 py-3 bg-white/5 rounded-2xl text-sm font-bold text-gray-300">
                        {link.name}
                    </button>
                )
            ))}
            
            <div id="mobile-auth-actions" class="col-span-2 grid grid-cols-2 gap-2 mt-2">
                <!-- Login (Deslogado) -->
                <a href={`${langPrefix}/login`} id="nav-login-mobile" class="flex items-center justify-center px-4 py-3 bg-white/5 rounded-2xl text-xs font-black text-white uppercase tracking-widest text-center border border-white/5 transition-all active:scale-95">
                    {t('nav.login')}
                </a>
                <!-- VIP (Sempre que não for VIP) -->
                <a href={`${langPrefix}/vip`} id="nav-vip-mobile" class="hidden items-center justify-center px-4 py-3 bg-[#DF0912] hover:bg-[#AE181E] rounded-2xl text-xs font-black text-white uppercase tracking-widest active:scale-95 text-center">
                    {t('nav.vip')}
                </a>
                <!-- Perfil (Logado) -->
                <a href={`${langPrefix}/perfil`} id="nav-profile-mobile" class="hidden px-4 py-3 bg-white/10 rounded-2xl text-xs font-black text-white border border-white/10 items-center justify-center gap-2 active:scale-95">
                    <svg class="w-4 h-4 text-[#DF0912]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path></svg>
                    {t('nav.profile')}
                </a>
                <!-- Minha Lista (Logado) -->
                <a href={`${langPrefix}/minha-lista`} id="nav-minha-lista-mobile" class="hidden px-4 py-3 bg-white/10 hover:bg-white/15 rounded-2xl text-xs font-black text-white border border-white/10 items-center justify-center gap-2 active:scale-95 col-span-2 transition-all duration-300">
                    <svg class="w-4 h-4 text-[#DF0912]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 5a2 2 0 012-2h10a2 2 0 012 2v16l-7-3.5L5 21V5z"></path></svg>
                    {t('nav.my_list')}
                </a>
            </div>
        </div>
    )}
</div>

<script define:vars={{ LATEST_VERSION }}>
    function initChangelogBadge() {
        const lastSeen = localStorage.getItem('multicanaishd_last_seen_changelog');
        const badges = document.querySelectorAll('.changelog-new-badge');
        
        if (lastSeen !== LATEST_VERSION) {
            badges.forEach(b => b.classList.remove('hidden'));
        }

        const markAsSeen = () => {
            localStorage.setItem('multicanaishd_last_seen_changelog', LATEST_VERSION);
            badges.forEach(b => b.classList.add('hidden'));
        };

        const changelogLink = document.getElementById('changelog-link');
        const changelogLinkMob = document.getElementById('changelog-link-mob');
        
        if (changelogLink) changelogLink.addEventListener('click', markAsSeen);
        if (changelogLinkMob) changelogLinkMob.addEventListener('click', markAsSeen);
    }

    document.addEventListener("astro:page-load", () => {
        initChangelogBadge();
    });
</script>
