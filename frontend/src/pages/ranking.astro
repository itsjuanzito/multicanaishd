    /* Proporção dos degraus (1º mais alto que o 2º, 2º mais alto que o 3º) em qualquer
       viewport. É min-height e não height: o degrau agora tem conteúdo dentro (filmes/eps),
       então altura fixa cortaria os números em telas estreitas. */
    .podium-pedestal-1 {
        min-height: 7rem;
    }
    .podium-pedestal-2 {
        min-height: 5.5rem;
    }
    .podium-pedestal-3 {
        min-height: 4.5rem;
    }

    @media (min-width: 640px) {
        .podium-pedestal-1 {
            min-height: 10rem;
        }
        .podium-pedestal-2 {
            min-height: 7.5rem;
        }
        .podium-pedestal-3 {
            min-height: 6rem;
        }
    }
</style>
