---
import BaseLayout from "../layouts/BaseLayout.astro";
// i18n
import { getLangFromUrl, useTranslations } from "../i18n/utils";
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

export const prerender = false;
---

<BaseLayout title={t('auth.forgot_pass_title')} robots="noindex, nofollow">
    <main 
        id="forgot-main"
        data-t-processing={t('auth.forgot_pass_processing')}
        data-t-success={t('auth.forgot_pass_success')}
        data-t-sent={t('auth.forgot_pass_sent_btn')}
        data-t-error={t('auth.forgot_pass_error')}
        data-t-retry={t('auth.forgot_pass_retry')}
        class="min-h-[100dvh] flex items-center justify-center p-4 pt-24 relative overflow-hidden bg-[#060911]"
    >
        <!-- Background Decor -->
        <div class="absolute top-0 right-0 w-[500px] h-[500px] bg-[#DF0912]/10 rounded-full blur-[120px] -translate-y-1/2 translate-x-1/2"></div>
        <div class="absolute bottom-0 left-0 w-[500px] h-[500px] bg-[#5865F2]/10 rounded-full blur-[120px] translate-y-1/2 -translate-x-1/2"></div>

        <div class="relative w-full max-w-[400px] bg-[#0E111A]/60 backdrop-blur-3xl border border-white/5 p-6 sm:p-10 rounded-[40px] shadow-[0_0_100px_rgba(0,0,0,0.5)] animate-in fade-in zoom-in duration-700">
            <div class="text-center mb-8">
                <a href={lang === 'pt' ? "/login" : "/en/login"} class="inline-flex items-center gap-2 mb-6 group">
                   <div class="w-9 h-9 bg-white/5 border border-white/10 rounded-xl flex items-center justify-center transform group-hover:-translate-x-1 transition-all">
                        <svg class="w-5 h-5 text-gray-400 group-hover:text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M15 19l-7-7 7-7" />
                        </svg>
                    </div>
                </a>
                <h1 class="text-2xl font-black text-white tracking-tighter uppercase italic leading-none">{t('auth.forgot_pass_header')}</h1>
                <p class="text-[10px] text-gray-500 font-black uppercase tracking-[0.3em] mt-3 mx-auto max-w-[200px]">{t('auth.forgot_pass_subtitle')}</p>
            </div>

            <form id="forgot-password-form" class="space-y-4">
                <div class="space-y-1.5">
                    <label class="text-[9px] text-gray-500 font-black uppercase tracking-widest ml-4">{t('auth.email_label')}</label>
                    <input 
                        type="email" 
                        id="email" 
                        required
                        placeholder="email@example.com"
                        class="w-full bg-white/5 border border-white/5 rounded-2xl px-5 py-3.5 text-white text-sm placeholder:text-gray-700 focus:outline-none focus:border-[#DF0912]/30 focus:bg-white/[0.07] transition-all"
                    />
                </div>

                <p id="status-msg" class="text-center text-[10px] font-black uppercase tracking-[0.1em] leading-relaxed hidden px-4 py-4 rounded-xl border border-white/5"></p>

                <div class="pt-2">
                    <button 
                        type="submit"
                        id="submit-btn"
                        class="w-full bg-white text-black hover:bg-[#DF0912] hover:text-white font-black py-3.5 rounded-2xl transition-all transform active:scale-95 shadow-xl uppercase text-xs tracking-tighter"
                    >
                        {t('auth.send_link')}
                    </button>
                </div>
            </form>

        </div>
    </main>

    <script>
        import { supabase } from "../services/supabase";

        function initForgotPassword() {
            const form = document.getElementById('forgot-password-form') as HTMLFormElement;
            const statusMsg = document.getElementById('status-msg');
            const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement;

            if (!form) return;

            form.onsubmit = async (e) => {
                e.preventDefault();
                
                const email = (document.getElementById('email') as HTMLInputElement).value;
                if (!email) return;

                const main = document.getElementById('forgot-main');
                submitBtn.disabled = true;
                submitBtn.style.opacity = '0.5';
                submitBtn.textContent = main?.dataset.tProcessing || "Processando...";
                
                if (statusMsg) statusMsg.classList.add('hidden');

                try {
                    // A segurança de Redefinição de Senha exige evitar a enumeração de e-mails.
                    // O Supabase, por padrão, não retorna erro se o e-mail não existir por motivos de segurança (enumeration protection).
                    const { error } = await supabase.auth.resetPasswordForEmail(email, {
                        redirectTo: window.location.origin + '/reset-password',
                    });

                    if (error) {
                         // Mesmo com erro, se for algo genérico de limite, mostramos algo seguro
                         if (error.status === 429) throw new Error("Muitas solicitações. Tente novamente mais tarde.");
                         throw error;
                    }

                    // SUCESSO SEGURO: Sempre exibimos a mesma mensagem
                    if (statusMsg) {
                        statusMsg.textContent = main?.dataset.tSuccess || "Sucesso!";
                        statusMsg.classList.remove('hidden', 'text-red-500', 'bg-red-500/10', 'border-red-500/50');
                        statusMsg.classList.add('text-emerald-500', 'bg-emerald-500/20', 'border-emerald-500/50');
                        statusMsg.style.display = 'block';
                    }
                    
                    form.reset();
                    submitBtn.textContent = main?.dataset.tSent || "Sucesso!";
                    submitBtn.classList.remove('bg-white', 'text-black');
                    submitBtn.classList.add('bg-emerald-500', 'text-white');

                } catch (err: any) {
                    if (statusMsg) {
                        statusMsg.textContent = err.message || main?.dataset.tError || "Erro.";
                        statusMsg.classList.remove('hidden', 'text-emerald-500', 'bg-emerald-500/10', 'border-emerald-500/50');
                        statusMsg.classList.add('text-red-500', 'bg-red-500/20', 'border-red-500/50');
                        statusMsg.style.display = 'block';
                    }
                    submitBtn.disabled = false;
                    submitBtn.style.opacity = '1';
                    submitBtn.textContent = main?.dataset.tRetry || "Tentar Novamente";
                }
            };
        }

        document.addEventListener("astro:page-load", initForgotPassword);
        initForgotPassword();
    </script>
</BaseLayout>
