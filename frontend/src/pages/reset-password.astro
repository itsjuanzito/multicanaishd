---
import BaseLayout from "../layouts/BaseLayout.astro";
// i18n
import { getLangFromUrl, useTranslations } from "../i18n/utils";
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

export const prerender = false;
---

<BaseLayout title={t('auth.reset_pass_title')} robots="noindex, nofollow">
    <main 
        id="reset-main"
        data-t-mismatch={t('auth.reset_pass_mismatch')}
        data-t-min-length={t('auth.reset_pass_min_length')}
        data-t-updating={t('auth.reset_pass_updating')}
        data-t-success-msg={t('auth.reset_pass_success_msg')}
        data-t-success-btn={t('auth.reset_pass_success_btn')}
        data-t-error-generic={t('auth.reset_pass_error')}
        data-t-retry={t('auth.forgot_pass_retry')}
        data-t-expired-title={t('auth.reset_pass_expired_title')}
        data-t-expired-desc={t('auth.reset_pass_expired_desc')}
        data-t-request-new={t('auth.reset_pass_request_new')}
        class="min-h-[100dvh] flex items-center justify-center p-4 pt-24 relative overflow-hidden bg-[#060911]"
    >
        <!-- Background Decor -->
        <div class="absolute top-0 right-0 w-[500px] h-[500px] bg-[#DF0912]/10 rounded-full blur-[120px] -translate-y-1/2 translate-x-1/2"></div>
        <div class="absolute bottom-0 left-0 w-[500px] h-[500px] bg-[#5865F2]/10 rounded-full blur-[120px] translate-y-1/2 -translate-x-1/2"></div>

        <div id="reset-container" class="relative w-full max-w-[400px] bg-[#0E111A]/60 backdrop-blur-3xl border border-white/5 p-6 sm:p-10 rounded-[40px] shadow-[0_0_100px_rgba(0,0,0,0.5)] animate-in fade-in zoom-in duration-700 hidden">
            <div class="text-center mb-8">
                <div class="inline-flex items-center justify-center w-12 h-12 bg-[#DF0912] rounded-2xl mb-6 shadow-lg shadow-red-900/40">
                    <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
                    </svg>
                </div>
                <h1 class="text-2xl font-black text-white tracking-tighter uppercase italic leading-none">{t('auth.reset_pass_header')}</h1>
                <p class="text-[10px] text-gray-500 font-black uppercase tracking-[0.3em] mt-3 mx-auto max-w-[200px]">{t('auth.reset_pass_subtitle')}</p>
            </div>

            <form id="reset-password-form" class="space-y-4">
                <div class="space-y-1.5">
                    <label class="text-[9px] text-gray-500 font-black uppercase tracking-widest ml-4">{t('auth.reset_pass_new_label')}</label>
                    <input 
                        type="password" 
                        id="new-password" 
                        required
                        minlength="8"
                        placeholder="••••••••"
                        class="w-full bg-white/5 border border-white/5 rounded-2xl px-5 py-3.5 text-white text-sm placeholder:text-gray-700 focus:outline-none focus:border-[#DF0912]/30 focus:bg-white/[0.07] transition-all"
                    />
                </div>

                <div class="space-y-1.5">
                    <label class="text-[9px] text-gray-500 font-black uppercase tracking-widest ml-4">{t('auth.reset_pass_confirm_label')}</label>
                    <input 
                        type="password" 
                        id="confirm-password" 
                        required
                        minlength="8"
                        placeholder="••••••••"
                        class="w-full bg-white/5 border border-white/5 rounded-2xl px-5 py-3.5 text-white text-sm placeholder:text-gray-700 focus:outline-none focus:border-[#DF0912]/30 focus:bg-white/[0.07] transition-all"
                    />
                </div>

                <p id="status-msg" class="text-center text-[10px] font-black uppercase tracking-[0.1em] leading-relaxed hidden px-4 py-4 rounded-xl border border-white/5"></p>

                <div class="pt-2">
                    <button 
                        type="submit"
                        id="submit-btn"
                        class="w-full bg-white text-black hover:bg-[#DF0912] hover:text-white font-black py-3.5 rounded-2xl transition-all transform active:scale-95 shadow-xl uppercase text-xs tracking-tighter"
                    >
                        {t('auth.reset_pass_btn')}
                    </button>
                </div>
            </form>
        </div>

        <!-- Initializing/Verify Loader -->
        <div id="verify-loader" class="flex flex-col items-center gap-4 animate-pulse">
            <div class="w-12 h-12 border-4 border-[#DF0912] border-t-transparent rounded-full animate-spin"></div>
            <p class="text-[10px] font-black text-gray-500 uppercase tracking-widest">{t('auth.reset_pass_verifying')}</p>
        </div>
    </main>

    <script>
        import { supabase } from "../services/supabase";

        async function initResetPassword() {
            const container = document.getElementById('reset-container');
            const loader = document.getElementById('verify-loader');
            const form = document.getElementById('reset-password-form') as HTMLFormElement;
            const statusMsg = document.getElementById('status-msg');
            const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement;

            // 1. Verificamos se há uma sessão ativa de recuperação
            // O Supabase recupera a sessão automaticamente do fragmento da URL (#access_token=...)
            const { data: { session }, error: sessionError } = await supabase.auth.getSession();

            if (!session || sessionError) {
                console.error("Sessão de recuperação inválida ou expirada.");
                if (loader) {
                    const main = document.getElementById('reset-main');
                    const lang = main?.dataset.lang || 'pt';
                    const forgotPath = lang === 'pt' ? '/forgot-password' : '/en/forgot-password';

                    loader.innerHTML = `
                        <div class="text-center p-8 bg-red-500/10 border border-red-500/20 rounded-3xl">
                            <h2 class="text-white font-black uppercase tracking-tighter mb-4">${main?.dataset.tExpiredTitle || 'Link Expired'}</h2>
                            <p class="text-[10px] text-gray-500 uppercase leading-relaxed mb-6">${main?.dataset.tExpiredDesc || 'Invalid link'}</p>
                            <a href="${forgotPath}" class="inline-block px-6 py-3 bg-white text-black text-[10px] font-black uppercase tracking-widest rounded-xl hover:bg-[#DF0912] hover:text-white transition-all">${main?.dataset.tRequestNew || 'Request New'}</a>
                        </div>
                    `;
                    loader.classList.remove('animate-pulse');
                }
                return;
            }

            // Sessão válida! Oculta loader e mostra formulário
            if (loader) loader.classList.add('hidden');
            if (container) container.classList.remove('hidden');

            if (!form) return;

            form.onsubmit = async (e) => {
                e.preventDefault();
                
                const newPassword = (document.getElementById('new-password') as HTMLInputElement).value;
                const confirmPassword = (document.getElementById('confirm-password') as HTMLInputElement).value;
                const main = document.getElementById('reset-main');

                if (newPassword !== confirmPassword) {
                    return showStatus(main?.dataset.tMismatch || "As senhas não coincidem.", "error");
                }

                if (newPassword.length < 8) {
                    return showStatus(main?.dataset.tMinLength || "Pelo menos 8 caracteres.", "error");
                }

                submitBtn.disabled = true;
                submitBtn.style.opacity = '0.5';
                submitBtn.textContent = main?.dataset.tUpdating || "Atualizando...";
                
                if (statusMsg) statusMsg.classList.add('hidden');

                try {
                    // Atualiza a senha do usuário
                    const { error } = await supabase.auth.updateUser({ password: newPassword });

                    if (error) throw error;

                    showStatus(main?.dataset.tSuccessMsg || "Sucesso!", "success");
                    submitBtn.textContent = main?.dataset.tSuccessBtn || "OK";
                    submitBtn.classList.remove('bg-white', 'text-black');
                    submitBtn.classList.add('bg-emerald-500', 'text-white');

                    // Redireciona para o login após 3 segundos
                    setTimeout(() => {
                        const lang = main?.dataset.lang || 'pt';
                        window.location.href = lang === 'pt' ? '/login' : '/en/login';
                    }, 3000);

                } catch (err: any) {
                    showStatus(err.message || main?.dataset.tErrorGeneric || "Erro.", "error");
                    submitBtn.disabled = false;
                    submitBtn.style.opacity = '1';
                    submitBtn.textContent = main?.dataset.tRetry || "Tentar Novamente";
                }
            };

            function showStatus(text: string, type = 'error') {
                if (!statusMsg) return;
                statusMsg.textContent = text;
                statusMsg.classList.remove('hidden', 'text-emerald-500', 'bg-emerald-500/10', 'border-emerald-500/50', 'text-red-500', 'bg-red-500/10', 'border-red-500/50');
                
                if (type === 'success') {
                    statusMsg.classList.add('text-emerald-500', 'bg-emerald-500/20', 'border-emerald-500/50');
                } else {
                    statusMsg.classList.add('text-red-500', 'bg-red-500/20', 'border-red-500/50');
                }
                statusMsg.style.display = 'block';
            }
        }

        document.addEventListener("astro:page-load", initResetPassword);
        initResetPassword();
    </script>
</BaseLayout>
